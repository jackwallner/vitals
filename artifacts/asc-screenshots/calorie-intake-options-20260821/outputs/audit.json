      },
      {
        "claim": "The net-deficit capture shows burned calories, eaten calories, and the resulting deficit together.",
        "source": "raw/net-deficit.png"
      },
      {
        "claim": "The macro dashboard shows logged calories plus protein, carbs, and fat with their macro-calorie split.",
        "source": "raw/macro-dashboard.png"
      },
      {
        "claim": "The Watch capture shows the daily calorie number on a literal Watch surface.",
        "source": "assets/watch-capture.png"
      }
    ]
  },
