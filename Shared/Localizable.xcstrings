            "value" : "Порівнюйте цей тиждень із минулим, цей місяць із минулим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh tuần này với tuần trước, tháng này với tháng trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本周对比上周，本月对比上月。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較本週與上週、本月與上月。"
          }
        }
      }
    },
