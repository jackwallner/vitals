    "Free during trial, then %@. Auto-renews unless cancelled 24h before trial ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجانًا خلال الفترة التجريبية، ثم %@. يتجدد تلقائيًا ما لم يُلغَ قبل انتهاء الفترة التجريبية بـ 24 ساعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve zkušební době zdarma, pak %@. Obnovuje se automaticky, pokud nezrušíte 24 h před jejím koncem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis under prøveperioden, derefter %@. Fornyes automatisk, medmindre den opsiges 24 timer før prøveperiodens slutning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis im Testzeitraum, danach %@. Verlängert sich automatisch, wenn nicht 24 Std. vor Testende gekündigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν κατά τη δοκιμή, μετά %@. Ανανεώνεται αυτόματα, εκτός αν ακυρωθεί 24 ώρες πριν το τέλος της δοκιμής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prueba, después %@. Se renueva automáticamente salvo que canceles 24 h antes de que acabe la prueba."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasuta prooviperioodil, seejärel %@. Uueneb automaatselt, kui seda ei tühistata 24 tundi enne prooviperioodi lõppu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در دوره آزمایشی رایگان، سپس %@. تمدید خودکار، مگر اینکه ۲۴ ساعت پیش از پایان دوره آزمایشی لغو شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen kokeilun ajan, sitten %@. Uusiutuu automaattisesti, ellei peruta 24 tuntia ennen kokeilun päättymistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pendant l’essai, puis %@. Renouvellement automatique sauf annulation 24 h avant la fin de l’essai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חינם בתקופת הניסיון, ואחר כך %@. מתחדש אוטומטית אלא אם מבטלים 24 שעות לפני סוף תקופת הניסיון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रायल में मुफ़्त, फिर %@। ट्रायल खत्म होने से 24 घंटे पहले रद्द न करने पर अपने आप नवीनीकृत होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besplatno tijekom probnog razdoblja, zatim %@. Automatski se obnavlja ako ne otkažete 24 h prije njegova kraja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingyenes a próbaidőszak alatt, utána %@. Automatikusan megújul, hacsak nem mondod le a próbaidőszak vége előtt 24 órával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis selama percobaan, lalu %@. Diperpanjang otomatis kecuali dibatalkan 24 jam sebelum percobaan berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prova, poi %@. Si rinnova automaticamente se non annulli 24 ore prima della fine della prova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
