    "Your excluded days are saved. Every day is counting toward your averages until Vitals+ is back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيامك المستبعدة محفوظة. يُحتسب كل يوم في متوسطاتك حتى يعود Vitals+."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše vyřazené dny jsou uložené. Dokud se Vitals+ nevrátí, do průměrů se započítává každý den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine udeladte dage er gemt. Alle dage tæller med i dine gennemsnit, indtil Vitals+ er tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine ausgeschlossenen Tage sind gespeichert. Bis Vitals+ wieder verfügbar ist, wird jeder Tag in deine Durchschnittswerte eingerechnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εξαιρεμένες ημέρες σας έχουν αποθηκευτεί. Κάθε μέρα μετρά στους μέσους όρους μέχρι να επιστρέψει το Vitals+."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus días excluidos están guardados. Cada día cuenta en tus promedios hasta que vuelva Vitals+."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljajäetud päevad on salvestatud. Kuni Vitals+ on taas saadaval, lähevad päevad sinu keskmiste arvutamisel arvesse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهایی که کنار گذاشته‌اید ذخیره شده‌اند. تا بازگشت Vitals+، هر روز در میانگین‌هایتان حساب می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohitetut päiväsi on tallennettu. Jokainen päivä lasketaan keskiarvoihisi, kunnes Vitals+ palaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos jours exclus sont enregistrés. Chaque jour compte dans vos moyennes jusqu’au retour de Vitals+."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הימים המוחרגים נשמרו. עד ש־Vitals+ יחזור, כל יום נספר בממוצעים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "औसत से बाहर रखे गए आपके दिन सहेज लिए गए हैं। Vitals+ लौटने तक हर दिन आपके औसत में गिना जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši isključeni dani su spremljeni. Dok se Vitals+ ne vrati, svaki dan ulazi u prosjeke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kizárt napjaid mentve vannak. Minden nap beleszámít az átlagaidba, amíg a Vitals+ vissza nem tér."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari yang Anda kecualikan tersimpan. Setiap hari dihitung dalam rata-rata Anda hingga Vitals+ kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni esclusi sono salvati. Ogni giorno conta nelle medie finché Vitals+ non sarà di nuovo attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除外日は保存されています。Vitals+が戻るまで、すべての日が平均に含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제외한 날은 저장돼 있어요. Vitals+가 돌아올 때까지는 모든 날이 평균에 포함돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu izslēgtās dienas ir saglabātas. Katra diena tiek ieskaitīta vidējo rādītāju aprēķinā, līdz Vitals+ atkal būs pieejams."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari yang anda kecualikan telah disimpan. Setiap hari akan dikira dalam purata anda sehingga Vitals+ kembali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De utelatte dagene dine er lagret. Alle dager teller i gjennomsnittene dine til Vitals+ er tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je uitgesloten dagen zijn opgeslagen. Elke dag telt mee voor je gemiddelden tot Vitals+ terug is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje wykluczone dni są zapisane. Dopóki Vitals+ nie wróci, każdy dzień liczy się do średnich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dias excluídos estão salvos. Todos os dias contam nas suas médias até o Vitals+ voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dias excluídos estão guardados. Todos os dias contam nas suas médias até o Vitals+ voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zilele excluse sunt salvate. Până revine Vitals+, fiecare zi intră în calculul mediilor dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключённые дни сохранены. Пока Vitals+ не вернётся, все дни учитываются при расчёте средних значений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše vyradené dni sú uložené. Kým sa Vitals+ nevráti, počíta sa do priemerov každý deň."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina undantagna dagar är sparade. Alla dagar räknas in i dina medelvärden tills Vitals+ är tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันที่ไม่นับของคุณถูกบันทึกไว้ ทุกวันจะนับในค่าเฉลี่ยจนกว่า Vitals+ จะกลับมา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hariç tutulan günleriniz kaydedildi. Vitals+ yeniden etkinleşene kadar her gün ortalamalarınıza dahil ediliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виключені дні збережено. Доки Vitals+ не повернеться, усі дні враховуватимуться під час розрахунку середніх значень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ngày đã loại của bạn đã được lưu. Mọi ngày đều được tính vào mức trung bình cho đến khi Vitals+ trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的排除日期已保存。在 Vitals+ 恢复之前，每一天都会计入平均值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的排除日已儲存。在 Vitals+ 使用權限恢復前，每一天都會計入平均值。"
          }
        }
      }
    },
    "Your health data never leaves your iPhone. No account, no cloud sync." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بياناتك الصحية لا تغادر iPhone أبدًا. بلا حساب، بلا مزامنة سحابية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše zdravotní data nikdy neopustí iPhone. Bez účtu a cloudové synchronizace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine sundhedsdata forlader aldrig din iPhone. Ingen konto, ingen synkronisering via skyen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gesundheitsdaten verlassen nie dein iPhone. Kein Konto, keine Cloud-Synchronisierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
