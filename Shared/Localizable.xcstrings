    "Start moving! Your activity data will appear here once HealthKit records your steps and calories." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ الحركة! ستظهر بيانات نشاطك هنا بمجرد أن يسجّل HealthKit خطواتك وسعراتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte se hýbat! Data o aktivitě se tu objeví, jakmile HealthKit zaznamená vaše kroky a kalorie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom i gang med at bevæge dig! Dine aktivitetsdata vises her, når HealthKit har registreret dine skridt og kalorier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweg dich! Deine Aktivitätsdaten erscheinen hier, sobald HealthKit deine Schritte und Kalorien erfasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε να κινείστε! Τα δεδομένα δραστηριότητας θα εμφανιστούν εδώ μόλις το HealthKit καταγράψει βήματα και θερμίδες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡A moverse! Tus datos de actividad aparecerán aquí cuando HealthKit registre tus pasos y calorías."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakka liikuma! Sinu tegevusandmed ilmuvad siia, kui HealthKit on su sammud ja kalorid registreerinud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شروع به حرکت کنید! داده‌های فعالیت شما به‌محض ثبت قدم‌ها و کالری‌ها توسط HealthKit اینجا نمایش داده می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikkeelle! Aktiivisuustietosi näkyvät tässä, kun HealthKit on tallentanut askeleesi ja kalorisi."
