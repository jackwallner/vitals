    "Total Calories reads Active Energy, Basal Energy, and Step Count from Apple Health in read-only mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Total Calories الطاقة النشطة وطاقة الراحة وعدد الخطوات من صحتي في وضع القراءة فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories čte z Apple Zdraví Aktivní energii, Klidovou energii a Kroky jen pro čtení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories læser Aktiv energi, Basal energi og Skridt fra Apple Sundhed i skrivebeskyttet tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories liest Aktive Energie, Grundumsatz und Schritte aus Apple Health, nur lesend."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Total Calories διαβάζει Ενεργή ενέργεια, Ενέργεια ηρεμίας και Βήματα από την Apple Υγεία μόνο για ανάγνωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lee la energía activa, la energía en reposo y los pasos de Apple Salud, solo lectura."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories loeb Aktiivset energiat, Baasenergiat ja Sammude arvu Apple Healthist ainult lugemisrežiimis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories انرژی فعال، انرژی پایه و تعداد قدم را از Apple Health فقط در حالت خواندنی می‌خواند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lukee Aktiivisen energian, Lepoenergian ja Askelmäärän Apple Terveydestä vain luku -tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lit l’énergie active, l’énergie au repos et le nombre de pas dans Apple Santé, en lecture seule."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories קורא אנרגיה פעילה, אנרגיית מנוחה וספירת צעדים מבריאות במצב קריאה בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories केवल पढ़ने की स्थिति में Apple स्वास्थ्य से सक्रिय ऊर्जा, बेसल ऊर्जा और कदम गिनती पढ़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories čita Aktivnu energiju, Energiju mirovanja i Korake iz Apple Zdravlja samo za čitanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Total Calories az Aktív energiát, az Alapenergiát és a Lépésszámot csak olvasható módban olvassa az Apple Egészségből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories membaca Energi Aktif, Energi Basal, dan Jumlah Langkah dari Apple Kesehatan dalam mode hanya baca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories legge energia attiva, energia a riposo e passi da Apple Salute, in sola lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Caloriesはヘルスケアからアクティブエネルギー、安静時消費エネルギー、歩数を読み取り専用で読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories는 Apple 건강에서 활동 에너지, 휴식 에너지, 걸음 수를 읽기 전용으로 가져와요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
