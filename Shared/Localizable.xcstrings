        }
      }
    },
    "For a stretch you can't put an end date on yet: an injury, a trip, a spell off the wrist. Each new day is excluded automatically until you resume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine Phase ohne absehbares Ende: eine Verletzung, eine Reise, eine Zeit ohne Uhr. Jeder neue Tag wird automatisch ausgeschlossen, bis du fortsetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para una temporada sin fecha de fin: una lesión, un viaje, una racha sin reloj. Cada día nuevo se excluye automáticamente hasta que reanudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une période sans date de fin : une blessure, un voyage, un temps sans montre. Chaque nouveau jour est exclu automatiquement jusqu’à la reprise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un periodo senza data di fine: un infortunio, un viaggio, un periodo senza orologio. Ogni nuovo giorno è escluso in automatico finché non riprendi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わりがまだ決まらない期間に：けが、旅行、ウォッチを外している期間。再開するまで、新しい日は自動で除外されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于尚无结束日期的时段：受伤、旅行、一段没戴手表的日子。在你恢复之前，每个新的一天都会自动排除。"
          }
        }
      }
    },
    "Free BMI from Apple Health, plus body fat and calorie context." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenloser BMI aus Apple Health, plus Körperfett und Kalorienkontext."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
