    "Empty days don’t count. You can change the comparison window in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُحسب الأيام الفارغة. يمكنك تغيير نافذة المقارنة من الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdné dny se nepočítají. Okno porovnání změníte v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomme dage tæller ikke. Du kan ændre sammenligningsvinduet i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leere Tage zählen nicht. Den Vergleichszeitraum kannst du in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κενές ημέρες δεν μετράνε. Το παράθυρο σύγκρισης αλλάζει στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días vacíos no cuentan. Puedes cambiar el periodo de comparación en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tühje päevi ei arvestata. Võrdlusakent saad muuta Seadetes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهای خالی حساب نمی‌شوند. بازه مقایسه را در تنظیمات می‌توانید تغییر دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjät päivät eivät lasketa. Voit vaihtaa vertailujakson Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours vides ne comptent pas. Vous pouvez changer la période de comparaison dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ימים ריקים לא נספרים. אפשר לשנות את חלון ההשוואה בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाली दिन नहीं गिने जाते। तुलना की अवधि सेटिंग्ज़ में बदली जा सकती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prazni dani se ne broje. Prozor usporedbe mijenjate u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az üres napok nem számítanak. Az összehasonlítási ablakot a Beállításokban módosíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari kosong tidak dihitung. Anda dapat mengubah jendela perbandingan di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni vuoti non contano. Puoi cambiare il periodo di confronto in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データのない日は数えません。比較期間は設定で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터가 없는 날은 포함하지 않아요. 비교 기간은 설정에서 바꿀 수 있어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukšās dienas netiek skaitītas. Salīdzināšanas logu varat mainīt iestatījumos."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari kosong tidak dikira. Anda boleh menukar tetingkap perbandingan dalam Tetapan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomme dager teller ikke. Du kan endre sammenligningsvinduet i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege dagen tellen niet mee. Je kunt het vergelijkingsvenster wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puste dni się nie liczą. Okno porównania zmienisz w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dias vazios não contam. Você pode alterar a janela de comparação em Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dias vazios não contam. Pode alterar a janela de comparação nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zilele goale nu se numără. Puteți schimba fereastra de comparație în Setări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пустые дни не учитываются. Окно сравнения можно изменить в Настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdne dni sa nepočítajú. Okno porovnania zmeníte v Nastaveniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomma dagar räknas inte. Du kan ändra jämförelsefönstret i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันที่ไม่มีข้อมูลไม่นับ เปลี่ยนช่วงเปรียบเทียบได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş günler sayılmaz. Karşılaştırma penceresini Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порожні дні не враховуються. Вікно порівняння можна змінити в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày trống không được tính. Bạn có thể đổi khoảng so sánh trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空白日不计入。你可以在设置中更改对比时段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有資料的日子不計入。你可以在「設定」中更改比較區間。"
          }
        }
      }
    },
