          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykluczone dni nadal widać na wykresach i w eksporcie, przyciemnione. Nie liczą się do średnich, sum, najlepszego dnia ani serii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dias excluídos continuam aparecendo nos gráficos e na exportação, esmaecidos. Não contam em nenhuma média, total, melhor dia ou sequência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
