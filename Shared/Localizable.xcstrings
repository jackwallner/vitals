        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λίγη ακόμη κίνηση και ο στόχος θερμίδων κλείνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco más de movimiento y alcanzas tu objetivo de calorías."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veidi rohkem liikumist ja kalorieesmärk on täidetud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمی تحرک بیشتر هدف کالری شما را کامل می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hieman lisää liikettä, niin kaloritavoitteesi täyttyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
