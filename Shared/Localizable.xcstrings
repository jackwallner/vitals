    "Locked maintenance card. Your TDEE and BMR, worked out from a 30-day average, are a Vitals+ feature. The numbers shown are blurred placeholders, not your own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesperrte Erhaltungskarte. Dein TDEE und BMR aus einem 30-Tage-Schnitt sind eine Vitals+ Funktion. Die Werte sind unscharfe Platzhalter, nicht deine eigenen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjeta de mantenimiento bloqueada. Tu TDEE y BMR, calculados con una media de 30 días, son una función de Vitals+. Las cifras son ejemplos difuminados, no tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte de maintien verrouillée. Votre TDEE et votre BMR, calculés sur une moyenne de 30 jours, sont une fonction Vitals+. Les chiffres sont des exemples floutés, pas les vôtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheda mantenimento bloccata. TDEE e BMR, calcolati su una media di 30 giorni, sono una funzione Vitals+. I valori sono segnaposto sfocati, non i tuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックされた維持カロリーカード。30日平均から求めるTDEEとBMRはVitals+の機能です。表示の数値はぼかしたサンプルで、あなたのデータではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已锁定的维持热量卡片。基于 30 天平均值计算的 TDEE 和 BMR 属于 Vitals+ 功能。显示的数字是模糊的占位内容，并非你的数据。"
          }
        }
      }
    },
    "Log meals in Apple Health to see your net deficit (calories burned minus eaten)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse Mahlzeiten in Apple Health, um dein Nettodefizit zu sehen (verbrannte minus gegessene Kalorien)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra tus comidas en Apple Salud para ver tu déficit neto (calorías quemadas menos ingeridas)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
