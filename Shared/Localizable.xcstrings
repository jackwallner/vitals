    "Auto-renews unless cancelled 24h before it ends. Cancel in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, wenn nicht 24 Std. vor Ablauf gekündigt. Kündigen in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente salvo que canceles 24 h antes. Cancela en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique sauf annulation 24 h avant la fin. Annulez dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente se non annulli 24 ore prima. Annulla in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了の24時間前までに解約しない限り自動更新。解約は設定から。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在到期前 24 小时取消，否则自动续订。可在“设置”中取消。"
          }
        }
      }
    },
    "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, wenn nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird. Verwalten oder kündigen unter Einstellungen › Apple-Account › Abonnements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente salvo que canceles al menos 24 horas antes del final del periodo actual. Gestiona o cancela en Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique sauf annulation au moins 24 heures avant la fin de la période en cours. Gérez ou annulez dans Réglages › Identifiant Apple › Abonnements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente se non annulli almeno 24 ore prima della fine del periodo in corso. Gestisci o annulla in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の期間が終了する24時間以上前に解約しない限り、自動的に更新されます。管理・解約は「設定」›「Apple アカウント」›「サブスクリプション」から。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在当前周期结束前至少 24 小时取消，否则将自动续订。可在“设置”›“Apple 账户”›“订阅”中管理或取消。"
          }
        }
      }
    },
