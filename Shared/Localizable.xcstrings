    "Goal Reached tells you the first time each goal is met in a day, even with the app closed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصلك إشعار «تحقق الهدف» عند بلوغ كل هدف للمرة الأولى خلال اليوم، حتى عند إغلاق التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení „Cíl splněn“ vám dá vědět, když daný den poprvé splníte cíl, i se zavřenou aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mål nået giver dig besked, første gang du når hvert mål på en dag, også når appen er lukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ziel erreicht“ meldet sich, sobald ein Ziel an einem Tag zum ersten Mal erreicht ist, auch bei geschlossener App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ειδοποίηση «Ο στόχος επιτεύχθηκε» σάς ενημερώνει την πρώτη φορά που πετυχαίνετε κάθε στόχο μέσα στην ημέρα, ακόμη κι αν η εφαρμογή είναι κλειστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Objetivo alcanzado» te avisa la primera vez que cumples cada objetivo del día, incluso con la app cerrada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga eesmärgi täitumisest antakse päeva jooksul esimesel korral märku, isegi kui rakendus on suletud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«هدف محقق شد» اولین باری را که هر هدف در یک روز محقق می‌شود اعلام می‌کند، حتی وقتی برنامه بسته است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen, kun saavutat kunkin tavoitteesi päivän aikana ensimmäistä kertaa, vaikka appi olisi suljettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Objectif atteint » vous prévient la première fois qu’un objectif est atteint dans la journée, même app fermée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״היעד הושג״ מודיע ברגע שיעד מושג לראשונה באותו יום, גם כשהאפליקציה סגורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दिन हर लक्ष्य पहली बार पूरा होते ही आपको सूचना मिलती है, ऐप बंद होने पर भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijest o postignutom cilju javlja vam kad ga prvi put u danu ostvarite, čak i kad je aplikacija zatvorena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cél elérve értesít, amikor egy célod aznap először teljesül, akkor is, ha az app be van zárva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target Tercapai memberi tahu Anda saat setiap target pertama kali tercapai dalam sehari, bahkan saat app ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Obiettivo raggiunto» ti avvisa la prima volta che raggiungi ogni obiettivo in un giorno, anche ad app chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「目標達成」は、その日に各目標を初めて達成したときに、アプリを閉じていても通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표 달성 알림은 앱이 닫혀 있어도 하루 중 각 목표를 처음 달성했을 때 알려줘요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paziņojums “Mērķis sasniegts” informē, kad pirmo reizi dienā sasniedzat katru mērķi, pat ja lietotne ir aizvērta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasaran Tercapai memberitahu anda apabila setiap sasaran dicapai buat kali pertama pada hari itu, walaupun app ditutup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med «Mål nådd» får du varsel første gang du når hvert mål i løpet av en dag, selv når appen er lukket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doel gehaald laat je weten wanneer je elk doel voor het eerst op een dag haalt, ook als de app gesloten is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienie o osiągnięciu celu informuje, gdy po raz pierwszy danego dnia osiągniesz cel, nawet przy zamkniętej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aviso “Meta atingida” informa quando você alcança cada meta pela primeira vez no dia, mesmo com o app fechado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notificação «Meta atingida» avisa quando atinge cada meta pela primeira vez no dia, mesmo com a app fechada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiectiv atins vă anunță când atingeți pentru prima dată fiecare obiectiv al zilei, chiar și cu aplicația închisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Цель выполнена» сообщает, когда цель впервые выполнена за день, даже если приложение закрыто."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámenie dostanete pri prvom splnení každého cieľa v daný deň, aj keď je aplikácia zatvorená."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviseringen ”Mål uppnått” meddelar dig första gången du når varje mål per dag, även när appen är stängd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟีเจอร์นี้จะแจ้งเตือนเมื่อคุณทำแต่ละเป้าหมายสำเร็จเป็นครั้งแรกในแต่ละวัน แม้ปิดแอปอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefe Ulaşıldı, bir gün içinde her hedefe ilk kez ulaşıldığında uygulama kapalı olsa bile sizi bilgilendirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ціль виконано» повідомляє, коли ціль уперше виконано за день, навіть якщо програму закрито."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng Đạt mục tiêu thông báo khi bạn lần đầu đạt từng mục tiêu trong ngày, kể cả khi ứng dụng đã đóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“目标达成”会在你当天首次达成每项目标时通知你，即使 App 已关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「目標達成」會在你每天第一次達成各目標時通知你，即使 App 已關閉。"
          }
        }
      }
