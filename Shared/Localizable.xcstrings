        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisab täna logitud toiduenergia ja iga makro osakaalu selles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انرژی غذایی ثبت‌شدهٔ امروز و سهم هر درشت‌مغذی از آن را نشان می‌دهد."
