          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteine, carboidrati e grassi letti direttamente dall’app che usi già. Niente da inserire due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもの食事記録アプリから、タンパク質・炭水化物・脂質をそのまま読み込み。二重入力は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 쓰는 식단 앱에서 단백질, 탄수화물, 지방을 바로 읽어와요. 두 번 입력할 필요 없어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
