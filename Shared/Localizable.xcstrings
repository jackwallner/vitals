          }
        }
      }
    },
    "Apple Health didn't return protein, carbs, and fat for this period." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health hat für diesen Zeitraum kein Protein, keine Kohlenhydrate und kein Fett geliefert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salud no devolvió proteína, carbohidratos ni grasa para este periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Santé n’a renvoyé ni protéines, ni glucides, ni lipides pour cette période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salute non ha restituito proteine, carboidrati e grassi per questo periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
