          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משווה את ההתקדמות עד כה לרמה הרגילה שלך בשעה הזו (בריאות). %1$@ ימים ריקים לא נספרים. %2$@"
