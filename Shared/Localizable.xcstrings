        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک یادآور عصرانه با آنچه برای اهداف و رکوردتان مانده. در روزهایی که پیش می‌روید بی‌صدا است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
