        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatiaľ žiadne zdravotné údaje.\nSkontrolujte prístup k apke Zdravie na iPhone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga hälsodata ännu.\nKontrollera åtkomsten till Apple Hälsa på iPhone."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีข้อมูลสุขภาพ\nตรวจสอบสิทธิ์เข้าถึงแอปสุขภาพบน iPhone"
