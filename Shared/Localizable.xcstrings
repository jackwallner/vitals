        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijkt je voortgang tot nu toe met je gebruikelijke voortgang op dit tijdstip (Apple Gezondheid). %1$@ Lege dagen tellen niet mee. %2$@"
