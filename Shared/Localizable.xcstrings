          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアへのアクセスを許可すると\n実際のデータを読み込めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 데이터를 불러오려면\nApple 건강 데이터 접근을 허용하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
