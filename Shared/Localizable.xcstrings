        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz Sağlık verisi yok.\niPhone'da Sağlık uygulamasındaki verilere erişim iznini kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки немає даних із програми «Здоров’я».\nПеревірте доступ до програми «Здоров’я» на iPhone."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có dữ liệu Sức khỏe.\nKiểm tra quyền truy cập Sức khỏe trên iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂无健康数据。\n请在 iPhone 上检查 Apple 健康访问权限。"
          }
