    "This export contains sensitive health data including your daily calorie and step counts. Only share it with people and services you trust." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Export enthält sensible Gesundheitsdaten, darunter deine täglichen Kalorien und Schritte. Teile ihn nur mit Personen und Diensten, denen du vertraust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta exportación contiene datos de salud sensibles, como tus calorías y pasos diarios. Compártela solo con personas y servicios de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet export contient des données de santé sensibles, dont vos calories et pas quotidiens. Ne le partagez qu’avec des personnes et services de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa esportazione contiene dati sanitari sensibili, tra cui calorie e passi giornalieri. Condividila solo con persone e servizi di cui ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この書き出しには、毎日のカロリーや歩数などの機密性の高い健康データが含まれます。信頼できる人やサービスとだけ共有してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此导出文件包含敏感的健康数据，包括你每天的卡路里和步数。请只与你信任的人和服务分享。"
          }
        }
      }
    },
    "This period compared to the last: averages, percent movement, and peak days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Zeitraum im Vergleich zum letzten: Durchschnitte, Prozentveränderung und Spitzentage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este periodo frente al anterior: medias, variación porcentual y días récord."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette période comparée à la précédente : moyennes, variations en pourcentage et jours records."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo periodo rispetto al precedente: medie, variazioni percentuali e giorni record."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の期間を前の期間と比較：平均、変化率、最高の日。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本时段与上一时段对比：平均值、百分比变化和峰值日。"
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日"
          }
        },
        "zh-Hans" : {
