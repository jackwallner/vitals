    "Projected calories and steps based on your pace so far today." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السعرات والخطوات المتوقعة بناءً على وتيرتك اليوم حتى الآن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhad kalorií a kroků podle dosavadního dnešního tempa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forventet kalorieforbrug og antal skridt baseret på dit tempo indtil nu i dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognose für Kalorien und Schritte auf Basis deines bisherigen Tempos von heute."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προβλεπόμενες θερμίδες και βήματα με βάση τον σημερινό ρυθμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calorías y pasos proyectados según tu ritmo de hoy."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänase senise tempo põhjal prognoositud kalorid ja sammud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش‌بینی کالری و تعداد قدم‌ها بر اساس روند امروزتان تا اینجا."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennustetut kalorit ja askeleet tähänastisen tahtisi perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calories et pas projetés selon votre rythme du jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קלוריות וצעדים צפויים לפי הקצב שלך היום עד עכשיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज अब तक की आपकी गति के आधार पर अनुमानित कैलोरी और कदम।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predviđeni broj kalorija i koraka prema dosadašnjem tempu za danas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mai eddigi tempód alapján becsült kalória- és lépésszám."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkiraan kalori dan langkah berdasarkan laju Anda sejauh ini hari ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
