        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vēl nedaudz kustību, un kaloriju mērķis ir sasniegts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedikit lagi pergerakan dan sasaran kalori anda tercapai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Litt mer bevegelse, så er kalorimålet ditt nådd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog wat meer beweging en je caloriedoel is gehaald."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze trochę ruchu i osiągniesz cel kaloryczny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais um pouco de movimento e você fecha sua meta de calorias."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais um pouco de movimento e atinge a sua meta de calorias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă puțină mișcare și vă îndepliniți obiectivul de calorii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ещё немного движения, и цель по калориям выполнена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trochu pohybu navyše a kalorický cieľ je splnený."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lite mer rörelse, så når du ditt kalorimål."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขยับอีกนิดก็ครบเป้าหมายแคลอรี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biraz daha hareket ederek kalori hedefinizi tamamlayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще трохи руху, і ціль за калоріями виконано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vận động thêm một chút là bạn đạt mục tiêu calo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再动一动就能达成卡路里目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再多動一點，就能達成卡路里目標。"
          }
        }
      }
    },
