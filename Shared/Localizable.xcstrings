        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories читает активную энергию, энергию покоя и шаги из Apple Здоровья только для чтения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories číta z Apple Zdravie Aktívnu energiu, Pokojovú energiu a Kroky len na čítanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories läser Aktiv energi, Basal energi och Steg från Apple Hälsa i skrivskyddat läge."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories อ่านพลังงานจากกิจกรรม พลังงานพื้นฐาน และจำนวนก้าวจาก Apple สุขภาพแบบอ่านอย่างเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories, Aktif Enerji, Bazal Enerji ve Adım Sayısını Apple Sağlık'tan salt okunur modda okur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories лише читає активну енергію, енергію спокою й кроки з Apple Здоров’я."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories đọc Năng lượng hoạt động, Năng lượng cơ bản và Số bước từ Apple Sức khỏe ở chế độ chỉ đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories 以只读方式从 Apple 健康读取活动能量、静息能量和步数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories 以唯讀模式從 Apple 健康讀取活動能量、靜息能量和步數。"
          }
        }
      }
    },
    "Total Calories reads Apple Health data in read-only mode and keeps your health data on your device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Total Calories بيانات صحتي في وضع القراءة فقط ويُبقي بياناتك الصحية على جهازك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories data z Apple Zdraví jen čte a uchovává je ve vašem zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories læser data fra Apple Sundhed i skrivebeskyttet tilstand og holder dine sundhedsdata på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories liest Apple Health Daten nur und behält deine Gesundheitsdaten auf deinem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Total Calories διαβάζει δεδομένα της Apple Υγείας μόνο για ανάγνωση και κρατά τα δεδομένα υγείας σας στη συσκευή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lee los datos de Apple Salud en modo solo lectura y mantiene tus datos de salud en tu dispositivo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories loeb Apple Healthi andmeid ainult lugemisrežiimis ja hoiab sinu terviseandmed sinu seadmes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories داده‌های Apple Health را فقط در حالت خواندنی می‌خواند و داده‌های سلامت شما را روی دستگاهتان نگه می‌دارد."
          }
