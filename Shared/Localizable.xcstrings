    "Deep Trends need a previous matching range with calories or steps before they can compare your momentum." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج الاتجاهات المعمّقة إلى نطاق سابق مماثل يتضمن بيانات السعرات أو الخطوات كي تتمكن من مقارنة تقدمك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hloubkové trendy potřebují předchozí srovnatelné období s údaji o kaloriích nebo krocích, aby mohly porovnat váš vývoj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før dybdegående tendenser kan vise din fremgang, skal der være data for kalorier eller skridt fra en tilsvarende tidligere periode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterte Trends benötigen einen vorherigen gleich langen Zeitraum mit Kalorien- oder Schrittdaten, um deine Entwicklung zu vergleichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αναλυτικές τάσεις χρειάζονται δεδομένα θερμίδων ή βημάτων από ένα προηγούμενο αντίστοιχο διάστημα για να συγκρίνουν την πορεία σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tendencias a fondo necesitan un periodo anterior equivalente con calorías o pasos para comparar tu evolución."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süvatrendide võrdlemiseks on vaja varasemat võrreldavat perioodi, mille kohta on kalori- või sammuandmeid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای مقایسه روند پیشرفتتان در بخش تحلیل عمیق روندها، به بازه‌ای مشابه از دوره قبل با دادهٔ کالری یا قدم نیاز دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syvällinen trendianalyysi edellyttää kalori- tai askeltietoja edelliseltä vastaavalta jaksolta, jotta kehitystäsi voidaan verrata aiempaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tendances détaillées ont besoin d’une période précédente équivalente avec des calories ou des pas pour comparer votre dynamique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגמות מעמיקות צריכות טווח קודם תואם עם קלוריות או צעדים כדי להשוות את קצב ההתקדמות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गहन ट्रेंड में प्रगति की तुलना के लिए कैलोरी या कदमों की पिछली मिलती-जुलती अवधि का डेटा चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za usporedbu napretka u dubinskim trendovima potrebni su podaci o kalorijama ili koracima iz usporedivog prethodnog razdoblja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A részletes trendek összehasonlításához egy korábbi, azonos hosszúságú időszak kalória- vagy lépésadataira van szükség."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren Mendalam memerlukan rentang sebelumnya yang sebanding dan memiliki data kalori atau langkah untuk membandingkan perkembangan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tendenze approfondite richiedono un periodo precedente equivalente con calorie o passi per confrontare i tuoi progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細トレンドで比較するには、カロリーか歩数のある直前の同じ長さの期間が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심층 추세를 비교하려면 이전의 같은 기간에 칼로리나 걸음 수 기록이 있어야 해요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padziļinātajām tendencēm vajag iepriekšēju atbilstošu periodu ar kalorijām vai soļiem, lai salīdzinātu dinamiku."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
