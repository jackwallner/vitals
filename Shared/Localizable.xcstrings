    },
    "BMI is a simple height/weight reference and is not a diagnosis. It may not reflect muscle mass, pregnancy, age, or individual health context." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der BMI ist ein einfacher Richtwert aus Größe und Gewicht und keine Diagnose. Er berücksichtigt weder Muskelmasse, Schwangerschaft, Alter noch deine persönliche Gesundheit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El IMC es una referencia sencilla de altura y peso, no un diagnóstico. Puede no reflejar masa muscular, embarazo, edad ni tu contexto de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IMC est un simple repère taille/poids, pas un diagnostic. Il peut ne pas refléter la masse musculaire, une grossesse, l’âge ou votre situation de santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il BMI è un semplice riferimento altezza/peso, non una diagnosi. Può non riflettere massa muscolare, gravidanza, età o il tuo contesto di salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMIは身長と体重による簡単な目安で、診断ではありません。筋肉量、妊娠、年齢、個々の健康状態は反映されない場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI 只是基于身高和体重的简单参考，并非诊断。它可能无法反映肌肉量、怀孕、年龄或个人健康状况。"
          }
        }
      }
    },
