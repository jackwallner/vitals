          "stringUnit" : {
            "state" : "translated",
            "value" : "تقارن «الوتيرة المعتادة» %1$@ اليوم حتى الآن بـ %2$@، في الوقت نفسه من اليوم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Obvyklé tempo“ porovnává dnešní %1$@ s %2$@, vždy ke stejné denní době."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sædvanligt tempo” sammenligner dine %1$@ indtil nu i dag med %2$@, målt på samme tidspunkt af dagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Übliches Tempo“ vergleicht den bisherigen Wert für %1$@ heute mit %2$@ zur gleichen Uhrzeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο «Συνήθης ρυθμός» συγκρίνει την πρόοδό σας σήμερα (%1$@ ως τώρα) με την αντίστοιχη τιμή (%2$@) για την ίδια ώρα της ημέρας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Usual pace” compares your %1$@ so far today to %2$@, measured at this same time of day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ritmo habitual» compara tus %1$@ de hoy con %2$@, medidos a esta misma hora."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Tavapärane tempo“ võrdleb sinu tänast %1$@ näitu väärtusega %2$@, mis on mõõdetud samal kellaajal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«روند معمول» %1$@ تا اینجای امروز شما را با %2$@ مقایسه می‌کند که در همین ساعت روز اندازه‌گیری شده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Tavallinen tahti” vertaa tämän päivän tähänastista lukemaasi (%1$@) samaan kellonaikaan mitattuun arvoon %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rythme habituel » compare vos %1$@ du jour à %2$@, mesurés à la même heure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״הקצב הרגיל״ משווה בין ה%1$@ שלך היום עד עכשיו לבין %2$@, באותה שעה ביום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘सामान्य गति’ आज अब तक के आपके %1$@ की तुलना दिन के इसी समय पर मापे गए %2$@ से करती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Uobičajeni tempo” uspoređuje vaš današnji broj %1$@ s %2$@, mjereno u isto doba dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „szokásos tempó” a mai eddigi %1$@ értéket ezzel veti össze: %2$@, a nap ugyanezen időpontjában mérve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Laju biasa” membandingkan %1$@ Anda sejauh ini hari ini dengan %2$@, diukur pada jam yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ritmo abituale» confronta i dati di oggi finora (%1$@) con quelli abituali (%2$@), rilevati alla stessa ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「いつものペース」では、今日ここまでの%1$@を、同じ時刻の%2$@と比較します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘평소 페이스’는 오늘 현재까지의 %1$@ 수치와 같은 시각에 측정한 %2$@ 수치를 비교해요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ierastais temps” salīdzina jūsu šodienas rādītāju līdz šim (%1$@) ar šo vērtību: %2$@, mērot tajā pašā dienas laikā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kadar biasa” membandingkan %1$@ anda setakat ini hari ini dengan %2$@ yang diukur pada waktu yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Vanlig tempo» sammenligner %1$@ så langt i dag med %2$@, målt på samme tidspunkt på dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Gebruikelijk tempo’ vergelijkt je %1$@ tot nu toe vandaag met %2$@, gemeten op ditzelfde tijdstip van de dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zwykłe tempo” porównuje dzisiejsze %1$@ z %2$@, mierzoną o tej samej porze dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ritmo habitual” compara o total de %1$@ de hoje até agora com %2$@, no mesmo horário do dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ritmo habitual” compara o total de %1$@ de hoje até agora com %2$@, medido a esta mesma hora do dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ritmul obișnuit” compară totalul de %1$@ de până acum azi cu %2$@, măsurată la aceeași oră din zi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Обычный темп» сравнивает ваши %1$@ за сегодня с %2$@ к этому же времени дня."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Obvyklé tempo“ porovnáva dnešnú hodnotu %1$@ s %2$@, vždy v rovnakom čase dňa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Vanlig takt” jämför dina %1$@ hittills i dag med %2$@, mätt vid samma tid på dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“อัตราปกติ” เปรียบเทียบ %1$@ ของวันนี้ถึงตอนนี้กับ %2$@ ซึ่งวัดในเวลาเดียวกันของวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Olağan tempo”, bugün şimdiye kadarki %1$@ değerinizi, günün aynı saatinde ölçülen %2$@ ile karşılaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Звичний темп» порівнює ваші %1$@ за сьогодні з %2$@ на цей самий час дня."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nhịp độ thường thấy” so sánh %1$@ của bạn tính đến lúc này hôm nay với %2$@ được đo vào cùng thời điểm trong ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“平时进度”会在一天中的同一时刻，将你今天截至目前的%1$@与%2$@进行比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「平常進度」會將你今天目前為止的 %1$@，與一天中同一時間的 %2$@ 比較。"
          }
        }
      }
