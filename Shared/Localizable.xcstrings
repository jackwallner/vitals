            "value" : "इस अवधि की पिछली अवधि से तुलना: औसत, प्रतिशत बदलाव और सबसे ऊँचे आँकड़ों वाले दिन।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo razdoblje u odnosu na prošlo: prosjeci, postotna promjena i dani s najvišim vrijednostima."
          }
        },
        "hu" : {
          "stringUnit" : {
