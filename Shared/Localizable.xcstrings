    "Burn minus Apple Health food on Today + History." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السعرات المحروقة ناقص الطعام المسجّل في صحتي، ضمن تبويبي اليوم والسجل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výdej mínus jídlo ze Zdraví na kartách Dnes a Historie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbrænding minus mad fra Sundhed på fanerne I dag og Historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbrauch minus Kalorienzufuhr aus Apple Health in „Heute“ und „Verlauf“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καύση μείον πρόσληψη θερμίδων στην Υγεία, στις καρτέλες «Σήμερα» + «Ιστορικό»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferencia entre el gasto calórico y la ingesta según Apple Salud en Hoy + Historial."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Põletatud kalorid miinus Tervisesse kantud toiduenergia vaadetes Täna ja Ajalugu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کالری سوزانده‌شده منهای کالری دریافتی ثبت‌شده در Apple Health، در بخش‌های امروز و تاریخچه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulutetut kalorit miinus Terveys-appiin kirjattu ruokaenergia Tänään- ja Historia-näkymissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calories brûlées moins calories consommées dans Apple Santé, sur les écrans Aujourd’hui et Historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההפרש בין הקלוריות שנשרפו לקלוריות ממזון שנרשם בבריאות, במסכי היום וההיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज और इतिहास टैब पर सेहत ऐप में दर्ज भोजन घटाने के बाद बची कैलोरी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrošnja minus hrana iz aplikacije Zdravlje na karticama Danas i Povijest."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elégetett kalória mínusz az Apple Egészségben rögzített kalóriabevitel a Ma + Előzmények nézetben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalori terbakar dikurangi kalori makanan dari Kesehatan di tab Hari Ini + Riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calorie bruciate meno quelle assunte in Apple Salute, in Oggi + Cronologia."
          }
        },
        "ja" : {
