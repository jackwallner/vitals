    "Enable Active Energy, Basal Energy,\nand Step Count for Total Calories." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الطاقة النشطة وطاقة الراحة\nوعدد الخطوات لـ Total Calories."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte Aktivní energii, Klidovou energii\na Kroky pro Total Calories."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivér Aktiv energi, Basal energi\nog Skridt for Total Calories."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Aktive Energie, Grundumsatz\nund Schritte für Total Calories."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε Ενεργή ενέργεια, Ενέργεια ηρεμίας\nκαι Βήματα για το Total Calories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Energía activa, Energía en reposo\ny Pasos para Total Calories."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luba Total Calories'ile Aktiivne energia, Baasenergia\nja Sammude arv."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انرژی فعال، انرژی پایه\nو تعداد قدم را برای Total Calories فعال کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön Aktiivinen energia, Lepoenergia\nja Askelmäärä Total Caloriesille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Énergie active, Énergie au repos\net Nombre de pas pour Total Calories."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להפעיל אנרגיה פעילה, אנרגיית מנוחה\nוספירת צעדים עבור Total Calories."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories के लिए सक्रिय ऊर्जा, बेसल ऊर्जा\nऔर कदम गिनती चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključite Aktivnu energiju, Energiju mirovanja\ni Korake za Total Calories."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be az Aktív energiát, az Alapenergiát\nés a Lépésszámot a Total Calories számára."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Energi Aktif, Energi Basal,\ndan Jumlah Langkah untuk Total Calories."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Energia attiva, Energia a riposo\ne Passi per Total Calories."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Caloriesで「アクティブエネルギー」「安静時消費エネルギー」\n「歩数」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories에 활동 에너지, 휴식 에너지,\n걸음 수를 허용하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieslēdziet Active Energy, Basal Energy\nun Step Count lietotnei Total Calories."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidupkan Tenaga Aktif, Tenaga Basal\ndan Kiraan Langkah untuk Total Calories."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Aktiv energi, Basal energi\nog Skritt for Total Calories."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel Actieve energie, Basale energie\nen Stappen in voor Total Calories."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Energię aktywną, Energię spoczynkową\ni Kroki dla Total Calories."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Energia Ativa, Energia Basal\ne Contagem de Passos para o Total Calories."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Energia Ativa, Energia Basal\ne Contagem de Passos para o Total Calories."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați Energie activă, Energie bazală\nși Număr de pași pentru Total Calories."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
