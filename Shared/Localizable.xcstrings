    "Generate a 30-day report and preview before sharing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ تقريرًا لـ 30 يومًا واعرضه قبل المشاركة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte zprávu za 30 dní a před sdílením si ji prohlédněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en 30-dages rapport, og se en forhåndsvisning før deling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle einen 30-Tage-Bericht und sieh ihn vor dem Teilen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε αναφορά 30 ημερών και δείτε την πριν την κοινοποίηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera un informe de 30 días y revísalo antes de compartirlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loo 30-päevane aruanne ja vaata eelvaadet enne jagamist."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گزارش ۳۰ روزه بسازید و پیش از اشتراک‌گذاری پیش‌نمایش ببینید."
          }
        },
        "fi" : {
          "stringUnit" : {
