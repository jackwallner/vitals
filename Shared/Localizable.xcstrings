    "A Sunday evening notification summarizing your week. Turning it on asks permission to notify you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعار مساء الأحد يلخّص أسبوعك. عند تفعيله، سيطلب التطبيق إذنًا بإرسال الإشعارات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedělní večerní oznámení se shrnutím týdne. Po zapnutí se zobrazí žádost o povolení oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En søndagsnotifikation med et resumé af din uge. Når du slår den til, bliver du bedt om tilladelse til notifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonntagabends erhältst du eine Wochenübersicht als Mitteilung. Beim Einschalten fragt die App, ob sie dir Mitteilungen senden darf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ειδοποίηση την Κυριακή το βράδυ με τη σύνοψη της εβδομάδας. Η ενεργοποίηση ζητά άδεια για ειδοποιήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación el domingo por la tarde con el resumen de tu semana. Al activarla se pide permiso para notificarte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pühapäeva õhtul saabuv teavitus, mis võtab nädala kokku. Sisselülitamisel küsitakse teavituste luba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلانی در عصر یکشنبه که هفتهٔ شما را خلاصه می‌کند. روشن کردن آن مجوز ارسال اعلان می‌خواهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunnuntai-iltana tuleva ilmoitus, joka tiivistää viikkosi. Kun otat sen käyttöön, sinulta kysytään lupa ilmoituksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification le dimanche soir qui résume votre semaine. L’activer demande l’autorisation d’envoyer des notifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התראה ביום ראשון בערב שמסכמת את השבוע. ההפעלה מבקשת הרשאה להתראות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रविवार शाम को आपके सप्ताह का सारांश देने वाली सूचना। इसे चालू करने पर सूचना भेजने की अनुमति माँगी जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijest s pregledom tjedna koja stiže u nedjelju navečer. Kad je uključite, aplikacija će zatražiti dopuštenje za slanje obavijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vasárnap esti értesítés a heted összefoglalójával. Bekapcsolásakor engedélyt kérünk az értesítésekhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi Minggu malam yang merangkum minggu Anda. Saat diaktifkan, Anda akan diminta izin untuk menerima notifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
