    "Example macros card. Protein, carbs, and fat from a day of logged food. The figures shown are blurred placeholders, not your own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiel-Makrokarte. Protein, Kohlenhydrate und Fett eines Tages mit erfasstem Essen. Die Werte sind unscharfe Platzhalter, nicht deine eigenen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjeta de macros de ejemplo. Proteína, carbohidratos y grasa de un día de comidas registradas. Las cifras son ejemplos difuminados, no tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exemple de carte macros. Protéines, glucides et lipides d’une journée de repas enregistrés. Les chiffres sont des exemples floutés, pas les vôtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheda macro di esempio. Proteine, carboidrati e grassi di un giorno di pasti registrati. I valori sono segnaposto sfocati, non i tuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロカードの例。1日分の記録した食事のタンパク質・炭水化物・脂質です。表示の数値はぼかしたサンプルで、あなたのデータではありません。"
          }
        },
        "zh-Hans" : {
