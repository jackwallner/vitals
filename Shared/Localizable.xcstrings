    "Needs about a month of Apple Health data to settle. Days without resting energy are skipped rather than counted as zero." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج إلى نحو شهر من بيانات صحتي ليستقر. تُتخطى الأيام التي لا تحتوي على طاقة الراحة بدل احتسابها صفرًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustálí se asi po měsíci dat z aplikace Zdraví. Dny bez klidové energie se přeskakují, nepočítají se jako nula."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tager cirka en måned med data fra Sundhed, før beregningen bliver stabil. Dage uden hvileenergi springes over i stedet for at tælle som nul."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für stabile Werte braucht es etwa einen Monat an Daten aus Apple Health. Tage ohne Ruheenergie werden übersprungen, statt als null zu zählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζεται περίπου έναν μήνα δεδομένων από την Υγεία για να σταθεροποιηθεί. Οι ημέρες χωρίς ενέργεια ηρεμίας παραλείπονται αντί να μετρούν ως μηδέν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita alrededor de un mes de datos de Apple Salud para estabilizarse. Los días sin energía en reposo se omiten en lugar de contar como cero."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvutuse stabiliseerumiseks on vaja umbes kuu jagu Tervisest pärit andmeid. Päevad, mille kohta puhkeenergia andmed puuduvad, jäetakse vahele ega loeta nulliks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تثبیت آن به حدود یک ماه داده از Apple Health نیاز است. روزهایی که انرژی استراحت ندارند کنار گذاشته می‌شوند، نه اینکه صفر حساب شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vakiintuminen vaatii noin kuukauden Terveys-apin tietoja. Päivät, joilta lepoenergia puuttuu, ohitetaan eikä niitä lasketa nollaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut environ un mois de données d’Apple Santé pour que le calcul se stabilise. Les jours sans données d’énergie au repos sont ignorés plutôt que comptés comme zéro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נדרש בערך חודש של נתוני בריאות כדי להתייצב. ימים בלי אנרגיית מנוחה מדולגים ולא נספרים כאפס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थिर अनुमान के लिए सेहत ऐप का लगभग एक महीने का डेटा चाहिए। बिना विश्राम ऊर्जा वाले दिन शून्य गिनने के बजाय छोड़ दिए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebno je oko mjesec dana podataka iz aplikacije Zdravlje da se vrijednosti stabiliziraju. Dani bez energije u mirovanju preskaču se, umjesto da se računaju kao nula."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagyjából egy hónapnyi Apple Egészségből származó adatra van szükség, hogy az érték stabilizálódjon. A nyugalmi energia nélküli napokat kihagyja, nem nullaként számolja őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlu sekitar sebulan data dari app Kesehatan agar hasilnya stabil. Hari tanpa energi istirahat dilewati, bukan dihitung sebagai nol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve circa un mese di dati di Apple Salute per ottenere una stima stabile. I giorni senza energia a riposo vengono saltati invece di essere contati come zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定するまでに約1か月分のヘルスケアデータが必要です。安静時エネルギーのない日は0として数えずに飛ばします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안정되려면 Apple 건강 데이터가 한 달 정도 필요해요. 휴식 에너지가 없는 날은 0으로 계산하지 않고 건너뛰어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai rādītāji nostabilizētos, vajadzīgs apmēram mēnesis datu no lietotnes Apple Veselība. Dienas, kurās nav reģistrēta miera enerģija, tiek izlaistas, nevis skaitītas kā nulle."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memerlukan kira-kira sebulan data daripada Kesihatan sebelum anggaran menjadi stabil. Hari tanpa tenaga rehat dilangkau dan bukannya dikira sifar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregningen trenger omtrent en måned med data fra Helse for å stabilisere seg. Dager uten hvileenergi hoppes over i stedet for å regnes som null."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft ongeveer een maand aan gegevens uit Gezondheid nodig om te stabiliseren. Dagen zonder rustenergie worden overgeslagen in plaats van als nul geteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do ustabilizowania wyniku potrzeba około miesiąca danych z aplikacji Zdrowie. Dni bez energii spoczynkowej są pomijane, a nie liczone jako zero."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisa de cerca de um mês de dados do Apple Saúde para se estabilizar. Dias sem energia em repouso são ignorados em vez de contados como zero."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estimativa estabiliza após cerca de um mês de dados da app Saúde. Os dias sem dados de energia em repouso são ignorados, em vez de contarem como zero."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimarea se stabilizează după aproximativ o lună de date din aplicația Sănătate. Zilele fără energie de repaus sunt omise, nu considerate zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для стабилизации расчётов нужен примерно месяц данных из приложения «Здоровье». Дни без показателя энергии покоя пропускаются, а не считаются нулём."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustáli sa asi po mesiaci údajov z apky Zdravie. Dni bez pokojovej energie sa preskakujú, nepočítajú sa ako nula."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tar ungefär en månad med data från Apple Hälsa innan värdet stabiliseras. Dagar utan vilokalorier hoppas över i stället för att räknas som noll."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้ข้อมูลจากแอปสุขภาพราว 1 เดือนจึงจะได้ค่าที่นิ่ง วันที่ไม่มีพลังงานขณะพักจะถูกข้ามแทนที่จะนับเป็นศูนย์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha tutarlı sonuçlar için Sağlık uygulamasından yaklaşık bir aylık veri gerekir. Dinlenme enerjisi olmayan günler sıfır sayılmak yerine atlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібно близько місяця даних із програми «Здоров’я», щоб показник стабілізувався. Дні без даних про енергію спокою пропускаються, а не вважаються нульовими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần khoảng một tháng dữ liệu từ Sức khỏe để ổn định. Những ngày không có năng lượng nghỉ sẽ bị bỏ qua thay vì tính là 0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要约一个月的 Apple 健康数据，估算结果才会趋于稳定。没有静息能量记录的日子会跳过，不会按零计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要大約一個月的 Apple 健康資料才會穩定。沒有靜息能量的日子會略過，不會算成零。"
          }
        }
      }
    },
