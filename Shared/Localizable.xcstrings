    "Your pause and excluded days are saved. Every day is counting toward your averages again until Vitals+ is back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإيقاف وأيامك المستبعدة محفوظة. يُحتسب كل يوم في متوسطاتك من جديد حتى يعود Vitals+."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastavení a vyřazené dny jsou uložené. Dokud se Vitals+ nevrátí, počítá se do průměrů znovu každý den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din pause og dine udeladte dage er gemt. Alle dage tæller igen med i dine gennemsnit, indtil Vitals+ er tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Pause und ausgeschlossenen Tage sind gespeichert. Bis Vitals+ zurück ist, zählt wieder jeder Tag in deinen Durchschnitten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η παύση και οι εξαιρεμένες ημέρες σας έχουν αποθηκευτεί. Κάθε μέρα μετρά ξανά στους μέσους όρους μέχρι να επιστρέψει το Vitals+."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pausa y tus días excluidos están guardados. Cada día vuelve a contar en tus medias hasta que vuelva Vitals+."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu paus ja välja jäetud päevad on salvestatud. Iga päev arvestatakse jälle sinu keskmistes, kuni Vitals+ naaseb."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف و روزهای مستثنای شما ذخیره شده‌اند. تا بازگشت Vitals+ دوباره هر روز در میانگین‌های شما حساب می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taukosi ja ohitetut päiväsi on tallennettu. Jokainen päivä lasketaan taas keskiarvoihisi, kunnes Vitals+ palaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre pause et vos jours exclus sont enregistrés. Chaque jour compte à nouveau dans vos moyennes jusqu’au retour de Vitals+."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההשהיה והימים המוחרגים נשמרו. עד ש־Vitals+ יחזור, כל יום נספר שוב בממוצעים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रोक और बाहर किए गए दिन सहेजे गए हैं। Vitals+ के लौटने तक हर दिन फिर आपके औसत में गिना जा रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauza i isključeni dani su spremljeni. Dok se Vitals+ ne vrati, svaki dan ponovno ulazi u prosjeke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szüneteltetés és a kizárt napjaid mentve vannak. Minden nap újra beleszámít az átlagaidba, amíg a Vitals+ vissza nem tér."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeda dan hari yang Anda kecualikan tersimpan. Setiap hari kembali dihitung dalam rata-rata Anda hingga Vitals+ kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pausa e i giorni esclusi sono salvati. Ogni giorno torna a contare nelle medie finché Vitals+ non torna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止と除外日は保存されています。Vitals+が戻るまで、再びすべての日が平均に含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지와 제외한 날은 저장돼 있어요. Vitals+가 돌아올 때까지는 모든 날이 다시 평균에 포함돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu pauze un izslēgtās dienas ir saglabātas. Katra diena atkal tiek skaitīta vidējos, līdz Vitals+ atgriezīsies."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeda dan hari dikecualikan anda disimpan. Setiap hari dikira semula dalam purata anda sehingga Vitals+ kembali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausen og de utelatte dagene dine er lagret. Alle dager teller i gjennomsnittene dine igjen til Vitals+ er tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je pauze en uitgesloten dagen zijn opgeslagen. Elke dag telt weer mee voor je gemiddelden tot Vitals+ terug is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauza i wykluczone dni są zapisane. Dopóki Vitals+ nie wróci, każdy dzień znów liczy się do średnich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua pausa e seus dias excluídos estão salvos. Todos os dias voltam a contar nas suas médias até o Vitals+ voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua pausa e os seus dias excluídos estão guardados. Todos os dias voltam a contar nas suas médias até o Vitals+ voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauza și zilele excluse sunt salvate. Fiecare zi contează din nou în medii până revine Vitals+."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пауза и исключённые дни сохранены. Пока Vitals+ не вернётся, все дни снова учитываются в средних."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastavenie a vyradené dni sú uložené. Kým sa Vitals+ nevráti, počíta sa do priemerov znova každý deň."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din paus och dina undantagna dagar är sparade. Alla dagar räknas in i dina medelvärden igen tills Vitals+ är tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การหยุดและวันที่ไม่นับของคุณถูกบันทึกไว้ ทุกวันจะนับในค่าเฉลี่ยอีกครั้งจนกว่า Vitals+ จะกลับมา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatmanız ve hariç tutulan günleriniz kaydedildi. Vitals+ geri gelene kadar her gün yeniden ortalamalarınıza sayılıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паузу й виключені дні збережено. Доки Vitals+ не повернеться, усі дні знову враховуються в середніх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc tạm dừng và các ngày đã loại của bạn đã được lưu. Mọi ngày lại được tính vào mức trung bình cho đến khi Vitals+ trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的暂停和排除日期已保存。在 Vitals+ 恢复之前，每一天都会重新计入平均值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的暫停和排除日已儲存。在 Vitals+ 恢復前，每一天都會重新計入平均值。"
          }
        }
      }
    },
