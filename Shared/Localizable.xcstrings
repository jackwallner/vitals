        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre refeições em um app de alimentação que grave proteínas, carboidratos e gorduras no Apple Saúde, como o MyFitnessPal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registe refeições numa app de alimentação que envie proteínas, hidratos de carbono e gorduras para a app Saúde, como o MyFitnessPal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrați mesele într-o aplicație de nutriție care trimite în aplicația Sănătate date despre proteine, carbohidrați și grăsimi, precum MyFitnessPal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте еду в приложении для учёта питания, которое передаёт белки, углеводы и жиры в приложение «Здоровье», например MyFitnessPal."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisujte jedlá v aplikácii na sledovanie stravy, ktorá posiela bielkoviny, sacharidy a tuky do apky Zdravie, napríklad MyFitnessPal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga måltider i en matapp som skriver protein, kolhydrater och fett till Apple Hälsa, som MyFitnessPal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกมื้ออาหารในแอปบันทึกอาหารที่ส่งข้อมูลโปรตีน คาร์โบไฮเดรต และไขมันไปยังแอปสุขภาพ เช่น MyFitnessPal"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein, karbonhidrat ve yağ verilerini Sağlık uygulamasına aktaran MyFitnessPal gibi bir beslenme uygulamasında öğünlerinizi kaydedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записуйте їжу в програмі, яка передає білки, вуглеводи й жири в програму «Здоров’я», наприклад MyFitnessPal."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi bữa ăn bằng ứng dụng theo dõi dinh dưỡng có thể ghi đạm, chất bột đường và chất béo vào Sức khỏe, như MyFitnessPal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用能将蛋白质、碳水和脂肪写入 Apple 健康的饮食 App（如 MyFitnessPal）记录饮食。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用會把蛋白質、碳水化合物和脂肪寫入 Apple 健康的飲食 App 記錄餐點，例如 MyFitnessPal。"
          }
        }
      }
    },
