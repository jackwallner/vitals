    "Where today's calories and steps will land at your current pace." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أين ستنتهي سعرات اليوم وخطواته بوتيرتك الحالية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kde dnešní kalorie a kroky skončí při současném tempu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor dagens kalorier og skridt lander i dit nuværende tempo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo deine Kalorien und Schritte heute bei deinem aktuellen Tempo landen."
