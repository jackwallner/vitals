    "Apple Health didn't return calories eaten for this period." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health hat für diesen Zeitraum keine gegessenen Kalorien geliefert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salud no devolvió calorías ingeridas para este periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Santé n’a renvoyé aucune calorie consommée pour cette période."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
