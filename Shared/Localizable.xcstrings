        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE і BMR оцінюють вашу витрату. ІМТ і відсоток жиру доповнюють профіль тіла."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE và BMR ước tính lượng calo bạn đốt. BMI và tỷ lệ mỡ cơ thể giúp mô tả thể trạng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE 与 BMR 可估算你的能量消耗。BMI 和体脂率有助于你更全面地了解身体状况。"
