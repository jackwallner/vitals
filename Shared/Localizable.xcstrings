        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לייצא סיכום מסודר של אבן הדרך הזו לשמירה או לשיתוף עם מאמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस पड़ाव का साफ़ सारांश एक्सपोर्ट करें, अपने पास रखने या कोच के साथ साझा करने के लिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
