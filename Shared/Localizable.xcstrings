        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí energii z dnes zapsaného jídla a podíl jednotlivých makroživin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer den madenergi, du har registreret i dag, og hver makros andel af den."
          }
        },
        "de" : {
