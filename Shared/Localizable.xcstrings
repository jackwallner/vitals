        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los días que no deben contar (enfermedad, viajes, un día sin reloj) y todas las medias, totales y rachas los omiten."
          }
        },
        "fr" : {
          "stringUnit" : {
