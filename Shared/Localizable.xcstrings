    "Tap a day before the pause to take it out too. Tap it again to put it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Tag vor der Pause, um ihn ebenfalls herauszunehmen. Tippe erneut, um ihn zurückzuholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un día anterior a la pausa para quitarlo también. Tócalo otra vez para volver a incluirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un jour avant la pause pour l’écarter aussi. Touchez-le à nouveau pour le remettre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un giorno prima della pausa per escludere anche quello. Toccalo di nuovo per rimetterlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止より前の日もタップで外せます。もう一度タップすると戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点暂停之前的某一天也可将其排除。再次轻点即可恢复。"
          }
        }
      }
    },
