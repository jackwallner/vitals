        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порівнює ваш прогрес із вашим звичним темпом на цей час за даними програми «Здоров’я». %1$@ Порожні дні не враховуються. %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh tiến độ của bạn đến giờ với mức thường lệ vào thời điểm này (Sức khỏe). %1$@ Ngày trống không được tính. %2$@"
