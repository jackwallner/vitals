    "Total Calories reads Active Energy, Resting Energy, and Step Count from Apple Health in read-only mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Total Calories الطاقة النشطة وطاقة الراحة وعدد الخطوات من صحتي في وضع القراءة فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories z aplikace Zdraví pouze čte aktivní energii, klidovou energii a počet kroků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories læser data fra Sundhed om aktiv energi, hvileenergi og skridt i skrivebeskyttet tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories liest Aktive Energie, Ruheenergie und Schritte aus Apple Health im Nur-Lese-Modus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Total Calories διαβάζει μόνο τα δεδομένα Ενεργής ενέργειας, Ενέργειας ηρεμίας και αριθμού βημάτων από την εφαρμογή «Υγεία»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lee la energía activa, la energía en reposo y los pasos de Apple Salud en modo solo lectura."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories loeb Tervisest aktiivset energiat, puhkeenergiat ja sammude arvu ning ei kirjuta Tervisesse andmeid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Total Calories انرژی فعال، انرژی پایه و تعداد قدم را از Apple Health فقط در حالت خواندنی می‌خواند."
