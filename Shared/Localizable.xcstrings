          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez un rapport sur 30 jours et prévisualisez-le avant de le partager."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ליצור דוח ל־30 יום ולצפות בתצוגה מקדימה לפני השיתוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 दिन की रिपोर्ट बनाएँ और साझा करने से पहले प्रीव्यू देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
