    "Needs about a month of Apple Health data to settle. Days without resting energy are skipped rather than counted as zero." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht etwa einen Monat Apple Health Daten, um sich einzupendeln. Tage ohne Ruheenergie werden übersprungen statt als null gezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita alrededor de un mes de datos de Apple Salud para estabilizarse. Los días sin energía en reposo se omiten en lugar de contar como cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut environ un mois de données Apple Santé pour se stabiliser. Les jours sans énergie au repos sont ignorés plutôt que comptés à zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono circa un mese di dati di Apple Salute per stabilizzarsi. I giorni senza energia a riposo vengono saltati invece che contati come zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定するまでに約1か月分のヘルスケアデータが必要です。安静時エネルギーのない日は0として数えずに飛ばします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要约一个月的 Apple 健康数据才能稳定。没有静息能量的日子会被跳过，而不是计为零。"
          }
        }
      }
    },
