          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doel gehaald laat je weten wanneer je elk doel voor het eerst op een dag haalt, ook als de app gesloten is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel osiągnięty informuje, gdy po raz pierwszy w danym dniu osiągniesz cel, nawet przy zamkniętej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
