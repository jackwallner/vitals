    "Apple Health didn't return calories eaten for this period." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُرجع تطبيق صحتي السعرات المأكولة لهذه الفترة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Zdraví nevrátilo snědené kalorie za toto období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Sundhed returnerede ikke spiste kalorier for denne periode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health hat für diesen Zeitraum keine gegessenen Kalorien geliefert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Apple Υγεία δεν επέστρεψε θερμίδες φαγητού για αυτή την περίοδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salud no devolvió calorías ingeridas para este periodo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health ei tagastanud selle perioodi söödud kaloreid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health کالری خوردنی این دوره را ارائه نکرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Terveys ei palauttanut syötyjä kaloreita tältä jaksolta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Santé n’a renvoyé aucune calorie consommée pour cette période."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפליקציית בריאות לא החזירה קלוריות שנאכלו בתקופה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple स्वास्थ्य ने इस अवधि के लिए खाई गई कैलोरी नहीं दीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Zdravlje nije vratilo pojedene kalorije za ovo razdoblje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple Egészség nem adott vissza elfogyasztott kalóriát erre az időszakra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Kesehatan tidak mengembalikan kalori makanan untuk periode ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salute non ha restituito calorie assunte per questo periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この期間の摂取カロリーがヘルスケアから取得できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 건강에서 이 기간의 섭취 칼로리를 가져오지 못했어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health neatgrieza apēstās kalorijas par šo periodu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Kesihatan tidak mengembalikan kalori makanan untuk tempoh ini."
          }
        },
        "nb" : {
          "stringUnit" : {
