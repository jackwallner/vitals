    "A little more movement closes out your calorie goal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قليل من الحركة الإضافية ويكتمل هدف السعرات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocha pohybu navíc a máte kalorický cíl splněný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidt mere bevægelse, så er dit kaloriemål nået."
          }
        },
        "de" : {
          "stringUnit" : {
