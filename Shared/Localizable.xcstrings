        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravie sa možno ešte synchronizuje. Skontrolujte, či hodinky alebo fitness aplikácia pridali údaje, prípadne skontrolujte prístup k Zdraviu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Hälsa synkroniserar kanske fortfarande. Kontrollera att din klocka eller träningsapp har lagt till data, eller kontrollera åtkomsten till Hälsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปสุขภาพอาจยังซิงค์ข้อมูลอยู่ ตรวจสอบว่านาฬิกาหรือแอปฟิตเนสบันทึกข้อมูลแล้ว หรือตรวจสอบสิทธิ์การเข้าถึงแอปสุขภาพ"
