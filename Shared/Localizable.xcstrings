        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a Salud está desactivado. En el iPhone: Ajustes → Privacidad → Salud → Total Calories."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
