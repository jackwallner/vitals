    "Compares your progress so far to your usual at this time (Apple Health). %@ Empty days don’t count. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقارن تقدمك حتى الآن بمعدلك المعتاد في هذا الوقت (صحتي). %1$@ لا تُحسب الأيام الفارغة. %2$@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovná dosavadní postup s vaším obvyklým průběhem v tuto dobu (Zdraví). %1$@ Prázdné dny se nepočítají. %2$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenligner dine fremskridt indtil nu med dit sædvanlige tempo på dette tidspunkt (Sundhed). %1$@ Tomme dage tæller ikke. %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht deinen bisherigen Fortschritt mit deinem üblichen Stand zu dieser Uhrzeit (Apple Health). %1$@ Leere Tage zählen nicht. %2$@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνει την πρόοδό σας μέχρι τώρα με τη συνηθισμένη σας επίδοση αυτή την ώρα (Υγεία). %1$@ Οι ημέρες χωρίς δεδομένα δεν μετρούν. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Compares your progress so far to your usual at this time (Apple Health). %1$@ Empty days don’t count. %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara tu progreso hasta ahora con lo habitual a esta hora (Apple Salud). %1$@ Los días vacíos no cuentan. %2$@"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võrdleb sinu senist edenemist tavapärasega sama aja seisuga (Tervis). %1$@ Tühje päevi ei arvestata. %2$@"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیشرفت شما تا این لحظه را با روند معمول شما در همین ساعت مقایسه می‌کند (Apple Health). %1$@ روزهای خالی حساب نمی‌شوند. %2$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa tähänastista edistymistäsi tavanomaiseen tahtiin tähän aikaan Terveys-apin tietojen perusteella. %1$@ Tyhjiä päiviä ei lasketa mukaan. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare votre progression à ce stade avec votre rythme habituel à la même heure (Apple Santé). %1$@ Les jours sans données ne comptent pas. %2$@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משווה את ההתקדמות עד כה להתקדמות הרגילה שלך עד שעה זו (בריאות). %1$@ ימים ללא נתונים לא נחשבים. %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज के इस समय पर आपकी सामान्य गति से अब तक की प्रगति की तुलना करता है (सेहत ऐप)। %1$@ खाली दिन नहीं गिने जाते। %2$@"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uspoređuje vaš dosadašnji napredak s uobičajenim napretkom u ovo doba, prema podacima iz aplikacije Zdravlje. %1$@ Dani bez podataka ne računaju se. %2$@"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Összeveti az eddigi haladásodat az ilyenkor megszokott tempóddal (Apple Egészség). %1$@ Az üres napok nem számítanak. %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membandingkan progres Anda sejauh ini dengan progres yang biasanya Anda capai pada jam yang sama (Kesehatan). %1$@ Hari tanpa data tidak dihitung. %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta i progressi finora con il tuo andamento abituale a quest’ora (Apple Salute). %1$@ I giorni vuoti non contano. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまでの進み具合を、この時刻のいつもの値と比較します（ヘルスケア）。%@ データのない日は数えません。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재까지의 진행 상황을 이 시간대의 평소 수준과 비교해요(건강 앱). %1$@ 데이터가 없는 날은 포함하지 않아요. %2$@"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salīdzina līdzšinējo progresu ar jūsu ierasto progresu šajā laikā, balstoties uz lietotnes Veselība datiem. %1$@ Tukšās dienas netiek skaitītas. %2$@"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membandingkan kemajuan anda setakat ini dengan kebiasaan anda pada masa ini (app Kesihatan). %1$@ Hari kosong tidak dikira. %2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenligner fremgangen din så langt med det som er vanlig for deg på dette tidspunktet (Helse). %1$@ Dager uten data teller ikke. %2$@"
