          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljerte trender trenger data for kalorier eller skritt fra en tilsvarende tidligere periode for å kunne sammenligne utviklingen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
