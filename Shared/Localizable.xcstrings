        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este período comparado ao anterior: médias, variação percentual e dias de pico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparação deste período com o anterior: médias, variação percentual e dias com valores máximos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această perioadă comparată cu cea anterioară: medii, variații procentuale și zile de vârf."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнение этого периода с предыдущим: средние значения, изменение в процентах и пиковые дни."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto obdobie oproti minulému: priemery, percentuálne zmeny a vrcholné dni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här perioden jämförd med den förra: medelvärden, procentuell utveckling och toppdagar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่วงนี้เทียบกับช่วงก่อน: ค่าเฉลี่ย เปอร์เซ็นต์การเปลี่ยนแปลง และวันที่สูงสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dönemin önceki dönemle karşılaştırması: ortalamalar, yüzde değişimi ve en yüksek günler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей період порівняно з попереднім: середні значення, відсоткова зміна й пікові дні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kỳ này so với kỳ trước: mức trung bình, thay đổi theo phần trăm và ngày cao điểm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本时段与上一时段对比：平均值、百分比变化和峰值日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這段期間與上一期比較：平均值、百分比變化和高峰日。"
          }
        }
      }
    },
