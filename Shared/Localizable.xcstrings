    "Export a clean summary of this milestone to keep or share with a coach." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدّر ملخصًا مرتبًا لهذا الإنجاز لتحتفظ به أو تشاركه مع مدرب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportujte shrnutí tohoto milníku a uložte si ho nebo ho pošlete trenérovi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportér en overskuelig oversigt over denne milepæl til at gemme eller dele med en coach."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere eine übersichtliche Zusammenfassung dieses Meilensteins zum Behalten oder Teilen mit einem Coach."
