    "Averages are paused: every new day is excluded until you resume. Open this row (or the banner above the tab bar) to resume or edit the days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchschnitte pausiert: Jeder neue Tag wird ausgeschlossen, bis du fortsetzt. Öffne diese Zeile (oder das Banner über der Tableiste), um fortzusetzen oder Tage zu bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medias en pausa: cada día nuevo se excluye hasta que las reanudes. Abre esta fila (o el aviso sobre la barra de pestañas) para reanudar o editar los días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyennes en pause : chaque nouveau jour est exclu jusqu’à la reprise. Ouvrez cette ligne (ou la bannière au-dessus de la barre d’onglets) pour reprendre ou modifier les jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medie in pausa: ogni nuovo giorno è escluso finché non riprendi. Apri questa riga (o il banner sopra la barra delle schede) per riprendere o modificare i giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均は一時停止中です。再開するまで新しい日はすべて除外されます。この行（またはタブバー上のバナー）を開くと、再開や日の編集ができます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均值已暂停：在恢复前，每个新的一天都会被排除。打开此行（或标签栏上方的横幅）即可恢复或编辑日期。"
          }
        }
      }
    },
