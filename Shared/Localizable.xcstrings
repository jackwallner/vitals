    "Auto-renews unless cancelled 24h before it ends. Cancel in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد تلقائيًا ما لم يُلغَ قبل الانتهاء بـ 24 ساعة. ألغِ من الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovuje se automaticky, pokud nezrušíte 24 h před koncem. Zrušit můžete v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes automatisk, medmindre den opsiges 24 timer før den slutter. Opsig i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, wenn du nicht mindestens 24 Std. vor Ablauf kündigst. Kündige in den Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανανεώνεται αυτόματα, εκτός αν ακυρωθεί 24 ώρες πριν τη λήξη. Ακύρωση στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente salvo que canceles 24 h antes del final. Cancela en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uueneb automaatselt, kui seda ei tühistata 24 tundi enne lõppu. Tühista Seadetes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمدید خودکار، مگر اینکه ۲۴ ساعت پیش از پایان لغو شود. در تنظیمات لغو کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusiutuu automaattisesti, ellei peruta 24 tuntia ennen päättymistä. Peruuta Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique sauf annulation 24 h avant la fin. Annulez dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתחדש אוטומטית אלא אם מבטלים 24 שעות לפני הסוף. ביטול בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समाप्त होने से 24 घंटे पहले रद्द न करने पर अपने आप नवीनीकृत होगा। सेटिंग्ज़ में रद्द करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski se obnavlja ako ne otkažete 24 h prije kraja. Otkažite u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan megújul, hacsak nem mondod le a vége előtt 24 órával. Lemondás a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperpanjang otomatis kecuali dibatalkan 24 jam sebelum berakhir. Batalkan di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente se non annulli 24 ore prima della scadenza. Annulla in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了の24時間前までに解約しない限り自動更新。解約は設定から。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료 24시간 전까지 취소하지 않으면 자동 갱신돼요. 설정에서 취소하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atjaunojas automātiski, ja neatceļat 24 h pirms perioda beigām. Atceliet abonementu iestatījumos."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperbaharui secara automatik melainkan dibatalkan 24 jam sebelum tamat. Batalkan dalam Tetapan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementet fornyes automatisk med mindre du sier det opp 24 timer før perioden slutter. Si opp i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch verlengd tenzij je 24 uur voor het einde opzegt. Zeg op in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odnawia się automatycznie, jeśli nie anulujesz 24 godz. przed końcem. Anuluj w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova automaticamente, a menos que seja cancelada 24 h antes do fim. Cancele em Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova-se automaticamente, a menos que seja cancelada 24 h antes do fim. Cancele em Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reînnoiește automat dacă nu este anulat cu 24 de ore înainte de final. Anulați din Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автопродление, если не отменить за 24 ч до конца. Отмена в Настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovuje sa automaticky, ak nezrušíte 24 h pred koncom. Zrušenie v Nastaveniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnyas automatiskt om du inte säger upp prenumerationen minst 24 timmar innan perioden löper ut. Säg upp den i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่ออายุอัตโนมัติหากไม่ยกเลิกล่วงหน้าอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบ ยกเลิกได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitişten 24 saat önce iptal edilmezse otomatik yenilenir. Ayarlar'dan iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підписка продовжується автоматично, якщо її не скасувати за 24 год до завершення. Скасувати її можна в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động gia hạn trừ khi hủy ít nhất 24 giờ trước khi kỳ hạn kết thúc. Hủy trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在到期前 24 小时取消，否则自动续订。可在“设置”中取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在結束前 24 小時取消，否則將自動續訂。可在「設定」中取消。"
          }
        }
      }
    },
    "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد تلقائيًا ما لم يُلغَ قبل 24 ساعة على الأقل من نهاية الفترة الحالية. يمكنك الإدارة أو الإلغاء من الإعدادات › Apple ID › الاشتراكات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předplatné se automaticky obnovuje, pokud ho nezrušíte nejméně 24 hodin před koncem aktuálního období. Spravovat nebo zrušit ho můžete v Nastavení › Apple ID › Předplatná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes automatisk, medmindre den opsiges mindst 24 timer før udgangen af den nuværende periode. Administrer eller opsig i Indstillinger › Apple ID › Abonnementer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, wenn nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird. Verwalten oder kündigen unter Einstellungen › Apple-Account › Abonnements."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανανεώνεται αυτόματα, εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν το τέλος της τρέχουσας περιόδου. Διαχείριση ή ακύρωση στις Ρυθμίσεις › Apple ID › Συνδρομές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente salvo que canceles al menos 24 horas antes del final del periodo actual. Gestiona o cancela en Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uueneb automaatselt, kui seda ei tühistata vähemalt 24 tundi enne praeguse perioodi lõppu. Tellimust saad hallata või tühistada menüüs Seaded › Apple ID › Tellimused."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمدید خودکار، مگر اینکه دست‌کم ۲۴ ساعت پیش از پایان دوره فعلی لغو شود. در تنظیمات › Apple ID › اشتراک‌ها مدیریت یا لغو کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusiutuu automaattisesti, ellei peruta vähintään 24 tuntia ennen nykyisen jakson päättymistä. Hallitse tai peruuta kohdassa Asetukset › Apple ID › Tilaukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique sauf annulation au moins 24 heures avant la fin de la période en cours. Gérez ou annulez dans Réglages › Identifiant Apple › Abonnements."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתחדש אוטומטית אלא אם מבטלים לפחות 24 שעות לפני סוף התקופה הנוכחית. לניהול או ביטול: הגדרות › Apple ID › מינויים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न करने पर सदस्यता अपने आप नवीनीकृत होगी। इसे सेटिंग्ज़ › Apple ID › सदस्यताओं में प्रबंधित या रद्द करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski se obnavlja ako ne otkažete najmanje 24 sata prije kraja trenutnog razdoblja. Upravljajte pretplatom ili je otkažite u Postavkama › Apple ID › Pretplate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan megújul, hacsak nem mondod le legalább 24 órával az aktuális időszak vége előtt. Kezelés vagy lemondás: Beállítások › Apple ID › Előfizetések."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperpanjang otomatis kecuali dibatalkan setidaknya 24 jam sebelum periode saat ini berakhir. Kelola atau batalkan di Pengaturan › Apple ID › Langganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente se non annulli almeno 24 ore prima della fine del periodo in corso. Gestisci o annulla in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の期間が終了する24時間以上前に解約しない限り、自動的に更新されます。管理・解約は「設定」›「Apple アカウント」›「サブスクリプション」から。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 기간 종료 최소 24시간 전까지 취소하지 않으면 자동 갱신돼요. 설정 › Apple ID › 구독에서 관리하거나 취소하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atjaunojas automātiski, ja neatceļat vismaz 24 stundas pirms pašreizējā perioda beigām. Pārvaldiet vai atceliet: Iestatījumi › Apple ID › Abonementi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperbaharui secara automatik melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tamat tempoh semasa. Urus atau batalkan dalam Tetapan › Apple ID › Langganan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementet fornyes automatisk med mindre du sier det opp minst 24 timer før den gjeldende perioden slutter. Administrer eller si opp i Innstillinger › Apple-ID › Abonnementer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch verlengd tenzij je minstens 24 uur voor het einde van de huidige periode opzegt. Beheer of zeg op via Instellingen › Apple ID › Abonnementen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcja odnawia się automatycznie, chyba że anulujesz ją co najmniej 24 godziny przed końcem bieżącego okresu. Możesz nią zarządzać lub ją anulować w Ustawieniach › Apple ID › Subskrypcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele em Ajustes › Conta Apple › Assinaturas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova-se automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Gira ou cancele em Definições › ID Apple › Subscrições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reînnoiește automat dacă nu este anulat cu cel puțin 24 de ore înainte de sfârșitul perioadei curente. Gestionați sau anulați în Configurări › Apple ID › Abonamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка продлевается автоматически, если не отменить её минимум за 24 часа до конца текущего периода. Управление и отмена: Настройки › Apple ID › Подписки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predplatné sa automaticky obnovuje, ak ho nezrušíte aspoň 24 hodín pred koncom aktuálneho obdobia. Spravovať alebo zrušiť ho môžete v Nastaveniach › Apple ID › Predplatné."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnyas automatiskt om du inte säger upp prenumerationen minst 24 timmar innan den aktuella perioden löper ut. Hantera eller säg upp den i Inställningar › Apple-ID › Prenumerationer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่ออายุอัตโนมัติ เว้นแต่ยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบปัจจุบัน จัดการหรือยกเลิกได้ที่ การตั้งค่า › Apple ID › การสมัครสมาชิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut dönemin bitiminden en az 24 saat önce iptal edilmezse otomatik yenilenir. Ayarlar › Apple ID › Abonelikler'den yönetin veya iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підписка продовжується автоматично, якщо не скасувати її щонайменше за 24 години до кінця поточного періоду. Керування й скасування: Параметри › Apple ID › Підписки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động gia hạn trừ khi hủy ít nhất 24 giờ trước khi kỳ hạn hiện tại kết thúc. Quản lý hoặc hủy trong Cài đặt › Apple ID › Đăng ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在当前周期结束前至少 24 小时取消，否则将自动续订。可在“设置”›“Apple 账户”›“订阅”中管理或取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非在當期結束前至少 24 小時取消，否則將自動續訂。可在「設定」›「Apple ID」›「訂閱項目」中管理或取消。"
          }
        }
      }
    },
    "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد تلقائيًا ما لم يُلغَ قبل 24 ساعة على الأقل من نهاية الفترة الحالية. يمكنك الإدارة أو الإلغاء من الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předplatné se automaticky obnovuje, pokud ho nezrušíte nejméně 24 hodin před koncem aktuálního období. Spravovat nebo zrušit ho můžete v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes automatisk, medmindre den opsiges mindst 24 timer før udgangen af den nuværende periode. Administrer eller opsig i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, wenn nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird. Verwalten oder kündigen in den Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανανεώνεται αυτόματα, εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν το τέλος της τρέχουσας περιόδου. Διαχείριση ή ακύρωση στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente salvo que canceles al menos 24 horas antes del final del periodo actual. Gestiona o cancela en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uueneb automaatselt, kui seda ei tühistata vähemalt 24 tundi enne praeguse perioodi lõppu. Halda või tühista Seadetes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمدید خودکار، مگر اینکه دست‌کم ۲۴ ساعت پیش از پایان دوره فعلی لغو شود. در تنظیمات مدیریت یا لغو کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusiutuu automaattisesti, ellei peruta vähintään 24 tuntia ennen nykyisen jakson päättymistä. Hallitse tai peruuta Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique sauf annulation au moins 24 heures avant la fin de la période en cours. Gérez ou annulez dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתחדש אוטומטית אלא אם מבטלים לפחות 24 שעות לפני סוף התקופה הנוכחית. ניהול או ביטול בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न करने पर अपने आप नवीनीकृत होगा। सेटिंग्ज़ में प्रबंधित या रद्द करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski se obnavlja ako ne otkažete najmanje 24 sata prije kraja trenutnog razdoblja. Upravljajte pretplatom ili je otkažite u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan megújul, hacsak nem mondod le legalább 24 órával az aktuális időszak vége előtt. Kezelés vagy lemondás a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperpanjang otomatis kecuali dibatalkan setidaknya 24 jam sebelum periode saat ini berakhir. Kelola atau batalkan di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente se non annulli almeno 24 ore prima della fine del periodo in corso. Gestisci o annulla in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の期間が終了する24時間以上前に解約しない限り、自動的に更新されます。管理・解約は設定から。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 기간 종료 최소 24시간 전까지 취소하지 않으면 자동 갱신돼요. 설정에서 관리하거나 취소하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atjaunojas automātiski, ja neatceļat vismaz 24 stundas pirms pašreizējā perioda beigām. Pārvaldiet vai atceliet iestatījumos."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperbaharui secara automatik melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tamat tempoh semasa. Urus atau batalkan dalam Tetapan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementet fornyes automatisk med mindre du sier det opp minst 24 timer før den gjeldende perioden slutter. Administrer eller si opp i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch verlengd tenzij je minstens 24 uur voor het einde van de huidige periode opzegt. Beheer of zeg op in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcja odnawia się automatycznie, chyba że anulujesz ją co najmniej 24 godziny przed końcem bieżącego okresu. Możesz nią zarządzać lub ją anulować w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele em Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova-se automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Gira ou cancele em Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reînnoiește automat dacă nu este anulat cu cel puțin 24 de ore înainte de sfârșitul perioadei curente. Gestionați sau anulați în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка продлевается автоматически, если не отменить её минимум за 24 часа до конца текущего периода. Управление и отмена в Настройках."
          }
        },
        "sk" : {
