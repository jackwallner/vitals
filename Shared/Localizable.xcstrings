    "TDEE and BMR estimate your burn. BMI and body fat help frame your body profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TDEE und BMR schätzen deinen Verbrauch. BMI und Körperfett helfen, dein Körperprofil einzuordnen."
          }
