    "%@. Auto-renews unless cancelled 24h before the period ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. يتجدد تلقائيًا ما لم يُلغَ قبل انتهاء الفترة بـ 24 ساعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Obnovuje se automaticky, pokud nezrušíte 24 h před koncem období."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Fornyes automatisk, medmindre den opsiges 24 timer før perioden slutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Verlängert sich automatisch, wenn nicht spätestens 24 Std. vor Ablauf gekündigt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ανανεώνεται αυτόματα, εκτός αν ακυρωθεί 24 ώρες πριν τη λήξη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Se renueva automáticamente salvo que canceles al menos 24 h antes de que acabe el periodo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Uueneb automaatselt, kui seda ei tühistata 24 tundi enne perioodi lõppu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. تمدید خودکار، مگر اینکه ۲۴ ساعت پیش از پایان دوره لغو شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Uusiutuu automaattisesti, ellei peruta 24 tuntia ennen jakson päättymistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Renouvellement automatique sauf annulation au moins 24 h avant la fin de la période."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. מתחדש אוטומטית אלא אם מבטלים 24 שעות לפני סוף התקופה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। अवधि समाप्त होने से 24 घंटे पहले रद्द न करने पर अपने आप नवीनीकृत होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Automatski se obnavlja ako ne otkažete 24 h prije kraja razdoblja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Automatikusan megújul, hacsak nem mondod le az időszak vége előtt 24 órával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Diperpanjang otomatis kecuali dibatalkan 24 jam sebelum periode berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Si rinnova automaticamente se non annulli almeno 24 ore prima della fine del periodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。期間終了の24時間前までに解約しない限り自動更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 기간 종료 24시간 전까지 취소하지 않으면 자동 갱신돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Atjaunojas automātiski, ja neatceļat 24 h pirms perioda beigām."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Diperbaharui secara automatik melainkan dibatalkan 24 jam sebelum tempoh tamat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Fornyes automatisk med mindre den sies opp 24 timer før perioden slutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Wordt automatisch verlengd tenzij je minstens 24 uur voor het einde van de periode opzegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Odnawia się automatycznie, jeśli nie anulujesz 24 godz. przed końcem okresu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Renova automaticamente, a menos que seja cancelado 24 h antes do fim do período."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Renova automaticamente, a menos que seja cancelada 24 h antes do fim do período."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Se reînnoiește automat dacă nu este anulat cu 24 de ore înainte de încheierea perioadei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Автопродление, если не отменить за 24 ч до конца периода."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Obnovuje sa automaticky, ak nezrušíte 24 h pred koncom obdobia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Förnyas automatiskt om det inte sägs upp 24 timmar innan perioden slutar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ต่ออายุอัตโนมัติ เว้นแต่ยกเลิกก่อนสิ้นสุดรอบ 24 ชั่วโมง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Dönem bitiminden 24 saat önce iptal edilmezse otomatik yenilenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Автопродовження, якщо не скасувати за 24 год до кінця періоду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tự động gia hạn trừ khi hủy trước khi kỳ hạn kết thúc 24 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。除非在周期结束前至少 24 小时取消，否则将自动续订。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。除非在期間結束前 24 小時取消，否則將自動續訂。"
          }
        }
      }
    },
    "%@. One-time purchase. Lifetime access, no subscription." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. شراء لمرة واحدة. وصول مدى الحياة بلا اشتراك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jednorázový nákup. Doživotní přístup bez předplatného."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Engangskøb. Livstidsadgang, intet abonnement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Einmalkauf. Dauerhafter Zugang, kein Abo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Εφάπαξ αγορά. Πρόσβαση εφ’ όρου ζωής, χωρίς συνδρομή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Compra única. Acceso de por vida, sin suscripción."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ühekordne ost. Eluaegne ligipääs, tellimust pole."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. خرید یک‌باره. دسترسی دائمی، بدون اشتراک."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Kertaosto. Elinikäinen käyttöoikeus, ei tilausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Achat unique. Accès à vie, sans abonnement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. רכישה חד־פעמית. גישה לכל החיים, ללא מינוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। एकमुश्त खरीदारी। आजीवन एक्सेस, कोई सदस्यता नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jednokratna kupnja. Doživotni pristup, bez pretplate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Egyszeri vásárlás. Élethosszig tartó hozzáférés, előfizetés nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Pembelian sekali bayar. Akses seumur hidup, tanpa langganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Acquisto unico. Accesso a vita, nessun abbonamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。買い切り。サブスクなしでずっと使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 일회성 구매. 구독 없이 평생 이용."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Vienreizējs pirkums. Mūža piekļuve bez abonementa."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Pembelian sekali sahaja. Akses seumur hidup, tanpa langganan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Engangskjøp. Livstidstilgang, uten abonnement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Eenmalige aankoop. Levenslange toegang, geen abonnement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jednorazowy zakup. Dostęp dożywotni, bez subskrypcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Compra única. Acesso vitalício, sem assinatura."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Compra única. Acesso vitalício, sem subscrição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Achiziție unică. Acces pe viață, fără abonament."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Разовая покупка. Доступ навсегда, без подписки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jednorazový nákup. Doživotný prístup bez predplatného."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Engångsköp. Livstidsåtkomst, ingen prenumeration."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ซื้อครั้งเดียว ใช้ได้ตลอดชีพ ไม่มีค่าสมาชิก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tek seferlik satın alma. Ömür boyu erişim, abonelik yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Разова покупка. Доступ назавжди, без підписки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Mua một lần. Truy cập trọn đời, không cần đăng ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。一次性购买，永久使用，无需订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。一次性購買，終身使用，無需訂閱。"
          }
        }
      }
