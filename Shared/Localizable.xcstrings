    "BMI is a simple height/weight reference and is not a diagnosis. It may not reflect muscle mass, pregnancy, age, or individual health context." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مؤشر كتلة الجسم مرجع بسيط للطول والوزن وليس تشخيصًا. قد لا يعكس الكتلة العضلية أو الحمل أو العمر أو الحالة الصحية الفردية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI je jednoduchý ukazatel výšky a váhy, ne diagnóza. Nemusí zohledňovat svalovou hmotu, těhotenství, věk ani individuální zdravotní stav."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI er en enkel reference for højde/vægt og ikke en diagnose. Det afspejler måske ikke muskelmasse, graviditet, alder eller individuel sundhedstilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der BMI ist ein einfacher Richtwert aus Größe und Gewicht und keine Diagnose. Er berücksichtigt weder Muskelmasse, Schwangerschaft, Alter noch deine individuellen gesundheitlichen Umstände."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ΔΜΣ είναι ένας απλός δείκτης με βάση το ύψος και το βάρος, όχι διάγνωση. Μπορεί να μην αντικατοπτρίζει τη μυϊκή μάζα, την εγκυμοσύνη, την ηλικία ή την ατομική κατάσταση της υγείας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El IMC es una referencia sencilla de altura y peso, no un diagnóstico. Puede no reflejar masa muscular, embarazo, edad ni tu contexto de salud."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KMI on pikkuse ja kaalu põhjal arvutatav lihtne näitaja, mitte diagnoos. See ei pruugi kajastada lihasmassi, rasedust, vanust ega individuaalset terviseseisundit."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏BMI یک مرجع ساده بر پایه قد و وزن است و تشخیص پزشکی نیست. ممکن است توده عضلانی، بارداری، سن یا شرایط سلامت فردی را نشان ندهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI on yksinkertainen pituuden ja painon vertailuluku, ei diagnoosi. Se ei välttämättä huomioi lihasmassaa, raskautta, ikää tai yksilöllistä terveystilannetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IMC est un simple repère taille/poids, pas un diagnostic. Il peut ne pas refléter la masse musculaire, une grossesse, l’âge ou votre situation de santé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏BMI הוא מדד פשוט של גובה ומשקל ואינו אבחנה. הוא לא בהכרח משקף מסת שריר, היריון, גיל או את ההקשר הבריאותי האישי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI लंबाई और वज़न पर आधारित एक सरल संदर्भ है, निदान नहीं। हो सकता है कि यह मांसपेशी द्रव्यमान, गर्भावस्था, उम्र या व्यक्तिगत स्वास्थ्य स्थिति को न दर्शाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI je jednostavan pokazatelj na temelju visine i težine, a ne dijagnoza. Možda ne odražava mišićnu masu, trudnoću, dob ili osobno zdravstveno stanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A BMI egyszerű viszonyítási alap a magasság és a testsúly arányához, nem diagnózis. Lehet, hogy nem tükrözi az izomtömeget, a terhességet, az életkort vagy az egyéni egészségi állapotot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI adalah acuan sederhana berdasarkan tinggi dan berat badan, bukan diagnosis. BMI mungkin tidak mencerminkan massa otot, kehamilan, usia, atau kondisi kesehatan pribadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il BMI è un semplice riferimento basato su altezza e peso, non una diagnosi. Potrebbe non riflettere la massa muscolare, la gravidanza, l’età o il tuo stato di salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMIは身長と体重による簡単な目安で、診断ではありません。筋肉量、妊娠、年齢、個々の健康状態は反映されない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI는 키와 체중으로 구하는 간단한 참고 수치이며 진단이 아니에요. 근육량, 임신, 나이, 개인의 건강 상태를 반영하지 못할 수 있어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ĶMI ir vienkāršs auguma un svara attiecības rādītājs, nevis diagnoze. Tas var neatspoguļot muskuļu masu, grūtniecību, vecumu vai individuālo veselības stāvokli."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI ialah rujukan ringkas ketinggian/berat dan bukan diagnosis. Ia mungkin tidak mencerminkan jisim otot, kehamilan, umur atau konteks kesihatan individu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI er en enkel referanse for høyde/vekt og ikke en diagnose. Den gjenspeiler kanskje ikke muskelmasse, graviditet, alder eller individuell helsetilstand."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI is een eenvoudige maatstaf op basis van lengte en gewicht en is geen diagnose. De BMI geeft mogelijk geen volledig beeld van spiermassa, zwangerschap, leeftijd of je persoonlijke gezondheidssituatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI to prosty wskaźnik oparty na wzroście i masie ciała, a nie diagnoza. Może nie uwzględniać masy mięśniowej, ciąży, wieku ani indywidualnego stanu zdrowia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O IMC é uma referência simples de altura/peso e não é um diagnóstico. Pode não refletir massa muscular, gravidez, idade ou o contexto de saúde individual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O IMC é uma referência simples de altura/peso e não é um diagnóstico. Pode não refletir massa muscular, gravidez, idade ou o contexto de saúde individual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IMC este un indicator simplu bazat pe înălțime și greutate, nu un diagnostic. Poate să nu reflecte masa musculară, sarcina, vârsta sau contextul individual de sănătate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИМТ: простой ориентир по росту и весу, а не диагноз. Он может не учитывать мышечную массу, беременность, возраст или индивидуальные особенности здоровья."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI je jednoduchý ukazovateľ výšky a hmotnosti, nie diagnóza. Nemusí zohľadňovať svalovú hmotu, tehotenstvo, vek ani individuálny zdravotný stav."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI är ett enkelt mått baserat på längd och vikt, inte en diagnos. Det tar kanske inte hänsyn till muskelmassa, graviditet, ålder eller andra individuella hälsofaktorer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI เป็นเพียงค่าอ้างอิงจากส่วนสูงและน้ำหนัก ไม่ใช่การวินิจฉัย อาจไม่สะท้อนมวลกล้ามเนื้อ การตั้งครรภ์ อายุ หรือสภาวะสุขภาพของแต่ละคน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VKİ basit bir boy/kilo göstergesidir ve tanı değildir. Kas kütlesini, hamileliği, yaşı veya bireysel sağlık durumunu yansıtmayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ІМТ є простим орієнтиром за зростом і вагою, а не діагнозом. Він може не враховувати м’язову масу, вагітність, вік чи індивідуальний стан здоров’я."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI là chỉ số tham khảo đơn giản về chiều cao/cân nặng và không phải chẩn đoán. Chỉ số này có thể không phản ánh khối lượng cơ, thai kỳ, tuổi tác hay tình trạng sức khỏe cá nhân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI 只是基于身高和体重的简单参考，并非诊断。它可能无法反映肌肉量、怀孕、年龄或个人健康状况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMI 是依身高和體重計算的簡易參考指標，不能作為診斷。它可能無法反映肌肉量、懷孕、年齡或個人健康狀況。"
          }
        }
      }
    },
