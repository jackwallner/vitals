    "Deep Trends need a previous matching range with calories or steps before they can compare your momentum." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج الاتجاهات المعمّقة إلى نطاق سابق مماثل فيه سعرات أو خطوات حتى تقارن زخمك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hloubkové trendy potřebují předchozí stejné období s kaloriemi nebo kroky, aby mohly porovnat vývoj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dybe tendenser kræver en tidligere tilsvarende periode med kalorier eller skridt, før de kan sammenligne din fremgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefere Trends brauchen einen vorherigen gleich langen Zeitraum mit Kalorien oder Schritten, bevor sie deine Entwicklung vergleichen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι Βαθιές τάσεις χρειάζονται ένα προηγούμενο αντίστοιχο εύρος με θερμίδες ή βήματα για να συγκρίνουν τη δυναμική σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tendencias a fondo necesitan un periodo anterior equivalente con calorías o pasos para comparar tu evolución."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süvatrendid vajavad eelnevat vastavat vahemikku kaloritega või sammudega, enne kui nad saavad sinu hoogu võrrelda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روندهای عمیق به یک بازه مشابه قبلی با کالری یا قدم نیاز دارند تا بتوانند روند شما را مقایسه کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syvät trendit tarvitsevat edellisen vastaavan aikavälin, jolla on kaloreita tai askelia, ennen kuin ne voivat verrata vauhtiasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tendances détaillées ont besoin d’une période précédente équivalente avec des calories ou des pas pour comparer votre dynamique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגמות מעמיקות צריכות טווח קודם מקביל עם קלוריות או צעדים כדי להשוות את המומנטום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गहरे ट्रेंड के लिए तुलना से पहले कैलोरी या कदम वाली पिछली मेल खाती अवधि चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubinskim trendovima treba prethodno isto razdoblje s kalorijama ili koracima da bi usporedili zamah."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mély trendekhez egy korábbi, megfelelő tartomány kell kalóriával vagy lépéssel, mielőtt összehasonlíthatnák a lendületedet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren Mendalam memerlukan rentang sebelumnya yang setara dengan kalori atau langkah sebelum dapat membandingkan momentum Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tendenze approfondite richiedono un periodo precedente equivalente con calorie o passi per confrontare i tuoi progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細トレンドで比較するには、カロリーか歩数のある直前の同じ長さの期間が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심층 추세는 흐름을 비교하려면 칼로리나 걸음이 있는 직전의 같은 기간이 필요해요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padziļinātajām tendencēm vajag iepriekšēju atbilstošu periodu ar kalorijām vai soļiem, lai salīdzinātu dinamiku."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trend Mendalam memerlukan julat setara sebelumnya dengan kalori atau langkah sebelum ia boleh membandingkan momentum anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dype trender trenger en tidligere tilsvarende periode med kalorier eller skritt før de kan sammenligne fremgangen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diepe trends hebben een eerder vergelijkbaar bereik met calorieën of stappen nodig voordat ze je momentum kunnen vergelijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głębokie trendy potrzebują poprzedniego takiego samego okresu z kaloriami lub krokami, aby porównać dynamikę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tendências profundas precisam de um período anterior equivalente com calorias ou passos para comparar seu ritmo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tendências profundas precisam de um intervalo anterior equivalente com calorias ou passos para comparar o seu ritmo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendințele aprofundate au nevoie de un interval anterior echivalent cu calorii sau pași înainte de a vă putea compara avântul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубоким трендам нужен предыдущий такой же период с калориями или шагами, чтобы сравнить динамику."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hĺbkové trendy potrebujú predchádzajúce rovnaké obdobie s kalóriami alebo krokmi, aby mohli porovnať vývoj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djupa trender behöver ett tidigare motsvarande intervall med kalorier eller steg innan de kan jämföra din fart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แนวโน้มเชิงลึกต้องมีช่วงก่อนหน้าที่ตรงกันและมีแคลอรีหรือก้าว จึงจะเปรียบเทียบโมเมนตัมได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derin Eğilimler, ivmenizi karşılaştırmadan önce kalori veya adım içeren önceki eşdeğer bir aralığa ihtiyaç duyar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глибоким трендам потрібен попередній такий самий період із калоріями чи кроками, щоб порівняти динаміку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xu hướng chuyên sâu cần một khoảng tương ứng trước đó có calo hoặc bước trước khi so sánh đà của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度趋势需要有卡路里或步数的上一个同等时段，才能对比你的势头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度趨勢需要前一個相同範圍內有卡路里或步數資料，才能比較你的動能。"
          }
        }
      }
    },
    "Deep Trends: every period vs. the one before" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتجاهات معمّقة: كل فترة مقابل التي قبلها"
          }
        },
