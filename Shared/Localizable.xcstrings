          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pendant l’essai, puis %@. Renouvellement automatique sauf annulation 24 h avant la fin de l’essai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prova, poi %@. Si rinnova automaticamente se non annulli 24 ore prima della fine della prova."
