    "“Usual pace” compares your %@ so far today to %@, measured at this same time of day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقارن «الوتيرة المعتادة» %1$@ اليوم حتى الآن بـ %2$@، في الوقت نفسه من اليوم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Obvyklé tempo“ porovnává vaše dnešní %1$@ s %2$@, měřeno ve stejnou denní dobu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sædvanligt tempo” sammenligner dine %1$@ indtil nu i dag med %2$@, målt på samme tidspunkt af dagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Übliches Tempo“ vergleicht deine bisherigen %@ heute mit %@, gemessen zur selben Uhrzeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο «Συνήθης ρυθμός» συγκρίνει τις σημερινές σας %1$@ ως τώρα με %2$@, μετρημένο την ίδια ώρα της ημέρας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Usual pace” compares your %1$@ so far today to %2$@, measured at this same time of day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ritmo habitual» compara tus %@ de hoy con %@, medidos a esta misma hora."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Tavapärane tempo“ võrdleb sinu senist %1$@ täna väärtusega %2$@, mõõdetuna päeva samal kellaajal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«روند معمول» %1$@ تا اینجای امروز شما را با %2$@ مقایسه می‌کند که در همین ساعت روز اندازه‌گیری شده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Tavallinen tahti” vertaa tähänastisia %1$@ tänään kohtaan %2$@, mitattuna samaan kellonaikaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rythme habituel » compare vos %@ du jour à %@, mesurés à la même heure."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״הקצב הרגיל״ משווה את ה%1$@ שלך היום עד עכשיו ל%2$@, באותה שעה ביום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘सामान्य गति’ आज अब तक के आपके %1$@ की तुलना दिन के इसी समय पर मापे गए %2$@ से करती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Uobičajeni tempo” uspoređuje vaše današnje %1$@ s %2$@, mjereno u isto doba dana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „szokásos tempó” a mai eddigi %1$@ értéket hasonlítja össze ezzel: %2$@, a nap ugyanazon időpontjában mérve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Laju biasa” membandingkan %1$@ Anda sejauh ini hari ini dengan %2$@, diukur pada jam yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ritmo abituale» confronta i tuoi %@ di oggi con %@, misurati alla stessa ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「いつものペース」は、今日のここまでの%@を、同じ時刻での%@と比べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘평소 페이스’는 오늘 지금까지의 %1$@을(를) 같은 시각 기준 %2$@과(와) 비교해요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ierastais temps” salīdzina jūsu šodienas %1$@ līdz šim ar %2$@, mērot tajā pašā dienas laikā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kadar biasa” membandingkan %1$@ anda setakat ini hari ini dengan %2$@, diukur pada waktu yang sama dalam sehari."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Vanlig tempo» sammenligner %1$@ så langt i dag med %2$@, målt på samme tidspunkt av dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Gebruikelijk tempo’ vergelijkt je %1$@ tot nu toe vandaag met %2$@, gemeten op ditzelfde tijdstip van de dag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zwykłe tempo” porównuje Twoje dzisiejsze %1$@ z %2$@, mierzoną o tej samej porze dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ritmo habitual” compara seus %1$@ até agora hoje com %2$@, medidos neste mesmo horário do dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ritmo habitual” compara os seus %1$@ até agora hoje com %2$@, medidos a esta mesma hora do dia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ritmul obișnuit” compară %1$@ de până acum azi cu %2$@, măsurat la aceeași oră din zi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Обычный темп» сравнивает ваши %1$@ за сегодня с %2$@ к этому же времени дня."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Obvyklé tempo“ porovnáva vaše dnešné %1$@ s %2$@, merané v rovnakom čase dňa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Vanlig takt” jämför dina %1$@ hittills i dag med %2$@, mätt vid samma tid på dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“จังหวะปกติ” เปรียบเทียบ%1$@ของวันนี้ถึงตอนนี้กับ%2$@ ที่วัดเวลาเดียวกันของวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Olağan tempo”, bugün şimdiye kadarki %1$@ değerinizi %2$@ ile günün aynı saatinde ölçerek karşılaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Звичний темп» порівнює ваші %1$@ за сьогодні з %2$@ на цей самий час дня."
