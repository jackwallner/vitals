          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luba juurdepääs Apple Healthile,\net laadida sinu päris andmed."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی Apple Health را فعال کنید\nتا داده‌های واقعی شما بارگذاری شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
