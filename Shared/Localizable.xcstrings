          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezd az Apple Egészséghez való hozzáférést\na valós adataid betöltéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
