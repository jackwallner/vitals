    "A Sunday evening notification summarizing your week. Turning it on asks permission to notify you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعار مساء الأحد يلخّص أسبوعك. تفعيله يطلب إذن الإشعارات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedělní večerní oznámení se shrnutím týdne. Po zapnutí se zobrazí žádost o povolení oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En søndagsnotifikation med et resumé af din uge. Når du slår den til, bliver du bedt om tilladelse til notifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonntagabends eine Mitteilung mit deiner Woche. Beim Einschalten wird um Erlaubnis für Mitteilungen gebeten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ειδοποίηση την Κυριακή το βράδυ με τη σύνοψη της εβδομάδας. Η ενεργοποίηση ζητά άδεια για ειδοποιήσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación el domingo por la tarde con el resumen de tu semana. Al activarla se pide permiso para notificarte."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pühapäeva õhtul saabuv teavitus, mis võtab nädala kokku. Sisselülitamisel küsitakse teavituste luba."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان عصر یکشنبه که هفته شما را خلاصه می‌کند. روشن کردن آن مجوز ارسال اعلان می‌خواهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunnuntai-iltana tuleva ilmoitus, joka tiivistää viikkosi. Kun otat sen käyttöön, sinulta kysytään lupa ilmoituksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification le dimanche soir qui résume votre semaine. L’activer demande l’autorisation d’envoyer des notifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התראה ביום ראשון בערב שמסכמת את השבוע. ההפעלה מבקשת הרשאה להתראות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रविवार शाम को आपके सप्ताह का सारांश देने वाली सूचना। इसे चालू करने पर सूचना भेजने की अनुमति माँगी जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijest u nedjelju navečer s pregledom tjedna. Uključivanjem se traži dopuštenje za obavijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vasárnap esti értesítés a heted összefoglalójával. Bekapcsolásakor engedélyt kérünk az értesítésekhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi Minggu malam yang merangkum minggu Anda. Saat diaktifkan, Anda akan diminta izin untuk menerima notifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica la domenica sera con il riepilogo della settimana. Attivandola ti verrà chiesto il permesso per le notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日曜の夜に1週間をまとめて通知します。オンにすると通知の許可を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일요일 저녁, 한 주를 요약한 알림을 보내드려요. 켜면 알림 권한을 요청해요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svētdienas vakara paziņojums ar nedēļas kopsavilkumu. Ieslēdzot tiks prasīta atļauja paziņojumiem."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan malam Ahad yang meringkaskan minggu anda. Menghidupkannya akan meminta kebenaran untuk memberitahu anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et søndagsvarsel som oppsummerer uken din. Når du slår det på, blir du bedt om tillatelse til å sende varsler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een melding op zondagavond met een samenvatting van je week. Als je dit aanzet, vragen we toestemming voor meldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienie w niedzielę wieczorem z podsumowaniem tygodnia. Po włączeniu pojawi się prośba o zgodę na powiadomienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação no domingo à noite com o resumo da sua semana. Ao ativar, pediremos permissão para enviar notificações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação ao domingo à noite com o resumo da sua semana. Ao ativá-la, será pedida autorização para notificações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O notificare duminică seara care vă rezumă săptămâna. Activarea ei cere permisiunea de a trimite notificări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомление в воскресенье вечером с итогами недели. При включении появится запрос на уведомления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedeľné večerné oznámenie so zhrnutím týždňa. Po zapnutí sa zobrazí žiadosť o povolenie oznámení."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En söndagskvällsavisering som sammanfattar din vecka. När du slår på den ombeds du ge tillstånd för aviseringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนสรุปสัปดาห์ของคุณทุกเย็นวันอาทิตย์ การเปิดใช้จะขออนุญาตแจ้งเตือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haftanızı özetleyen Pazar akşamı bildirimi. Açtığınızda bildirim izni istenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення в неділю ввечері з підсумками тижня. Після ввімкнення з’явиться запит на сповіщення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo tối Chủ nhật tóm tắt tuần của bạn. Bật lên sẽ yêu cầu quyền gửi thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周日晚上发送一周总结通知。开启时会请求通知权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週日晚上傳送一則本週摘要通知。開啟時會請求通知權限。"
          }
        }
      }
    },
