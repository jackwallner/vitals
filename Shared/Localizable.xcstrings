          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शाम को एक याद दिलाने वाली सूचना जिसमें आपके लक्ष्यों और स्ट्रीक के लिए जो बचा है वह बताया जाता है। सही राह पर होने वाले दिनों में शांत रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
