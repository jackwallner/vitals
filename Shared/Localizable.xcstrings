          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på tilgang til Helse\nfor å hente de faktiske dataene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel toegang tot Gezondheid in\nom je echte gegevens te laden."
          }
        },
        "pl" : {
          "stringUnit" : {
