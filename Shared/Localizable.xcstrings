            "value" : "Delar ringen i kalorierna du förbrände i rörelse och kalorierna din kropp förbrände i vila."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบ่งวงแหวนเป็นแคลอรีที่เผาผลาญขณะเคลื่อนไหวและที่ร่างกายเผาผลาญขณะพัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halkayı hareket ederken yaktığınız kalorilere ve vücudunuzun dinlenirken yaktığı kalorilere böler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ділить кільце на калорії, спалені в русі, і калорії, які тіло спалило в спокої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia vòng thành calo bạn đốt khi vận động và calo cơ thể đốt khi nghỉ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将圆环拆分为运动消耗的卡路里和身体静息时消耗的卡路里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
