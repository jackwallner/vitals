    "Compares your progress so far to your usual at this time (Apple Health). %@ Empty days don’t count. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقارن تقدمك حتى الآن بمعدلك المعتاد في هذا الوقت (صحتي). %1$@ لا تُحسب الأيام الفارغة. %2$@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
