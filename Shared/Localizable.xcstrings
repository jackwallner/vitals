          }
        }
      }
    },
    "A lower price on Vitals+" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitals+ zum kleineren Preis"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitals+ a un precio más bajo"
          }
        },
