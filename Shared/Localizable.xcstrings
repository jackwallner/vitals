    "Add body fat in Apple Health or switch to manual entry to include it here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف نسبة الدهون في صحتي أو انتقل إلى الإدخال اليدوي لإدراجها هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte tělesný tuk do Apple Zdraví nebo přepněte na ruční zadání, aby se tu započítal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj kropsfedt i Apple Sundhed, eller skift til manuel indtastning for at inkludere det her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage den Körperfettanteil in Apple Health ein oder wechsle zur manuellen Eingabe, um ihn hier zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε λίπος σώματος στην Apple Υγεία ή περάστε σε χειροκίνητη καταχώριση για να συμπεριληφθεί εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu grasa corporal en Apple Salud o cambia a la entrada manual para verla aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisa keharasv Apple Healthis või lülitu käsitsi sisestusele, et see siia lisada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چربی بدن را در Apple Health اضافه کنید یا به ورود دستی بروید تا اینجا لحاظ شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kehonrasva Apple Terveyteen tai vaihda manuaaliseen syöttöön, niin se näkyy tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre masse grasse dans Apple Santé ou passez à la saisie manuelle pour l’afficher ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להוסיף אחוז שומן בבריאות או לעבור להזנה ידנית כדי לכלול אותו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे यहाँ शामिल करने के लिए Apple स्वास्थ्य में शरीर की वसा जोड़ें या मैन्युअल एंट्री पर जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte tjelesnu mast u Apple Zdravlje ili prijeđite na ručni unos da je uključite ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add hozzá a testzsírt az Apple Egészségben, vagy válts kézi bevitelre, hogy itt szerepeljen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan lemak tubuh di Apple Kesehatan atau beralih ke input manual untuk memasukkannya di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi la massa grassa in Apple Salute o passa all’inserimento manuale per vederla qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体脂肪率をヘルスケアに追加するか、手動入力に切り替えるとここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 포함하려면 Apple 건강에 체지방을 추가하거나 직접 입력으로 바꾸세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pievienojiet ķermeņa taukus Apple Health vai pārejiet uz manuālu ievadi, lai tos iekļautu šeit."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah lemak badan dalam Apple Kesihatan atau tukar kepada kemasukan manual untuk memasukkannya di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til kroppsfett i Apple Helse, eller bytt til manuell inntasting for å ta det med her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg lichaamsvet toe in Apple Gezondheid of schakel over op handmatige invoer om het hier mee te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj tkankę tłuszczową w Apple Zdrowie lub przełącz na wpis ręczny, aby ją tu uwzględnić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a gordura corporal no Apple Saúde ou passe para a entrada manual para incluí-la aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione a massa gorda na Saúde da Apple ou mude para a introdução manual para a incluir aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați grăsimea corporală în Apple Sănătate sau treceți la introducerea manuală pentru a o include aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте процент жира в Apple Здоровье или перейдите на ручной ввод, чтобы учесть его здесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte telesný tuk do Apple Zdravie alebo prepnite na ručné zadávanie, aby sa tu započítal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till kroppsfett i Apple Hälsa eller byt till manuell inmatning för att ta med det här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มไขมันในร่างกายใน Apple สุขภาพ หรือเปลี่ยนเป็นกรอกเองเพื่อแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vücut yağını buraya dahil etmek için Apple Sağlık'a ekleyin veya manuel girişe geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
