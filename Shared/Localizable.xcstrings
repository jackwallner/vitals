    "Open Total Calories on your iPhone to turn one on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Total Calories على iPhone لتفعيل أحدها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete Total Calories na iPhonu a zapněte aspoň jednu metriku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Total Calories på din iPhone for at slå en til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Total Calories auf deinem iPhone, um einen Wert zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε το Total Calories στο iPhone σας για να ενεργοποιήσετε κάποια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Total Calories en tu iPhone para activar uno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ava Total Calories oma iPhone'is, et see sisse lülitada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای روشن کردن آن Total Calories را در iPhone باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Total Calories iPhonessa ottaaksesi sellaisen käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Total Calories sur votre iPhone pour en activer une."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לפתוח את Total Calories ב־iPhone כדי להפעיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे चालू करने के लिए अपने iPhone पर Total Calories खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Total Calories na iPhoneu da ga uključite."
