    "You've already seen what Vitals+ adds. Keep it for about %@ a week, billed yearly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد رأيت ما يضيفه Vitals+. احتفظ به مقابل نحو %@ أسبوعيًا، يُدفع سنويًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už víte, co Vitals+ přináší. Nechte si ho zhruba za %@ týdně při roční platbě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har allerede set, hvad Vitals+ tilføjer. Behold det for cirka %@ om ugen, faktureret årligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kennst Vitals+ schon. Behalte es für rund %@ pro Woche, jährlich abgerechnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχετε ήδη δει τι προσθέτει το Vitals+. Κρατήστε το για περίπου %@ την εβδομάδα, με ετήσια χρέωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya conoces lo que aporta Vitals+. Quédatelo por unos %@ a la semana, con pago anual."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oled juba näinud, mida Vitals+ lisab. Hoia see alles umbes %@ nädalas, arveldatakse aastas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیده‌اید Vitals+ چه چیزی اضافه می‌کند. آن را با حدود %@ در هفته نگه دارید، پرداخت سالانه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet jo nähnyt, mitä Vitals+ tuo. Pidä se noin %@ viikossa, laskutetaan vuosittain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous connaissez déjà Vitals+. Gardez-le pour environ %@ par semaine, facturé annuellement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבר ראית מה Vitals+ מוסיף. אפשר להמשיך בערך ב־%@ לשבוע, בחיוב שנתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप देख चुके हैं कि Vitals+ क्या जोड़ता है। इसे लगभग %@ प्रति सप्ताह पर रखें, सालाना बिल।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Već ste vidjeli što Vitals+ donosi. Zadržite ga za oko %@ tjedno, uz godišnju naplatu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Már láttad, mit ad hozzá a Vitals+. Tartsd meg kb. %@ áron hetente, éves számlázással."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sudah melihat apa yang ditambahkan Vitals+. Pertahankan seharga sekitar %@ per minggu, ditagih tahunan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conosci già Vitals+. Tienilo per circa %@ a settimana, fatturato annualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitals+の便利さはもうご存じのはず。年額払いで週あたり約%@で続けられます。"
          }
        },
        "ko" : {
