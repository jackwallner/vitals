    "A Sunday evening notification summarizing your week. Turning it on asks permission to notify you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonntagabends eine Mitteilung mit deiner Woche. Beim Einschalten wird um Erlaubnis für Mitteilungen gebeten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación el domingo por la tarde con el resumen de tu semana. Al activarla se pide permiso para notificarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification le dimanche soir qui résume votre semaine. L’activer demande l’autorisation d’envoyer des notifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica la domenica sera con il riepilogo della settimana. Attivandola ti verrà chiesto il permesso per le notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日曜の夜に1週間をまとめて通知します。オンにすると通知の許可を求めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周日晚上发送一周总结通知。开启时会请求通知权限。"
          }
        }
      }
    },
    "A Sunday night summary of this week vs. last." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonntagabends: diese Woche vs. letzte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El domingo por la noche: esta semana frente a la anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dimanche soir : cette semaine vs la précédente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La domenica sera: questa settimana rispetto alla scorsa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日曜夜に今週と先週を比較。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周日晚间：本周与上周对比。"
          }
        }
      }
    },
    "A Vitals+ feature. Open Total Calories to unlock." : {
      "localizations" : {
