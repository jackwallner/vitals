    "Tap a day before the pause to take it out too. Tap it again to put it back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على يوم قبل الإيقاف لاستبعاده أيضًا. اضغط عليه مرة أخرى لإعادته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na den před pozastavením a vyřaďte ho také. Dalším klepnutím ho vrátíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en dag før pausen for også at udelade den. Tryk igen for at tage den med igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Tag vor der Pause, um ihn ebenfalls herauszunehmen. Tippe erneut, um ihn zurückzuholen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε μια ημέρα πριν την παύση για να την εξαιρέσετε κι αυτή. Πατήστε ξανά για να την επαναφέρετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un día anterior a la pausa para quitarlo también. Tócalo otra vez para volver a incluirlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuduta päeva enne pausi, et ka see välja jätta. Puuduta uuesti, et see tagasi panna."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای کنار گذاشتن روزهای پیش از توقف هم، آن‌ها را لمس کنید. دوباره لمس کنید تا دوباره در میانگین‌ها حساب شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta päivää ennen taukoa ohittaaksesi myös sen. Napauta uudelleen palauttaaksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un jour avant la pause pour l’écarter aussi. Touchez-le à nouveau pour le remettre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקשה על יום לפני ההשהיה מוציאה גם אותו. הקשה נוספת מחזירה אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पॉज़ से पहले वाले दिन को भी औसत से बाहर करने के लिए टैप करें। वापस शामिल करने के लिए उसे फिर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite dan prije pauze da ga također isključite. Dodirnite ponovno da ga vratite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppints egy napra a szünet előtt, hogy azt is kizárd. Koppints rá újra, hogy visszakerüljön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk hari sebelum jeda untuk mengecualikannya juga. Ketuk lagi untuk mengembalikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un giorno prima della pausa per escludere anche quello. Toccalo di nuovo per rimetterlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止より前の日もタップで外せます。もう一度タップすると戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지 이전 날짜를 탭하면 그날도 제외돼요. 한 번 더 탭하면 다시 포함돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieskarieties dienai pirms pauzes, lai izslēgtu arī to. Pieskarieties vēlreiz, lai to atgrieztu."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik satu hari sebelum jeda untuk mengecualikannya juga. Ketik sekali lagi untuk memulihkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en dag før pausen for å utelate den også. Trykk igjen for å ta den med igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een dag vóór de pauze om die ook uit te sluiten. Tik nogmaals om hem terug te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dzień przed pauzą, aby też go wykluczyć. Stuknij ponownie, aby go przywrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um dia antes da pausa para excluí-lo também. Toque de novo para incluí-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque num dia antes da pausa para o excluir também. Toque de novo para o incluir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingeți o zi dinaintea pauzei pentru a o exclude și pe ea. Atingeți din nou pentru a o reintroduce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на день до паузы, чтобы тоже исключить его. Нажмите снова, чтобы вернуть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťuknite na deň pred pozastavením a vyraďte ho tiež. Ďalším ťuknutím ho vrátite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en dag före pausen för att undanta den också. Tryck igen för att ta med den igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะวันก่อนช่วงหยุดพักเพื่อนำออกจากค่าเฉลี่ยด้วย แตะอีกครั้งเพื่อนำกลับมานับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklamadan önceki günlerden birini daha ortalamalarınızdan çıkarmak için o güne dokunun. Ortalamalara yeniden dahil etmek için tekrar dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться дня до паузи, щоб теж виключити його. Торкніться знову, щоб повернути."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn vào một ngày trước lúc tạm dừng để loại cả ngày đó. Nhấn lại để đưa nó trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点暂停之前的某一天也可将其排除。再次轻点即可恢复。"
