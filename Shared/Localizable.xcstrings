    "Track consecutive days you hit your goal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبّع الأيام المتتالية التي تحقق فيها هدفك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte dny po sobě se splněným cílem."
          }
