            "value" : "Włącz dostęp do danych w aplikacji Zdrowie,\naby wczytać prawdziwe dane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o acesso ao Apple Saúde\npara carregar seus dados reais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o acesso à app Saúde\npara carregar os seus dados reais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați accesul la aplicația Sănătate\npentru a încărca datele reale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к данным приложения «Здоровье»,\nчтобы загрузить реальные данные."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte prístup k apke Zdravie,\naby sa načítali vaše skutočné údaje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera åtkomst till Apple Hälsa\nför att läsa in dina riktiga data."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดสิทธิ์เข้าถึงแอปสุขภาพ\nเพื่อโหลดข้อมูลจริงของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek verilerinizi yüklemek için\nSağlık uygulamasındaki verilere erişimi etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте доступ до програми «Здоров’я»,\nщоб завантажити реальні дані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật quyền truy cập Sức khỏe\nđể tải dữ liệu thực tế của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启 Apple 健康访问权限\n以载入你的真实数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請允許讀取 Apple 健康資料，\n以載入你的真實資料。"
          }
        }
      }
