            "value" : "Ghi bữa ăn trong ứng dụng ăn uống ghi đạm, tinh bột và chất béo vào Apple Sức khỏe, như MyFitnessPal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用能将蛋白质、碳水和脂肪写入 Apple 健康的饮食 App（如 MyFitnessPal）记录饮食。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用會把蛋白質、碳水化合物和脂肪寫入 Apple 健康的飲食 App 記錄餐點，例如 MyFitnessPal。"
          }
        }
      }
    },
