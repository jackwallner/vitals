            "state" : "translated",
            "value" : "נתוני החלבון, הפחמימות והשומן מגיעים ישירות מאפליקציית האוכל שבה כבר משתמשים. אין צורך להזין אותם פעמיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोटीन, कार्ब्स और फ़ैट सीधे उस फ़ूड ऐप से पढ़े जाते हैं जो आप पहले से इस्तेमाल करते हैं। दो बार कुछ दर्ज करने की ज़रूरत नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteini, ugljikohidrati i masti izravno iz aplikacije za prehranu koju već koristite. Ništa ne unosite dvaput."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehérje-, szénhidrát- és zsíradatok közvetlenül a már használt ételnaplózó appodból. Semmit nem kell kétszer megadni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
