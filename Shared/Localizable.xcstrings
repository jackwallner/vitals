    "Leave %@ out of your averages" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aus den Durchschnitten lassen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja el %@ fuera de tus medias"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écarter le %@ de vos moyennes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escludi %@ dalle medie"
          }
        },
