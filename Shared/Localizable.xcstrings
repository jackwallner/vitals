    },
    "A little more movement closes out your calorie goal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas mehr Bewegung, und dein Kalorienziel ist erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco más de movimiento y alcanzas tu objetivo de calorías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore un peu de mouvement pour atteindre votre objectif calories."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora un po’ di movimento e raggiungi l’obiettivo calorie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう少し動けばカロリー目標を達成できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
