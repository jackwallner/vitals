    "Enable Apple Health access\nto load your real data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الوصول إلى صحتي\nلتحميل بياناتك الحقيقية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte přístup ke Zdraví,\nabyste načetli skutečná data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivér adgang til Sundhed\nfor at indlæse dine egne data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Zugriff auf Apple Health,\num deine echten Daten zu laden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε την πρόσβαση στην Υγεία\nγια να φορτώσετε τα πραγματικά σας δεδομένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el acceso a Apple Salud\npara cargar tus datos reales."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luba juurdepääs rakenduse Tervis andmetele,\net laadida sinu tegelikud andmed."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی به Apple Health را فعال کنید\nتا داده‌های واقعی شما بارگذاری شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli pääsy Terveys-apin tietoihin,\njotta näet omat tietosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
