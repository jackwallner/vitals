    "Start moving! Your activity data will appear here once HealthKit records your steps and calories." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweg dich! Deine Aktivitätsdaten erscheinen hier, sobald HealthKit deine Schritte und Kalorien erfasst."
          }
        },
