          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้ พลังงานจากกิจกรรม พลังงานพื้นฐาน\nและจำนวนก้าว สำหรับ Total Calories"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories için Aktif Enerji, Bazal Enerji\nve Adım Sayısını etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть «Активна енергія», «Енергія спокою»\nі «Кроки» для Total Calories."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật Năng lượng hoạt động, Năng lượng cơ bản\nvà Số bước cho Total Calories."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 Total Calories 开启“活动能量”、“静息能量”\n和“步数”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為 Total Calories 啟用活動能量、靜息能量\n和步數。"
          }
        }
      }
    },
    "Enable Apple Health access\nto load your real data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الوصول إلى صحتي\nلتحميل بياناتك الحقيقية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte přístup k Apple Zdraví,\nabyste viděli skutečná data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivér adgang til Apple Sundhed\nfor at indlæse dine rigtige data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Apple Health Zugriff,\num deine echten Daten zu laden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε την πρόσβαση στην Apple Υγεία\nγια να φορτώσετε τα πραγματικά σας δεδομένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
