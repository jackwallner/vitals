    "Read-only. Stays on your device. No account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة فقط. تبقى على جهازك. بلا حساب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen čtení. Zůstává v zařízení. Bez účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun læsning. Bliver på din enhed. Ingen konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Lesen. Bleibt auf deinem Gerät. Kein Konto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο ανάγνωση. Μένει στη συσκευή σας. Χωρίς λογαριασμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lectura. Se queda en tu dispositivo. Sin cuenta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainult lugemiseks. Jääb sinu seadmesse. Kontot pole."
