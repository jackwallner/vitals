    "Counts consecutive days you hit a calorie or step goal. Empty days break the streak." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب الأيام المتتالية التي تحقق فيها هدف السعرات أو الخطوات. الأيام الفارغة تقطع السلسلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá dny po sobě, kdy splníte kalorický nebo krokový cíl. Prázdné dny sérii přeruší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tæller dage i træk, hvor du nåede et kalorie- eller skridtmål. Tomme dage afbryder rækken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt aufeinanderfolgende Tage, an denen du ein Kalorien- oder Schrittziel erreichst. Leere Tage beenden die Serie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά τις συνεχόμενες ημέρες που πετυχαίνετε στόχο θερμίδων ή βημάτων. Οι ημέρες χωρίς δεδομένα διακόπτουν το σερί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta los días seguidos en que alcanzas un objetivo de calorías o pasos. Los días vacíos rompen la racha."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loeb järjestikuseid päevi, mil saavutasid kalori- või sammueesmärgi. Tühjad päevad katkestavad seeria."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهایی را می‌شمارد که پیاپی به هدف کالری یا تعداد قدم‌ها رسیده‌اید. روزهای خالی این زنجیره را قطع می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee peräkkäiset päivät, joina saavutit kalori- tai askeltavoitteen. Tyhjät päivät katkaisevat putken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les jours consécutifs où vous atteignez un objectif de calories ou de pas. Un jour vide interrompt la série."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סופר ימים רצופים שבהם הושג יעד הקלוריות או הצעדים. ימים ללא נתונים שוברים את הרצף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह लगातार उन दिनों की गिनती करता है जिनमें आपने कैलोरी या कदमों का लक्ष्य पूरा किया। खाली दिन स्ट्रीक तोड़ देते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broji uzastopne dane u kojima postignete cilj kalorija ili koraka. Prazni dani prekidaju niz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egymást követő napokat számolja, amikor teljesítettél kalória- vagy lépéscélt. Az üres napok megszakítják a sorozatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghitung jumlah hari berturut-turut saat Anda mencapai target kalori atau langkah. Hari tanpa data memutus rangkaian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta i giorni consecutivi in cui raggiungi un obiettivo di calorie o passi. I giorni vuoti interrompono la serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カロリーか歩数の目標を達成した連続日数を数えます。データのない日で連続記録は途切れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칼로리나 걸음 목표를 연속으로 달성한 날수를 계산해요. 데이터가 없는 날은 연속 기록이 끊겨요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaita dienas pēc kārtas, kad sasniedzat kaloriju vai soļu mērķi. Tukšas dienas pārtrauc sēriju."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengira hari berturut-turut anda mencapai sasaran kalori atau langkah. Hari kosong memutuskan rentetan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teller dager på rad der du nådde et kalori- eller skrittmål. Tomme dager bryter rekken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt opeenvolgende dagen waarop je een calorie- of stappendoel haalde. Lege dagen verbreken de reeks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy kolejne dni z osiągniętym celem kalorii lub kroków. Puste dni przerywają serię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta dias consecutivos em que você atingiu uma meta de calorias ou passos. Dias vazios quebram a sequência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta dias consecutivos em que atingiu uma meta de calorias ou passos. Os dias vazios quebram a sequência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numără zilele consecutive în care vă atingeți obiectivul de calorii sau de pași. Zilele fără date întrerup seria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считает дни подряд, когда выполнена цель по калориям или шагам. Пустые дни прерывают серию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počíta dni po sebe, keď splníte kalorický alebo krokový cieľ. Prázdne dni sériu prerušia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknar hur många dagar i rad du når ett kalori- eller stegmål. Tomma dagar bryter serien."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับจำนวนวันติดต่อกันที่ทำเป้าหมายแคลอรีหรือก้าวได้ วันที่ไม่มีข้อมูลจะทำให้สถิติขาดช่วง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalori veya adım hedefine ulaştığınız ardışık günleri sayar. Boş günler seriyi bozar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рахує дні поспіль, коли виконано ціль за калоріями чи кроками. Порожні дні переривають серію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đếm số ngày liên tiếp bạn đạt mục tiêu calo hoặc bước. Ngày trống làm đứt chuỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统计连续达成卡路里或步数目标的天数。空白日会中断连续记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算連續達成卡路里或步數目標的天數。沒有資料的日子會中斷連續紀錄。"
          }
        }
      }
    },
    "Counts days with no food logged toward your Net Deficit history. Off by default, so an unlogged day doesn't read as a full-burn deficit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب الأيام التي لم يُسجَّل فيها طعام ضمن سجل صافي العجز. متوقف افتراضيًا حتى لا يبدو يوم بلا تسجيل كعجز كامل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Započítává dny bez zapsaného jídla do historie čistého deficitu. Ve výchozím nastavení je tato možnost vypnutá, aby den bez záznamu nepůsobil, jako by se celý výdej počítal jako deficit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medregner dage uden madregistrering i historikken over nettounderskud. Slået fra som standard, så en uregistreret dag ikke fremstår som et underskud svarende til hele forbrændingen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt Tage ohne erfasstes Essen im Nettodefizit-Verlauf mit. Standardmäßig aus, damit ein Tag ohne Eintrag nicht als volles Defizit erscheint."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνυπολογίζει στο ιστορικό καθαρού ελλείμματος τις ημέρες χωρίς καταγραφή φαγητού. Είναι απενεργοποιημένο από προεπιλογή, ώστε σε ημέρα χωρίς καταγραφή να μη μετρά όλη η καύση ως έλλειμμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye los días sin ingesta registrada en el historial de déficit neto. Está desactivado por defecto para que un día sin registro no parezca un déficit equivalente a todas las calorías quemadas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvestab netopuudujäägi ajaloos ka päevi, mil toitu pole logitud. Vaikimisi väljas, et logimata päeva ei käsitletaks kogu põletatud energiaga võrdse puudujäägina."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهای بدون غذای ثبت‌شده را هم در تاریخچهٔ کسری خالص حساب می‌کند. این گزینه به‌طور پیش‌فرض خاموش است تا روزی بدون غذای ثبت‌شده به‌اشتباه کسری معادل کل کالری‌سوزی را نشان ندهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisällyttää nettoalijäämähistoriaan päivät, joilta ei ole kirjattu ruokaa. Oletuksena pois käytöstä, jotta kirjaamaton päivä ei näyttäisi koko energiankulutusta vastaavalta alijäämältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les jours sans aliment enregistré dans l’historique du déficit net. Désactivé par défaut pour éviter qu’un jour sans données soit interprété comme un déficit égal à toute la dépense."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כולל בהיסטוריית הגירעון נטו ימים שלא נרשם בהם אוכל. האפשרות כבויה כברירת מחדל, כדי שיום ללא רישום לא יוצג כגירעון של כל הקלוריות שנשרפו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह विकल्प बिना भोजन दर्ज किए गए दिनों को नेट घाटे के इतिहास में शामिल करता है। डिफ़ॉल्ट रूप से बंद रहता है, ताकि ऐसे दिन खर्च हुई सभी कैलोरी को घाटा न माना जाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uračunava dane bez zabilježene hrane u povijest neto deficita. Zadano je isključeno kako se dan bez unosa hrane ne bi računao kao deficit u iznosu ukupno potrošenih kalorija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ételbevitel rögzítése nélküli napokat is beleszámítja a nettó hiány előzményeibe. Alapértelmezés szerint ki van kapcsolva, így az ételadat nélküli napot nem veszi teljes napi kalóriaégetésnyi hiánynak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memasukkan hari tanpa catatan makanan ke riwayat Defisit Bersih Anda. Secara default, fitur ini nonaktif agar hari tanpa catatan tidak dianggap memiliki defisit sebesar seluruh kalori yang terbakar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta i giorni senza pasti registrati nella cronologia del deficit netto. Disattivato per impostazione predefinita, così un giorno senza pasti non viene considerato un deficit pari a tutte le calorie bruciate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事記録のない日もマイナス収支の履歴に含めます。初期設定はオフで、記録のない日が全消費分のマイナス収支に見えないようにしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음식 기록이 없는 날도 순 칼로리 적자 기록에 포함해요. 기록이 없는 날을 하루 소모량 전체가 적자인 것처럼 계산하지 않도록 기본값은 꺼져 있어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieskaita dienas bez reģistrēta ēdiena neto deficīta vēsturē. Pēc noklusējuma izslēgts, lai diena bez ierakstiem neizskatītos kā pilns deficīts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengambil kira hari tanpa rekod makanan dalam sejarah Defisit Bersih anda. Ciri ini dimatikan secara lalai supaya hari tanpa rekod tidak dianggap sebagai defisit penuh berdasarkan jumlah kalori terbakar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar med dager uten registrert matinntak i historikken for nettounderskudd. Dette er av som standard, slik at dager uten registrering ikke tolkes som et underskudd på hele kaloriforbruket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neemt dagen zonder geregistreerde voeding mee in je geschiedenis van het nettotekort. Staat standaard uit, zodat zo’n dag niet wordt gezien als een tekort ter grootte van alle verbrande calorieën."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wlicza dni bez zapisanego jedzenia do historii deficytu. Domyślnie wyłączone, by dzień bez wpisów nie wyglądał jak pełny deficyt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui dias sem alimentação registrada no seu histórico de déficit líquido. Desativado por padrão, para que um dia sem registro não pareça gerar um déficit equivalente a tudo o que foi queimado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui dias sem alimentação registada no seu histórico de défice líquido. Desativado por predefinição, para que um dia sem registo não seja interpretado como um défice correspondente ao total de calorias queimadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opțiunea include în istoricul deficitului net zilele fără alimente înregistrate. Este dezactivată implicit, pentru ca o zi fără date să nu pară o zi cu deficit egal cu totalul caloriilor arse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дни без записей о еде учитываются в истории дефицита. По умолчанию функция выключена, чтобы весь расход калорий за день без записей не считался дефицитом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Započítava dni bez zaznamenaného jedla do histórie čistého deficitu. Predvolene je vypnuté, aby deň bez záznamu nevyzeral, akoby celý výdaj kalórií predstavoval deficit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar med dagar utan matloggning i historiken över nettounderskott. Funktionen är avstängd som standard, så att en dag utan loggning inte tolkas som ett underskott motsvarande hela dagens förbränning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับวันที่ไม่ได้บันทึกอาหารในประวัติขาดดุลสุทธิ ปิดไว้เป็นค่าเริ่มต้น เพื่อไม่ให้วันที่ไม่ได้บันทึกถูกมองเป็นขาดดุลเต็มจำนวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yiyecek kaydı olmayan günleri Net Açık geçmişinize dahil eder. Varsayılan olarak kapalıdır; böylece yiyecek kaydı girilmemiş bir gün, yakılan kalorilerin tamamı açıkmış gibi görünmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Враховує дні без записаної їжі в історії дефіциту. Типово вимкнено, щоб день без записів не виглядав як повний дефіцит."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính các ngày không ghi nhận thức ăn vào lịch sử Thâm hụt ròng của bạn. Tùy chọn này tắt theo mặc định để ngày không ghi nhận thức ăn không bị hiểu nhầm là thâm hụt bằng toàn bộ lượng calo đã đốt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将未记录饮食的日子计入净缺口历史。默认关闭，以免未记录饮食的日子把全部消耗都算成缺口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將沒有飲食記錄的日子也計入淨赤字記錄。預設關閉，以免沒記錄的日子把全部消耗都算成赤字。"
          }
        }
      }
    },
