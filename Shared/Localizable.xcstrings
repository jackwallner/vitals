    "Grant Apple Health access so Total Calories can load your active calories, resting calories, and steps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى صحتي ليتمكن Total Calories من تحميل سعراتك النشطة وسعرات الراحة وخطواتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte přístup k Apple Zdraví, aby Total Calories mohlo načíst aktivní kalorie, klidové kalorie a kroky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv adgang til Apple Sundhed, så Total Calories kan indlæse dine aktive kalorier, hvilekalorier og skridt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Apple Health Zugriff, damit Total Calories deine Aktivkalorien, Ruhekalorien und Schritte laden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώστε πρόσβαση στην Apple Υγεία ώστε το Total Calories να φορτώνει ενεργές θερμίδες, θερμίδες ηρεμίας και βήματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Apple Salud para que Total Calories cargue tus calorías activas, en reposo y tus pasos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna ligipääs Apple Healthile, et Total Calories saaks laadida sinu aktiivsed kalorid, puhkekalorid ja sammud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی Apple Health را بدهید تا Total Calories بتواند کالری فعال، کالری استراحت و قدم‌های شما را بارگذاری کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna pääsy Apple Terveyteen, jotta Total Calories voi ladata aktiiviset kalorit, lepokalorit ja askeleet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à Apple Santé pour que Total Calories charge vos calories actives, au repos et vos pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאשר גישה לבריאות כדי ש־Total Calories יטען קלוריות פעילות, קלוריות מנוחה וצעדים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple स्वास्थ्य एक्सेस दें ताकि Total Calories आपकी सक्रिय कैलोरी, विश्राम कैलोरी और कदम लोड कर सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustite pristup Apple Zdravlju kako bi Total Calories učitao aktivne kalorije, kalorije u mirovanju i korake."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj hozzáférést az Apple Egészséghez, hogy a Total Calories betölthesse az aktív kalóriáidat, nyugalmi kalóriáidat és lépéseidet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri akses Apple Kesehatan agar Total Calories dapat memuat kalori aktif, kalori istirahat, dan langkah Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso ad Apple Salute così Total Calories può caricare calorie attive, a riposo e passi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Caloriesがアクティブカロリー、安静時カロリー、歩数を読み込めるよう、ヘルスケアへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories가 활동 칼로리, 휴식 칼로리, 걸음을 불러올 수 있도록 Apple 건강 접근을 허용하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piešķiriet piekļuvi Apple Health, lai Total Calories varētu ielādēt aktīvās kalorijas, miera kalorijas un soļus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri akses Apple Kesihatan supaya Total Calories boleh memuatkan kalori aktif, kalori rehat dan langkah anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi tilgang til Apple Helse slik at Total Calories kan laste aktive kalorier, hvilekalorier og skritt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef toegang tot Apple Gezondheid zodat Total Calories je actieve calorieën, rustcalorieën en stappen kan laden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj dostęp do Apple Zdrowie, aby Total Calories mogło wczytać kalorie aktywne, spoczynkowe i kroki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso ao Apple Saúde para que o Total Calories carregue suas calorias ativas, calorias em repouso e passos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda acesso à Apple Saúde para que o Total Calories carregue as suas calorias ativas, calorias em repouso e passos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordați acces la Apple Sănătate pentru ca Total Calories să încarce caloriile active, caloriile de repaus și pașii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к Apple Здоровью, чтобы Total Calories загружало активные калории, калории покоя и шаги."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte prístup k Apple Zdravie, aby Total Calories mohlo načítať aktívne kalórie, pokojové kalórie a kroky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge åtkomst till Apple Hälsa så att Total Calories kan läsa in dina aktiva kalorier, vilokalorier och steg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้สิทธิ์เข้าถึง Apple สุขภาพเพื่อให้ Total Calories โหลดแคลอรีจากกิจกรรม แคลอรีขณะพัก และก้าวของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories'in aktif kalorilerinizi, dinlenme kalorilerinizi ve adımlarınızı yükleyebilmesi için Apple Sağlık erişimi verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте доступ до Apple Здоров’я, щоб Total Calories завантажувало активні калорії, калорії спокою й кроки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cấp quyền truy cập Apple Sức khỏe để Total Calories tải calo hoạt động, calo nghỉ và số bước của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请允许访问 Apple 健康，以便 Total Calories 载入你的活动卡路里、静息卡路里和步数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請允許 Apple 健康取用權限，讓 Total Calories 載入你的活動卡路里、靜息卡路里和步數。"
          }
        }
      }
    },
