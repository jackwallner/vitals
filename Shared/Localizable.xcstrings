          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky dni v tomto rozsahu sú vyradené z priemerov, takže nie je čo zhrnúť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje dag i det intervallet är undantagen från dina medelvärden, så det finns inget att sammanfatta."
