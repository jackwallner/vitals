          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קדימה לזוז! נתוני הפעילות יופיעו כאן ברגע ש־HealthKit יתעד צעדים וקלוריות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चलना शुरू करें! HealthKit के आपके कदम और कैलोरी दर्ज करते ही आपका गतिविधि डेटा यहाँ दिखेगा।"
