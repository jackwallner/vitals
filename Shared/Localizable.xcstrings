    "Grant Apple Health access so Total Calories can load your active energy, resting energy, and steps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى صحتي ليتمكن Total Calories من تحميل الطاقة النشطة وطاقة الراحة وخطواتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte aplikaci Total Calories přístup ke Zdraví, aby mohla načíst aktivní energii, klidovou energii a kroky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv adgang til Sundhed, så Total Calories kan indlæse aktiv energi, hvileenergi og skridt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf Apple Health, damit Total Calories deine aktive Energie, Ruheenergie und Schritte laden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε στο Total Calories να διαβάζει από την Υγεία την ενεργή ενέργεια, την ενέργεια ηρεμίας και τα βήματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Apple Salud para que Total Calories cargue tu energía activa, la energía en reposo y tus pasos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna rakendusele Total Calories juurdepääs Tervise andmetele, et see saaks laadida aktiivset energiat, puhkeenergiat ja samme."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به Total Calories اجازه دهید انرژی فعال، انرژی پایه و قدم‌هایتان را از Apple Health بخواند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna Total Calories -sovellukselle pääsy Terveys-apin tietoihin, jotta se voi hakea aktiivisen energian, lepoenergian ja askeleet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à Apple Santé pour que Total Calories charge votre énergie active, votre énergie au repos et vos pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאשר גישה לבריאות כדי ש־Total Calories יטען אנרגיה פעילה, אנרגיית מנוחה וצעדים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेहत ऐप का ऐक्सेस दें ताकि Total Calories आपकी सक्रिय ऊर्जा, बेसल ऊर्जा और कदम लोड कर सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustite pristup aplikaciji Zdravlje kako bi Total Calories učitao aktivnu energiju, energiju mirovanja i korake."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj hozzáférést az Apple Egészséghez, hogy a Total Calories betölthesse az aktív energiát, a nyugalmi energiát és a lépéseket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri akses ke app Kesehatan agar Total Calories dapat memuat Energi Aktif, Energi Basal, dan langkah Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso ad Apple Salute così Total Calories può caricare energia attiva, energia a riposo e passi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Caloriesがアクティブエネルギー、安静時エネルギー、歩数を読み込めるよう、ヘルスケアへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories가 활동 에너지, 휴식 에너지, 걸음 수를 불러오도록 Apple 건강 데이터 접근을 허용하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piešķiriet lietotnei Total Calories piekļuvi Veselības datiem, lai tā varētu ielādēt aktīvo enerģiju, bazālo enerģiju un soļus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri akses kepada Kesihatan supaya Total Calories boleh memuatkan Tenaga Aktif, Tenaga Basal dan langkah anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi Total Calories tilgang til Helse for å hente aktiv energi, hvileenergi og skritt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef toegang tot Gezondheid zodat Total Calories je actieve energie, energie in rust en stappen kan laden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyznaj aplikacji Total Calories dostęp do danych w aplikacji Zdrowie, aby mogła wczytać energię aktywną, energię spoczynkową i kroki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso ao app Saúde para que o Total Calories carregue sua Energia Ativa, Energia em Repouso e passos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conceda acesso à app Saúde para que o Total Calories carregue a sua Energia ativa, Energia em repouso e passos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acordați acces la aplicația Sănătate pentru ca Total Calories să încarce energia activă, energia de repaus și pașii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к данным приложения «Здоровье», чтобы приложение Total Calories могло загрузить активную энергию, энергию покоя и шаги."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte prístup k apke Zdravie, aby aplikácia Total Calories mohla načítať aktívnu energiu, pokojovú energiu a kroky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge åtkomst till Apple Hälsa så att Total Calories kan läsa in aktiv energi, vilande energi och steg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้สิทธิ์เข้าถึงแอปสุขภาพเพื่อให้ Total Calories โหลดพลังงานจากกิจกรรม พลังงานพื้นฐาน และจำนวนก้าวของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories'in aktif enerjinizi, dinlenme enerjisini ve adımlarınızı yükleyebilmesi için Sağlık uygulamasındaki verilere erişim izni verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте Total Calories доступ до програми «Здоров’я», щоб завантажити активну енергію, енергію спокою й кроки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cấp quyền truy cập Sức khỏe để Total Calories tải năng lượng hoạt động, năng lượng cơ bản và số bước của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请允许访问 Apple 健康，以便 Total Calories 载入你的活动能量、静息能量和步数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請授權 Total Calories 讀取 Apple 健康資料，以載入你的活動能量、靜息能量和步數。"
          }
        }
      },
      "extractionState" : "manual"
    },
