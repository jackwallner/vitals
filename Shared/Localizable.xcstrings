        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일요일 저녁, 한 주를 요약한 알림을 보내드려요. 켜면 알림 권한을 요청해요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
