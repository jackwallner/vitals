    "Get a notification when you reach a goal, plus your weekly recap on Sunday evenings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقَّ إشعارًا عند تحقيق هدف، مع ملخصك الأسبوعي مساء كل أحد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení, když splníte cíl, a týdenní shrnutí v neděli večer."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
