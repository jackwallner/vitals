          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथ में अनुमान, स्ट्रीक, साप्ताहिक सारांश, सक्रिय/विश्राम विभाजन और बॉडी प्रोफ़ाइल।"
