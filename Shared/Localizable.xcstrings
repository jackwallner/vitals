    "Projects where today's calories and steps will land from your pace so far, using the pacing window set above." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقع أين ستنتهي سعرات اليوم وخطواته بوتيرتك حتى الآن، باستخدام نافذة الوتيرة المحددة أعلاه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odhaduje, kde dnešní kalorie a kroky skončí při dosavadním tempu, podle okna tempa nastaveného výše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregner, hvor dagens kalorier og skridt lander ud fra dit tempo indtil nu, med det tempovindue, der er valgt ovenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzt aus deinem bisherigen Tempo, wo deine Kalorien und Schritte heute landen, mit dem oben eingestellten Tempo-Zeitraum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προβλέπει πού θα καταλήξουν οι σημερινές θερμίδες και τα βήματα με τον ως τώρα ρυθμό, με το παράθυρο ρυθμού που ορίσατε παραπάνω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estima dónde acabarán hoy tus calorías y pasos según tu ritmo, con el periodo de ritmo elegido arriba."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoosib, kuhu tänased kalorid ja sammud sinu senise tempo põhjal jõuavad, kasutades ülal määratud tempoakent."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش‌بینی می‌کند کالری و قدم امروز با روند شما تا اینجا و با بازه روند تنظیم‌شده در بالا به کجا می‌رسد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennustaa, mihin päivän kalorit ja askeleet päätyvät tähänastisen tahtisi perusteella, käyttäen yllä valittua tahtijaksoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estime où vos calories et vos pas du jour vont arriver d’après votre rythme, avec la période de rythme réglée plus haut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צופה איפה הקלוריות והצעדים של היום ינחתו לפי הקצב עד עכשיו, עם חלון הקצב שהוגדר למעלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर तय की गई गति अवधि के साथ, अब तक की गति के आधार पर अनुमान लगाता है कि आज की कैलोरी और कदम कहाँ पहुँचेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projicira gdje će današnje kalorije i koraci završiti prema dosadašnjem tempu, uz prozor tempa postavljen gore."
