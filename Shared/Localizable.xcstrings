    "Your excluded days are saved. Every day is counting toward your averages until Vitals+ is back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيامك المستبعدة محفوظة. يُحتسب كل يوم في متوسطاتك حتى يعود Vitals+."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše vyřazené dny jsou uložené. Dokud se Vitals+ nevrátí, počítá se do průměrů každý den."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine udeladte dage er gemt. Alle dage tæller med i dine gennemsnit, indtil Vitals+ er tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine ausgeschlossenen Tage sind gespeichert. Bis Vitals+ zurück ist, zählt jeder Tag in deinen Durchschnitten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εξαιρεμένες ημέρες σας έχουν αποθηκευτεί. Κάθε μέρα μετρά στους μέσους όρους μέχρι να επιστρέψει το Vitals+."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus días excluidos están guardados. Cada día cuenta en tus medias hasta que vuelva Vitals+."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu välja jäetud päevad on salvestatud. Iga päev arvestatakse sinu keskmistes, kuni Vitals+ naaseb."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهای مستثنای شما ذخیره شده‌اند. تا بازگشت Vitals+ هر روز در میانگین‌های شما حساب می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohitetut päiväsi on tallennettu. Jokainen päivä lasketaan keskiarvoihisi, kunnes Vitals+ palaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos jours exclus sont enregistrés. Chaque jour compte dans vos moyennes jusqu’au retour de Vitals+."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הימים המוחרגים נשמרו. עד ש־Vitals+ יחזור, כל יום נספר בממוצעים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके बाहर किए गए दिन सहेजे गए हैं। Vitals+ के लौटने तक हर दिन आपके औसत में गिना जा रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši isključeni dani su spremljeni. Dok se Vitals+ ne vrati, svaki dan ulazi u prosjeke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kizárt napjaid mentve vannak. Minden nap beleszámít az átlagaidba, amíg a Vitals+ vissza nem tér."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari yang Anda kecualikan tersimpan. Setiap hari dihitung dalam rata-rata Anda hingga Vitals+ kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni esclusi sono salvati. Ogni giorno conta nelle medie finché Vitals+ non torna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除外日は保存されています。Vitals+が戻るまで、すべての日が平均に含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제외한 날은 저장돼 있어요. Vitals+가 돌아올 때까지는 모든 날이 평균에 포함돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu izslēgtās dienas ir saglabātas. Katra diena tiek skaitīta vidējos, līdz Vitals+ atgriezīsies."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari dikecualikan anda disimpan. Setiap hari dikira dalam purata anda sehingga Vitals+ kembali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De utelatte dagene dine er lagret. Alle dager teller i gjennomsnittene dine til Vitals+ er tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je uitgesloten dagen zijn opgeslagen. Elke dag telt mee voor je gemiddelden tot Vitals+ terug is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje wykluczone dni są zapisane. Dopóki Vitals+ nie wróci, każdy dzień liczy się do średnich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dias excluídos estão salvos. Todos os dias contam nas suas médias até o Vitals+ voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dias excluídos estão guardados. Todos os dias contam nas suas médias até o Vitals+ voltar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zilele excluse sunt salvate. Fiecare zi contează în medii până revine Vitals+."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключённые дни сохранены. Пока Vitals+ не вернётся, все дни учитываются в средних."
          }
        },
        "sk" : {
