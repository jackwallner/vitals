    "Goal Reached tells you the first time each goal is met in a day, even with the app closed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعلمك «تحقق الهدف» في أول مرة تحقق فيها كل هدف خلال اليوم، حتى والتطبيق مغلق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cíl splněn vám dá vědět, když daný den poprvé splníte cíl, i se zavřenou aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mål nået fortæller dig første gang, hvert mål nås på en dag, også når appen er lukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ziel erreicht“ meldet sich, sobald ein Ziel an einem Tag zum ersten Mal erreicht ist, auch bei geschlossener App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «Ο στόχος επιτεύχθηκε» σας ενημερώνει την πρώτη φορά που πετυχαίνετε κάθε στόχο μέσα στη μέρα, ακόμη και με την εφαρμογή κλειστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Objetivo alcanzado» te avisa la primera vez que alcanzas cada objetivo en el día, incluso con la app cerrada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eesmärk saavutatud annab teada, kui iga eesmärk päeva jooksul esimest korda täidetakse, isegi kui rakendus on suletud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«هدف محقق شد» اولین باری را که هر هدف در یک روز محقق می‌شود اعلام می‌کند، حتی با برنامه بسته."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavoite saavutettu kertoo, kun kukin tavoite täyttyy päivän aikana ensimmäisen kerran, vaikka appi olisi suljettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Objectif atteint » vous prévient la première fois qu’un objectif est atteint dans la journée, même app fermée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״היעד הושג״ מודיע בפעם הראשונה ביום שכל יעד מושג, גם כשהאפליקציה סגורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य पूरा होने पर हर लक्ष्य के दिन में पहली बार पूरा होते ही सूचना मिलती है, ऐप बंद होने पर भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilj postignut javlja kad prvi put u danu postignete cilj, čak i kad je aplikacija zatvorena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cél elérve értesít, amikor egy nap először teljesül egy cél, akkor is, ha az app be van zárva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target Tercapai memberi tahu Anda saat setiap target pertama kali tercapai dalam sehari, bahkan saat app ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Obiettivo raggiunto» ti avvisa la prima volta che raggiungi ogni obiettivo in un giorno, anche ad app chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「目標達成」は、その日に各目標を初めて達成したときに、Appを閉じていても通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표 달성 알림은 앱이 닫혀 있어도 하루 중 각 목표를 처음 달성했을 때 알려줘요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mērķis sasniegts paziņo, kad pirmo reizi dienā sasniedzat katru mērķi, pat ja lietotne ir aizvērta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
