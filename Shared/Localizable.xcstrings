    "Every day in that range is excluded from your averages, so there is nothing to summarize." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل أيام هذا النطاق مستبعدة من المتوسطات، فلا يوجد ما يُلخَّص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny dny v tomto rozsahu jsou vyřazené z průměrů, takže není co shrnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver dag i den periode er udeladt fra dine gennemsnit, så der er intet at opsummere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag in diesem Zeitraum ist aus deinen Durchschnitten ausgeschlossen, es gibt also nichts zusammenzufassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι ημέρες σε αυτό το εύρος εξαιρούνται από τους μέσους όρους, οπότε δεν υπάρχει κάτι για σύνοψη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los días de ese rango están excluidos de tus medias, así que no hay nada que resumir."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iga päev selles vahemikus on sinu keskmistest välja jäetud, seega pole midagi kokku võtta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر روز در آن بازه از میانگین‌های شما مستثنا شده است، پس چیزی برای خلاصه کردن نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen päivä tällä aikavälillä on jätetty keskiarvojesi ulkopuolelle, joten ei ole mitään tiivistettävää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les jours de cette période sont exclus de vos moyennes, il n’y a donc rien à résumer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הימים בטווח הזה מוחרגים מהממוצעים, כך שאין מה לסכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस अवधि का हर दिन आपके औसत से बाहर है, इसलिए सारांश के लिए कुछ नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi dani u tom rasponu isključeni su iz prosjeka, pa nema što sažeti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adott tartomány minden napja ki van zárva az átlagaidból, így nincs mit összefoglalni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap hari dalam rentang itu dikecualikan dari rata-rata Anda, jadi tidak ada yang dirangkum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno di questo intervallo è escluso dalle medie, quindi non c’è nulla da riepilogare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この期間の日はすべて平均から除外されているため、まとめるデータがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 범위의 모든 날이 평균에서 제외돼 요약할 내용이 없어요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visas dienas šajā diapazonā ir izslēgtas no vidējiem, tāpēc nav ko apkopot."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap hari dalam julat itu dikecualikan daripada purata anda, jadi tiada apa untuk diringkaskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver dag i den perioden er utelatt fra gjennomsnittene dine, så det er ingenting å oppsummere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dag in dat bereik is uitgesloten van je gemiddelden, dus er valt niets samen te vatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie dni w tym zakresie są wykluczone ze średnich, więc nie ma czego podsumować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dias desse período estão excluídos das suas médias, então não há nada para resumir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os dias nesse intervalo estão excluídos das suas médias, por isso não há nada a resumir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare zi din acel interval este exclusă din medii, deci nu e nimic de rezumat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
