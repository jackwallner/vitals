        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़ा और चलने से आपका कैलोरी लक्ष्य पूरा हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
