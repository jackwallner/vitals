        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odomknite si udržiavací výdaj a BMR vypočítané z vašich údajov v aplikácii Zdravie za posledných 30 dní. Na ploche. Nič nemusíte zapisovať."
