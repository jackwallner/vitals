    "No Health data yet.\nCheck Apple Health access on iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا بيانات صحية بعد.\nتحقق من الوصول إلى صحتي على iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím žádná data z aplikace Zdraví.\nZkontrolujte přístup ke Zdraví na iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen sundhedsdata endnu.\nTjek adgang til Sundhed på iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Health-Daten.\nPrüfe auf dem iPhone den Zugriff auf Apple Health."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν ακόμη δεδομένα Υγείας.\nΕλέγξτε την πρόσβαση στην Υγεία στο iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay datos de Salud.\nRevisa el acceso a Apple Salud en el iPhone."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terviseandmeid pole veel.\nKontrolli iPhone'is juurdepääsu Tervisele."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنوز داده‌ای از Apple Health نیست.\nدسترسی Apple Health را در iPhone بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä terveystietoja.\nTarkista Terveys-apin käyttöoikeus iPhonessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de données de santé.\nVérifiez l’accès à Apple Santé sur l’iPhone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין אין נתוני בריאות.\nיש לבדוק את הגישה לבריאות ב־iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई स्वास्थ्य डेटा नहीं।\niPhone पर सेहत ऐप का ऐक्सेस जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nema podataka iz Zdravlja.\nProvjerite pristup aplikaciji Zdravlje na iPhoneu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs egészségadat.\nEllenőrizd iPhone-on az Apple Egészséghez való hozzáférést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada data di app Kesehatan.\nPeriksa izin akses ke app Kesehatan di iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun dato di Salute.\nControlla l’accesso ad Apple Salute su iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアデータはまだありません。\niPhoneでアクセスを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 건강 데이터가 없어요.\niPhone에서 Apple 건강 데이터 접근 권한을 확인하세요."
