          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen helsedata ennå.\nSjekk tilgangen til Helse på iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen gezondheidsgegevens.\nControleer de toegang tot Gezondheid op je iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
