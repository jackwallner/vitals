        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdiye kadarki ilerlemenizi günün bu saatine kadarki olağan ilerlemenizle karşılaştırır (Apple Sağlık verilerine göre). %1$@ Boş günler sayılmaz. %2$@"
