          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories membaca Tenaga Aktif, Tenaga Basal dan Kiraan Langkah daripada Apple Kesihatan dalam mod baca sahaja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories leser Aktiv energi, Basal energi og Skritt fra Apple Helse i skrivebeskyttet modus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories leest Actieve energie, Basale energie en Stappen uit Apple Gezondheid in alleen-lezen modus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories odczytuje Energię aktywną, Energię spoczynkową i Kroki z Apple Zdrowie wyłącznie do odczytu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total Calories lê Energia Ativa, Energia Basal e Contagem de Passos do Apple Saúde no modo somente leitura."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total Calories lê Energia Ativa, Energia Basal e Contagem de Passos da Apple Saúde em modo só de leitura."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories citește Energie activă, Energie bazală și Număr de pași din Apple Sănătate în mod doar citire."
