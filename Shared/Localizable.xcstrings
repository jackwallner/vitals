    "Height and weight sync automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مزامنة الطول والوزن تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výška a váha se synchronizují automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højde og vægt synkroniseres automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe und Gewicht werden automatisch synchronisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ύψος και βάρος συγχρονίζονται αυτόματα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La altura y el peso se sincronizan automáticamente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikkus ja kaal sünkroonitakse automaatselt."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد و وزن خودکار همگام می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pituus ja paino synkronoituvat automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille et poids se synchronisent automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גובה ומשקל מסתנכרנים אוטומטית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबाई और वज़न अपने आप सिंक होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visina i težina sinkroniziraju se automatski."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A magasság és a súly automatikusan szinkronizálódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinggi dan berat badan tersinkron otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza e peso si sincronizzano automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身長と体重は自動で同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키와 체중은 자동으로 동기화돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augums un svars sinhronizējas automātiski."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketinggian dan berat disegerakkan secara automatik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyde og vekt synkroniseres automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengte en gewicht worden automatisch gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
