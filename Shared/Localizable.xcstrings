    "Build strength, confidence, and habits that last, with sessions scheduled directly with your coach." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابنِ القوة والثقة وعادات تدوم، بجلسات تحددها مباشرة مع مدربتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budujte sílu, sebevědomí a trvalé návyky s lekcemi, které si domluvíte přímo s trenérkou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opbyg styrke, selvtillid og vaner, der holder, med sessioner aftalt direkte med din coach."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baue Kraft, Selbstvertrauen und Gewohnheiten auf, die bleiben, mit Einheiten direkt bei deinem Coach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χτίστε δύναμη, αυτοπεποίθηση και συνήθειες που διαρκούν, με συνεδρίες που κανονίζετε απευθείας με την προπονήτριά σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gana fuerza, confianza y hábitos duraderos, con sesiones que reservas directamente con tu coach."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ehita jõudu, enesekindlust ja püsivaid harjumusi treeningutega, mis lepid kokku otse oma treeneriga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدرت، اعتمادبه‌نفس و عادت‌های ماندگار بسازید، با جلساتی که مستقیم با مربی شما برنامه‌ریزی می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakenna voimaa, itseluottamusta ja pysyviä tapoja valmentajasi kanssa sovituilla treeneillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagnez en force, en confiance et en habitudes durables, avec des séances planifiées directement avec votre coach."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לבנות כוח, ביטחון והרגלים שנשארים, עם מפגשים שקובעים ישירות מול המאמנת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने कोच के साथ सीधे तय सेशन के ज़रिए ताकत, आत्मविश्वास और टिकाऊ आदतें बनाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izgradite snagu, samopouzdanje i trajne navike uz treninge dogovorene izravno s trenericom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Építs erőt, önbizalmat és tartós szokásokat, közvetlenül az edződdel egyeztetett alkalmakkal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bangun kekuatan, kepercayaan diri, dan kebiasaan yang bertahan, dengan sesi yang dijadwalkan langsung bersama pelatih Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruisci forza, fiducia e abitudini durature, con sessioni prenotate direttamente con la tua coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コーチと直接予約するセッションで、筋力、自信、続く習慣を。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코치와 직접 일정을 잡는 세션으로 근력, 자신감, 오래가는 습관을 길러 보세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veidojiet spēku, pārliecību un ilgstošus ieradumus ar nodarbībām, kuras plānojat tieši ar savu treneri."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bina kekuatan, keyakinan dan tabiat yang kekal, dengan sesi yang dijadualkan terus bersama jurulatih anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygg styrke, selvtillit og vaner som varer, med økter avtalt direkte med treneren din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouw kracht, zelfvertrouwen en blijvende gewoonten op, met sessies die je rechtstreeks met je coach plant."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buduj siłę, pewność siebie i trwałe nawyki dzięki sesjom umawianym bezpośrednio z trenerką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganhe força, confiança e hábitos duradouros, com sessões marcadas diretamente com seu treinador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganhe força, confiança e hábitos duradouros, com sessões marcadas diretamente com o seu treinador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construiți forță, încredere și obiceiuri durabile, cu ședințe programate direct cu antrenorul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сила, уверенность и привычки надолго, с занятиями, которые вы назначаете напрямую с тренером."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budujte silu, sebavedomie a trvalé návyky s lekciami, ktoré si dohodnete priamo s trénerkou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygg styrka, självförtroende och vanor som håller, med pass som bokas direkt med din coach."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างความแข็งแรง ความมั่นใจ และนิสัยที่ยั่งยืน ด้วยเซสชันที่นัดกับโค้ชของคุณโดยตรง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koçunuzla doğrudan planlanan seanslarla güç, özgüven ve kalıcı alışkanlıklar edinin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сила, впевненість і звички надовго, із заняттями, які ви призначаєте напряму з тренером."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xây dựng sức mạnh, sự tự tin và thói quen bền vững, với các buổi tập hẹn trực tiếp cùng huấn luyện viên của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与教练直接预约课程，练出力量、自信和持久的好习惯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與教練直接預約課程，培養力量、自信和長久的好習慣。"
          }
        }
