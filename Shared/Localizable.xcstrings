            "value" : "Exclua das médias os dias em que você ficou doente ou sem usar o relógio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe dias de doença e dias sem o relógio fora das suas médias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excludeți din calculul mediilor zilele de boală și zilele în care nu purtați ceasul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не учитывайте дни болезни и дни без часов при расчёте средних значений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechajte dni choroby a dni bez hodiniek z priemerov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna sjukdagar och dagar utan klocka utanför dina medelvärden."
