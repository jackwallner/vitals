    "Free during trial, then %@. Auto-renews unless cancelled 24h before trial ends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis im Testzeitraum, danach %@. Verlängert sich automatisch, wenn nicht 24 Std. vor Testende gekündigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
