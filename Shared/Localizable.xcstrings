        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در انتظار تأیید Apple. دوره آزمایشی شما به‌محض تأیید شروع می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan Applen hyväksyntää. Kokeilusi alkaa heti, kun se on valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de la validation d’Apple. Votre essai démarre dès qu’elle arrive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ממתינים לאישור של Apple. תקופת הניסיון תתחיל ברגע שהאישור יעבור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple की मंज़ूरी का इंतज़ार है। मंज़ूरी मिलते ही आपका ट्रायल शुरू हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeka se odobrenje Applea. Probno razdoblje počinje čim prođe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple jóváhagyására várunk. A próbaidőszakod azonnal elindul, amint megtörténik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu persetujuan Apple. Percobaan Anda dimulai begitu disetujui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa dell’approvazione di Apple. La prova parte appena arriva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの承認待ちです。承認され次第トライアルが始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 승인을 기다리고 있어요. 승인되면 바로 체험이 시작돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaida Apple apstiprinājumu. Izmēģinājums sāksies, tiklīdz tas būs."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu kelulusan Apple. Percubaan anda bermula sebaik sahaja diluluskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på Apples godkjenning. Prøveperioden din starter så snart den er klar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op goedkeuring van Apple. Je proefperiode start zodra dat rond is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czekamy na zatwierdzenie przez Apple. Okres próbny zacznie się od razu po nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando a aprovação da Apple. Seu teste começa assim que ela for concluída."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aguardar a aprovação da Apple. O seu teste começa assim que for concluída."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se așteaptă aprobarea Apple. Proba începe imediat ce este aprobată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ждём подтверждения от Apple. Пробный период начнётся сразу после него."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čakáme na schválenie od Apple. Skúšobná doba začne, hneď ako prejde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på att Apple ska godkänna detta. Din provperiod startar så fort det är klart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รอ Apple อนุมัติ ช่วงทดลองของคุณจะเริ่มทันทีที่ผ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ın onayı bekleniyor. Denemeniz onaylanır onaylanmaz başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чекаємо на підтвердження від Apple. Пробний період почнеться одразу після нього."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang chờ Apple phê duyệt. Bản dùng thử của bạn bắt đầu ngay khi được duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待 Apple 批准。批准后试用即开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待 Apple 核准。核准後試用會立即開始。"
          }
        }
      }
    },
