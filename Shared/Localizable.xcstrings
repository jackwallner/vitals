        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni esclusi restano nei grafici e nell’esportazione, attenuati. Non contano per medie, totali, giorno migliore o serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除外日はグラフと書き出しに薄く表示されます。平均、合計、ベストな日、連続記録には数えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제외한 날도 차트와 내보내기에 흐리게 표시돼요. 평균, 합계, 최고의 날, 연속 기록에는 포함되지 않아요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izslēgtās dienas joprojām redzamas diagrammās un eksportā, pelēcīgas. Tās netiek ieskaitītas vidējos, kopsummās, labākajā dienā vai sērijā."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari dikecualikan masih dipaparkan dalam carta dan eksport anda, malap. Ia tidak dikira dalam sebarang purata, jumlah, hari terbaik atau rentetan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utelatte dager vises fortsatt i diagrammene og eksporten, dempet. De teller ikke i noe gjennomsnitt, total, beste dag eller rekke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
