        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξαγάγετε μια καθαρή σύνοψη αυτού του ορόσημου για να την κρατήσετε ή να τη μοιραστείτε με προπονητή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta un resumen claro de este hito para guardarlo o compartirlo con un coach."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspordi selle verstaposti puhas kokkuvõte, et see alles hoida või treeneriga jagada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلاصه‌ای مرتب از این نقطه عطف را برای نگهداری یا اشتراک با مربی خروجی بگیرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
