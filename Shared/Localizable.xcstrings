        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara o seu progresso até agora com o habitual a esta hora (Apple Saúde). %1$@ Os dias vazios não contam. %2$@"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compară progresul de până acum cu ritmul obișnuit la aceeași oră (Apple Sănătate). %1$@ Zilele fără date nu se iau în calcul. %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнивает ваш текущий прогресс с обычным для этого времени по данным приложения «Здоровье». %1$@ Пустые дни не учитываются. %2$@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovná váš doterajší pokrok s obvyklým priebehom v tomto čase (Zdravie). %1$@ Prázdne dni sa nepočítajú. %2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför dina framsteg hittills med hur det brukar se ut vid den här tiden (Apple Hälsa). %1$@ Tomma dagar räknas inte. %2$@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบความคืบหน้าของคุณจนถึงตอนนี้กับค่าปกติของคุณในช่วงเวลาเดียวกัน (แอปสุขภาพ) %1$@ วันที่ไม่มีข้อมูลจะไม่นับรวม %2$@"
