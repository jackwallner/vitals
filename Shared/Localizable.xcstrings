    "Splits the ring into the calories you burned moving and the calories your body burned at rest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقسم الحلقة إلى السعرات التي حرقتها أثناء الحركة والسعرات التي حرقها جسمك أثناء الراحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdělí kruh na kalorie spálené pohybem a kalorie, které tělo spálilo v klidu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deler ringen op i de kalorier, du forbrændte i bevægelse, og dem, din krop forbrændte i hvile."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt den Ring in Kalorien aus Bewegung und Kalorien, die dein Körper in Ruhe verbraucht hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίζει τον δακτύλιο στις θερμίδες που κάψατε κινούμενοι και σε όσες έκαψε το σώμα σας σε ηρεμία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide el anillo en las calorías que quemaste moviéndote y las que tu cuerpo quemó en reposo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jagab rõnga kaloriteks, mille põletasid liikudes, ja kaloriteks, mille su keha põletas puhates."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حلقه را به کالری‌ای که در حرکت سوزانده‌اید و کالری‌ای که بدنتان در استراحت سوزانده تقسیم می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakaa renkaan liikkuessa poltettuihin kaloreihin ja kehosi levossa polttamiin kaloreihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divise l’anneau entre les calories brûlées en bougeant et celles brûlées au repos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחלק את הטבעת לקלוריות שנשרפו בתנועה ולקלוריות שהגוף שרף במנוחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिंग को चलते हुए खर्च की गई कैलोरी और आराम में आपके शरीर द्वारा खर्च की गई कैलोरी में बाँटता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijeli prsten na kalorije potrošene kretanjem i kalorije koje je tijelo potrošilo u mirovanju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyűrűt a mozgás közben elégetett és a tested nyugalomban elégetett kalóriákra bontja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membagi cincin menjadi kalori yang Anda bakar saat bergerak dan kalori yang dibakar tubuh Anda saat istirahat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide l’anello tra le calorie bruciate muovendoti e quelle bruciate a riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リングを、動いて消費したカロリーと安静時に消費したカロリーに分けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링을 움직이며 소모한 칼로리와 몸이 휴식 중에 소모한 칼로리로 나눠요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadala gredzenu kustībā sadedzinātajās kalorijās un kalorijās, ko ķermenis sadedzināja miera stāvoklī."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membahagikan cincin kepada kalori yang anda bakar semasa bergerak dan kalori yang dibakar badan anda semasa berehat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deler ringen i kaloriene du forbrente i bevegelse og kaloriene kroppen forbrente i hvile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdeelt de ring in de calorieën die je in beweging verbrandde en de calorieën die je lichaam in rust verbrandde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzieli pierścień na kalorie spalone w ruchu i kalorie spalone przez ciało w spoczynku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide o anel entre as calorias que você queimou se movendo e as que seu corpo queimou em repouso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide o anel entre as calorias que queimou em movimento e as que o seu corpo queimou em repouso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Împarte inelul în caloriile arse în mișcare și caloriile arse de corp în repaus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делит кольцо на калории, сожжённые в движении, и калории, которые тело сожгло в покое."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdelí kruh na kalórie spálené pohybom a kalórie, ktoré telo spálilo v pokoji."
          }
        },
        "sv" : {
          "stringUnit" : {
