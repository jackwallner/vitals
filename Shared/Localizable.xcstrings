          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना असली डेटा लोड करने के लिए\nसेहत ऐप का ऐक्सेस चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
