        }
      }
    },
    "Stack this week against last week, this month against the last." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن هذا الأسبوع بالماضي، وهذا الشهر بالسابق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovnejte tento týden s minulým, tento měsíc s minulým."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stil denne uge op mod sidste uge, denne måned mod den forrige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Woche gegen letzte Woche, diesen Monat gegen den letzten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνετε αυτή την εβδομάδα με την προηγούμενη, αυτόν τον μήνα με τον προηγούμενο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta semana frente a la anterior, este mes frente al pasado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta see nädal eelmise vastu, see kuu eelmise vastu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این هفته را با هفته قبل و این ماه را با ماه قبل مقایسه کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta tämä viikko viime viikkoa vasten, tämä kuukausi edellistä vasten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette semaine face à la précédente, ce mois face au dernier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להשוות את השבוע לקודם, ואת החודש לקודם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सप्ताह की पिछले सप्ताह से, इस महीने की पिछले महीने से तुलना करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usporedite ovaj tjedan s prošlim, ovaj mjesec s prošlim."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítsd szembe ezt a hetet a múlt héttel, ezt a hónapot az előzővel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adu minggu ini dengan minggu lalu, bulan ini dengan bulan lalu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa settimana contro la scorsa, questo mese contro il precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週と先週、今月と先月を比較。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주와 지난주, 이번 달과 지난달을 비교하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salīdziniet šo nedēļu ar iepriekšējo, šo mēnesi ar iepriekšējo."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan minggu ini dengan minggu lalu, bulan ini dengan bulan lalu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett denne uken opp mot forrige uke, denne måneden mot forrige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet deze week naast vorige week, deze maand naast de vorige."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zestaw ten tydzień z poprzednim, ten miesiąc z poprzednim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare esta semana com a anterior, este mês com o último."
          }
        },
        "pt-PT" : {
