    "About a %lld min walk closes out your step goal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكفي نحو %lld دقيقة من المشي لإكمال هدف الخطوات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asi %lld min chůze a máte krokový cíl splněný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gåtur på cirka %lld min., så er dit skridtmål nået."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit etwa %lld Min. zu Fuß erreichst du dein Schrittziel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με περίπου %lld λεπτά περπάτησης συμπληρώνετε τον στόχο βημάτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos %lld min caminando y alcanzas tu objetivo de pasos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbes %lld-minutiline jalutuskäik täidab sinu sammueesmärgi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با حدود %lld دقیقه پیاده‌روی به هدف قدم‌هایتان می‌رسید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noin %lld minuutin kävely täyttää askeltavoitteesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %lld min de marche pour atteindre votre objectif de pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הליכה של כ־%lld דקות תספיק להשלמת יעד הצעדים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगभग %lld मिनट की सैर से आपके कदमों का लक्ष्य पूरा हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilj koraka postići ćete nakon otprilike %lld min hoda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kb. %lld perces séta teljesíti a lépéscélodat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan kaki sekitar %lld mnt akan menuntaskan target langkah Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa %lld minuti a piedi e raggiungi l’obiettivo passi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あと約%lld分歩けば歩数目標を達成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약 %lld분 걸으면 걸음 목표 달성이에요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar apmēram %lld min gājienu sasniegsiet soļu mērķi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kira-kira %lld minit berjalan kaki lagi untuk mencapai sasaran langkah anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gåtur på omtrent %lld min. fullfører skrittmålet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een wandeling van ongeveer %lld min haal je je stappendoel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Około %lld min marszu i cel kroków osiągnięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma caminhada de cerca de %lld min fecha sua meta de passos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bastam cerca de %lld min de caminhada para atingir a meta de passos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plimbare de aproximativ %lld min vă îndeplinește obiectivul de pași."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Около %lld мин ходьбы, и цель по шагам выполнена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asi %lld min chôdze a cieľ krokov je splnený."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En promenad på cirka %lld min räcker för att nå ditt stegmål."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดินประมาณ %lld นาทีก็ครบเป้าหมายก้าว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık %lld dakikalık yürüyüş adım hedefinizi tamamlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Близько %lld хв ходьби, і ціль за кроками виконано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đi bộ khoảng %lld phút là bạn đạt mục tiêu bước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再步行约 %lld 分钟即可达成步数目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行約 %lld 分鐘，就能達成步數目標。"
          }
        }
      }
    },
