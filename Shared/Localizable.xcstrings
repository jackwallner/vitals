    "Pick the days that shouldn't count (sick days, travel, a day off the wrist) and every average, total, and streak skips them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الأيام التي لا ينبغي احتسابها (أيام المرض، السفر، يوم بلا ساعة)، فتتخطاها كل المتوسطات والمجاميع والسلاسل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označte dny, které se nemají počítat (nemoc, cesty, den bez hodinek), a každý průměr, součet i série je přeskočí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg de dage, der ikke skal tælle (sygedage, rejser, en dag uden ur), og alle gennemsnit, totaler og striber springer dem over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Tage, die nicht zählen sollen (Krankheit, Reise, ein Tag ohne Uhr), und alle Durchschnitte, Summen und Serien lassen sie weg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε τις ημέρες που δεν πρέπει να μετρούν (ασθένεια, ταξίδια, μια μέρα χωρίς ρολόι) και κάθε μέσος όρος, σύνολο και σερί τις παραλείπει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los días que no deben contar (enfermedad, viajes, un día sin reloj) y todas las medias, totales y rachas los omiten."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vali päevad, mis ei peaks arvesse minema (haigepäevad, reisimine, päev ilma kellata), ja iga keskmine, summa ja seeria jätab need vahele."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهایی را که نباید حساب شوند انتخاب کنید (بیماری، سفر، روزی که ساعت را نبسته‌اید) و هر میانگین، مجموع و رکورد پیاپی آن‌ها را کنار می‌گذارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse päivät, joiden ei pitäisi lasketa (sairauspäivät, matkat, päivä ilman kelloa), niin kaikki keskiarvot, summat ja putket ohittavat ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les jours qui ne doivent pas compter (maladie, voyage, un jour sans montre) et chaque moyenne, total et série les ignore."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בוחרים ימים שלא צריכים להיספר (ימי מחלה, נסיעות, יום בלי שעון), וכל ממוצע, סכום ורצף מדלגים עליהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो दिन नहीं गिने जाने चाहिए (बीमारी के दिन, यात्रा, घड़ी न पहनने वाला दिन) चुनें और हर औसत, कुल और स्ट्रीक उन्हें छोड़ देगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite dane koji se ne trebaju brojati (bolest, putovanje, dan bez sata) i svaki ih prosjek, zbroj i niz preskače."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki azokat a napokat, amelyek ne számítsanak (beteg napok, utazás, egy nap óra nélkül), és minden átlag, összeg és sorozat átugorja őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih hari yang tidak perlu dihitung (hari sakit, perjalanan, sehari tanpa jam tangan) dan setiap rata-rata, total, dan rangkaian akan melewatinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli i giorni che non devono contare (malattia, viaggi, un giorno senza orologio) e ogni media, totale e serie li salta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数えたくない日（体調不良、旅行、ウォッチを外した日）を選ぶと、平均・合計・連続記録のすべてから外れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포함하지 않을 날(아픈 날, 여행, 워치를 안 찬 날)을 고르면 모든 평균, 합계, 연속 기록에서 빠져요."
          }
        },
        "lv" : {
          "stringUnit" : {
