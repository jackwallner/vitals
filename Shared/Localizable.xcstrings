          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Zdrowie może jeszcze synchronizować dane. Sprawdź, czy zegarek lub aplikacja fitness je dodały, albo sprawdź dostęp do danych w aplikacji Zdrowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Saúde ainda pode estar sincronizando. Verifique se seu relógio ou app de fitness adicionou dados ou confira o acesso ao app Saúde."
