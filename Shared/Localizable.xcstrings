    "Apple Health didn't return calories eaten for this period." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُرجع تطبيق صحتي السعرات المأكولة لهذه الفترة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V aplikaci Zdraví za toto období chybí údaje o přijatých kaloriích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sundhed returnerede ikke data om kalorieindtag for denne periode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health hat für diesen Zeitraum keine Daten zur Kalorienzufuhr geliefert."
