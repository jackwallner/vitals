    "A week with the flu, a long flight, a day the watch stayed on the charger. Pick those days above and your averages stop counting them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Woche Grippe, ein Langstreckenflug, ein Tag mit der Uhr am Ladegerät. Wähle diese Tage oben aus, und deine Durchschnitte lassen sie weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una semana con gripe, un vuelo largo, un día con el reloj en el cargador. Elige esos días arriba y tus medias dejan de contarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une semaine de grippe, un long vol, une journée où la montre est restée sur le chargeur. Choisissez ces jours ci-dessus et vos moyennes ne les comptent plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una settimana d’influenza, un volo lungo, un giorno con l’orologio in carica. Scegli quei giorni qui sopra e le medie smettono di contarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インフルエンザの1週間、長時間のフライト、ウォッチを充電したままの日。上でその日を選ぶと平均に含まれなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一周流感、一次长途飞行、手表一直在充电的一天。在上方选择这些日期，平均值就不再计入它们。"
          }
        }
      }
    },
