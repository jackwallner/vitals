          }
        }
      }
    },
    "Apple Health doesn't have height and weight yet. Enter them here or add them in the Health app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Apple Health sind noch keine Größe und kein Gewicht hinterlegt. Gib sie hier ein oder füge sie in der Health App hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salud aún no tiene tu altura y peso. Introdúcelos aquí o añádelos en la app Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Santé n’a pas encore votre taille ni votre poids. Saisissez-les ici ou ajoutez-les dans l’app Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salute non ha ancora altezza e peso. Inseriscili qui o aggiungili nell’app Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアに身長と体重がまだありません。ここで入力するか、ヘルスケアAppで追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 健康中还没有身高和体重。请在此输入，或在“健康”App 中添加。"
          }
        }
      }
    },
    "Apple Health may still be syncing. Check that your watch or fitness app has added data, or check Health access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health synchronisiert vielleicht noch. Prüfe, ob deine Uhr oder Fitness-App Daten geliefert hat, oder prüfe den Health-Zugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que Apple Salud aún se esté sincronizando. Comprueba que tu reloj o app de fitness haya añadido datos, o revisa el acceso a Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Santé est peut-être encore en synchronisation. Vérifiez que votre montre ou votre app de sport a ajouté des données, ou vérifiez l’accès à Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salute potrebbe essere ancora in sincronizzazione. Controlla che l’orologio o l’app fitness abbia aggiunto dati, o verifica l’accesso a Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアが同期中かもしれません。ウォッチやフィットネスAppがデータを追加しているか、ヘルスケアへのアクセスを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 健康可能仍在同步。请检查手表或健身 App 是否已添加数据，或检查健康访问权限。"
          }
        }
      }
    },
