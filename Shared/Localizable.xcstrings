    "About a %lld min walk closes out your step goal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحو %lld دقيقة مشي تُكمل هدف الخطوات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asi %lld min chůze a máte krokový cíl splněný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gåtur på cirka %lld min. fuldfører dit skridtmål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %lld Min. Gehen, und dein Schrittziel ist erreicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περίπου %lld λεπτά περπάτημα κλείνουν τον στόχο βημάτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos %lld min caminando y alcanzas tu objetivo de pasos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbes %lld min jalutuskäik täidab sinu sammueesmärgi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدود %lld دقیقه پیاده‌روی هدف قدم شما را کامل می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noin %lld minuutin kävely täyttää askeltavoitteesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %lld min de marche pour atteindre votre objectif de pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בערך %lld דקות הליכה ויעד הצעדים הושג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगभग %lld मिनट की सैर से आपका कदम लक्ष्य पूरा हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oko %lld min hoda i cilj koraka je postignut."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kb. %lld perces séta teljesíti a lépéscélodat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan kaki sekitar %lld mnt akan menuntaskan target langkah Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa %lld minuti a piedi e raggiungi l’obiettivo passi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あと約%lld分歩けば歩数目標を達成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약 %lld분 걸으면 걸음 목표 달성이에요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apmēram %lld min gājiena, un soļu mērķis ir sasniegts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berjalan kaki kira-kira %lld min akan melengkapkan sasaran langkah anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gåtur på omtrent %lld min. fullfører skrittmålet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een wandeling van ongeveer %lld min haalt je stappendoel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Około %lld min marszu i cel kroków osiągnięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma caminhada de cerca de %lld min fecha sua meta de passos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma caminhada de cerca de %lld min fecha a sua meta de passos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plimbare de aproximativ %lld min vă îndeplinește obiectivul de pași."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Около %lld мин ходьбы, и цель по шагам выполнена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
