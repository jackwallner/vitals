    "Get a notification when you reach a goal, even with the app closed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقَّ إشعارًا عند تحقيق هدف، حتى عند إغلاق التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení, když splníte cíl, i se zavřenou aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en notifikation, når du når et mål, også når appen er lukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte eine Mitteilung, wenn du ein Ziel erreichst, auch bei geschlossener App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβετε ειδοποίηση όταν πετυχαίνετε έναν στόχο, ακόμη και με την εφαρμογή κλειστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe una notificación al alcanzar un objetivo, incluso con la app cerrada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saa teavitus, kui saavutad eesmärgi, isegi kui rakendus on suletud."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی به هدفی می‌رسید، حتی با بسته بودن برنامه اعلان دریافت کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen, kun saavutat tavoitteen, vaikka appi olisi suljettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez une notification quand vous atteignez un objectif, même app fermée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לקבל התראה כשמשיגים יעד, גם כשהאפליקציה סגורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य पूरा होने पर सूचना पाएँ, ऐप बंद होने पर भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obavijest kad postignete cilj, čak i kad je aplikacija zatvorena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapj értesítést, amikor eléred a célt, akkor is, ha az app be van zárva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan notifikasi saat Anda mencapai target, bahkan saat app ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica quando raggiungi un obiettivo, anche ad app chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標を達成したら、アプリを閉じていても通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 닫아 두어도 목표를 달성하면 알림을 받아요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saņemiet paziņojumu, kad sasniedzat mērķi, pat ja lietotne ir aizvērta."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan pemberitahuan apabila anda mencapai sasaran, walaupun app ditutup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få et varsel når du når et mål, selv når appen er lukket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
