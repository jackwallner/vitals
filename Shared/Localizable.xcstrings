          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os dias que não devem contar (dias de doença, viagens ou dias sem usar o relógio). Eles ficam fora de todas as médias, totais e sequências."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os dias que não devem contar (dias de doença, viagens, um dia sem o relógio) e todas as médias, totais e sequências os ignoram."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți zilele care nu trebuie luate în calcul (de exemplu, zilele de boală, cele petrecute în călătorie sau cele în care nu purtați ceasul), iar mediile, totalurile și seriile le exclud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте дни, которые не нужно учитывать (болезнь, поездки, день без часов), и они не повлияют на расчёт средних значений, суммы и серии целей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označte dni, ktoré sa nemajú počítať (choroba, cesty, deň bez hodiniek), a každý priemer, súčet aj séria ich preskočí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj dagarna som inte ska räknas (sjukdagar, resor, en dag utan klocka) så hoppar alla medelvärden, summor och målserier över dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกวันที่ไม่ต้องนับ (วันป่วย วันที่เดินทาง วันที่ไม่ได้สวมนาฬิกา) แล้ววันเหล่านั้นจะไม่รวมในค่าเฉลี่ย ยอดรวม และสถิติต่อเนื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayılmaması gereken günleri seçin (hasta olduğunuz günler, seyahat günleri veya saatinizi takmadığınız günler); bunlar ortalamalara, toplamlara ve serilere dahil edilmez."
          }
        },
        "uk" : {
