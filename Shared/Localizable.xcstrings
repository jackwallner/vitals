        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در صفحه امروز، مجموع لحظه‌ای کالری و تعداد قدم‌ها بدون حلقه‌های هدف نمایش داده می‌شود. بعداً می‌توانید در تنظیمات هدف تعیین کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänään-näkymässä näkyvät päivän kalori- ja askelmäärät reaaliajassa ilman tavoiterenkaita. Voit lisätä tavoitteet myöhemmin Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran Aujourd’hui affichera vos totaux de calories et de pas en direct, sans anneaux d’objectif. Vous pourrez ajouter des objectifs plus tard dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסך ״היום״ יציג סכומי קלוריות וצעדים בזמן אמת בלי טבעות יעד. אפשר להוסיף יעדים מאוחר יותר בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘आज’ स्क्रीन पर लक्ष्य रिंग के बिना कैलोरी और कदमों के लाइव कुल आँकड़े दिखेंगे। लक्ष्य आप बाद में सेटिंग्ज़ में जोड़ सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
