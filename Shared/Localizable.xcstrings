        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط خواندنی. روی دستگاه شما می‌ماند. بدون حساب."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain luku. Pysyy laitteellasi. Ei tiliä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
