    "Opens your mail app with a draft to the developer. No analytics, just your words." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح تطبيق البريد بمسودة إلى المطوّر. بلا تحليلات، كلماتك فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře poštu s konceptem pro vývojáře. Žádná analytika, jen vaše slova."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner din mailapp med et udkast til udvikleren. Ingen analyse, kun dine ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet deine Mail-App mit einem Entwurf an den Entwickler. Keine Analysedaten, nur deine Worte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει την εφαρμογή αλληλογραφίας με πρόχειρο προς τον προγραμματιστή. Χωρίς αναλυτικά στοιχεία, μόνο τα λόγια σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre tu app de correo con un borrador para el desarrollador. Sin analíticas, solo tus palabras."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avab sinu e-posti rakenduse arendajale mõeldud mustandiga. Analüütikat pole, ainult sinu sõnad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه ایمیل شما را با پیش‌نویسی برای توسعه‌دهنده باز می‌کند. بدون تحلیل‌گر، فقط حرف‌های شما."
          }
        },
        "fi" : {
          "stringUnit" : {
