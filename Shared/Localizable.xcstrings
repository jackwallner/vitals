    "Need %lld+ days with data to show a comparison." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم %lld يوم أو أكثر به بيانات لعرض مقارنة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K porovnání je potřeba aspoň %lld dní s daty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kræves %lld+ dage med data for at vise en sammenligning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen Vergleich sind %lld+ Tage mit Daten nötig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζονται %lld+ ημέρες με δεδομένα για σύγκριση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesitan %lld+ días con datos para comparar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võrdluse näitamiseks on vaja vähemalt %lld päeva andmetega."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای نمایش مقایسه به حداقل %lld روز داده نیاز است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertailun näyttäminen vaatii vähintään %lld päivää, joilta on tietoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut %lld jours ou plus avec données pour comparer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להציג השוואה צריך לפחות %lld ימים עם נתונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुलना दिखाने के लिए %lld+ दिन का डेटा चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za usporedbu je potrebno barem %lld dana s podacima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összehasonlítás megjelenítéséhez legalább %lld adatot tartalmazó nap kell."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlu %lld+ hari dengan data untuk menampilkan perbandingan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono almeno %lld giorni con dati per un confronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較するには、データのある日が%lld日以上必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비교하려면 데이터가 있는 날이 %lld일 이상 필요해요."
          }
        },
