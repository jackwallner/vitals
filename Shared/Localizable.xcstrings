    "Free during trial, then %@. Auto-renews unless cancelled 24h before trial ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجانًا خلال الفترة التجريبية، ثم %@. يتجدد تلقائيًا ما لم يُلغَ قبل انتهاء الفترة التجريبية بـ 24 ساعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve zkušební době zdarma, pak %@. Předplatné se obnovuje automaticky, pokud ho nezrušíte 24 h před koncem zkušební doby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis i prøveperioden, derefter %@. Abonnementet fornyes automatisk, medmindre det opsiges mindst 24 timer før prøveperioden slutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis im Testzeitraum, danach %@. Verlängert sich automatisch, sofern nicht 24 Std. vor Ende des Testzeitraums gekündigt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν κατά τη δοκιμή, μετά %@. Ανανεώνεται αυτόματα, εκτός αν ακυρωθεί 24 ώρες πριν το τέλος της δοκιμής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prueba, después %@. Se renueva automáticamente salvo que canceles 24 h antes de que acabe la prueba."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasuta prooviperioodil, seejärel %@. Uueneb automaatselt, kui seda ei tühistata 24 tundi enne prooviperioodi lõppu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در دوره آزمایشی رایگان، سپس %@. تمدید خودکار، مگر اینکه ۲۴ ساعت پیش از پایان دوره آزمایشی لغو شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen kokeilun ajan, sitten %@. Uusiutuu automaattisesti, ellei peruta 24 tuntia ennen kokeilun päättymistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pendant l’essai, puis %@. Renouvellement automatique sauf annulation 24 h avant la fin de l’essai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חינם בתקופת הניסיון, ואחר כך %@. מתחדש אוטומטית אלא אם מבטלים 24 שעות לפני סוף תקופת הניסיון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रायल में मुफ़्त, फिर %@। ट्रायल खत्म होने से 24 घंटे पहले रद्द न करने पर अपने आप नवीनीकृत होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besplatno tijekom probnog razdoblja, zatim %@. Automatski se obnavlja ako ne otkažete 24 h prije njegova kraja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingyenes a próbaidőszak alatt, utána %@. Automatikusan megújul, hacsak nem mondod le a próbaidőszak vége előtt 24 órával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis selama masa uji coba, lalu %@. Diperpanjang otomatis kecuali dibatalkan 24 jam sebelum masa uji coba berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis durante la prova, poi %@. Si rinnova automaticamente se non annulli 24 ore prima della fine della prova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トライアル中は無料、その後%@。トライアル終了の24時間前までに解約しない限り自動更新。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체험 기간 동안 무료, 이후 %@. 체험 종료 24시간 전까지 취소하지 않으면 자동 갱신돼요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez maksas izmēģinājuma laikā, pēc tam %@. Atjaunojas automātiski, ja neatceļat 24 h pirms izmēģinājuma beigām."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percuma semasa percubaan, kemudian %@. Diperbaharui secara automatik melainkan dibatalkan 24 jam sebelum percubaan tamat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis under prøveperioden, deretter %@. Fornyes automatisk med mindre den sies opp 24 timer før prøveperioden slutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis tijdens de proefperiode, daarna %@. Wordt automatisch verlengd tenzij je 24 uur voor het einde van de proefperiode opzegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za darmo w okresie próbnym, potem %@. Odnawia się automatycznie, jeśli nie anulujesz 24 godz. przed jego końcem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grátis durante o período de teste, depois %@. Para evitar a renovação automática, cancele 24 h antes do fim do teste."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grátis durante o período experimental, depois %@. Renova automaticamente, salvo cancelamento pelo menos 24 h antes do fim do período experimental."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit în perioada de probă, apoi %@. Se reînnoiește automat dacă nu este anulat cu 24 de ore înainte de sfârșitul perioadei de probă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно в течение пробного периода, затем %@. Автопродление, если не отменить за 24 ч до окончания пробного периода."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počas skúšobnej doby zadarmo, potom %@. Predplatné sa automaticky obnoví, ak ho nezrušíte 24 hodín pred jej koncom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis under provperioden, sedan %@. Förnyas automatiskt om du inte säger upp den senast 24 timmar före provperiodens slut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ฟรีระหว่างช่วงทดลอง จากนั้น %@ และจะต่ออายุอัตโนมัติหากไม่ยกเลิกอย่างน้อย 24 ชั่วโมงก่อนช่วงทดลองสิ้นสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneme boyunca ücretsiz, sonra %@. Deneme bitiminden 24 saat önce iptal edilmezse otomatik yenilenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безкоштовно під час пробного періоду, далі %@. Підписка поновиться автоматично, якщо не скасувати її за 24 год до завершення пробного періоду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miễn phí trong thời gian dùng thử, sau đó %@. Tự động gia hạn trừ khi bạn hủy ít nhất 24 giờ trước khi thời gian dùng thử kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试用期间免费，之后 %@。若未在试用期结束前至少 24 小时取消，将自动续订。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試用期間免費，之後 %@。除非在試用結束前 24 小時取消，否則將自動續訂。"
          }
        }
      }
    },
