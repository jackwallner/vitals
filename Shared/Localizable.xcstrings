    "Counts consecutive days you hit a calorie or step goal. Empty days break the streak." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب الأيام المتتالية التي تحقق فيها هدف السعرات أو الخطوات. الأيام الفارغة تقطع السلسلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá dny po sobě, kdy splníte kalorický nebo krokový cíl. Prázdné dny sérii přeruší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tæller dage i træk, hvor du nåede et kalorie- eller skridtmål. Tomme dage bryder striben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt aufeinanderfolgende Tage, an denen du ein Kalorien- oder Schrittziel erreichst. Leere Tage beenden die Serie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά συνεχόμενες ημέρες με επίτευξη στόχου θερμίδων ή βημάτων. Οι κενές ημέρες σπάνε το σερί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta los días seguidos en que alcanzas un objetivo de calorías o pasos. Los días vacíos rompen la racha."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loeb järjestikuseid päevi, mil saavutasid kalori- või sammueesmärgi. Tühjad päevad katkestavad seeria."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهای پیاپی که هدف کالری یا قدم را محقق کرده‌اید می‌شمارد. روزهای خالی رکورد را قطع می‌کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee peräkkäiset päivät, joina saavutit kalori- tai askeltavoitteen. Tyhjät päivät katkaisevat putken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les jours consécutifs où vous atteignez un objectif de calories ou de pas. Un jour vide interrompt la série."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סופר ימים רצופים שבהם הושג יעד קלוריות או צעדים. ימים ריקים שוברים את הרצף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार उन दिनों को गिनता है जब आपने कैलोरी या कदम लक्ष्य पूरा किया। खाली दिन स्ट्रीक तोड़ देते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broji uzastopne dane u kojima postignete cilj kalorija ili koraka. Prazni dani prekidaju niz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egymást követő napokat számolja, amikor teljesítettél kalória- vagy lépéscélt. Az üres napok megszakítják a sorozatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghitung hari berturut-turut Anda mencapai target kalori atau langkah. Hari kosong memutus rangkaian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta i giorni consecutivi in cui raggiungi un obiettivo di calorie o passi. I giorni vuoti interrompono la serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カロリーか歩数の目標を達成した連続日数を数えます。データのない日で連続記録は途切れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칼로리나 걸음 목표를 연속으로 달성한 날을 세요. 데이터가 없는 날은 연속 기록이 끊겨요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaita dienas pēc kārtas, kad sasniedzat kaloriju vai soļu mērķi. Tukšas dienas pārtrauc sēriju."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengira hari berturut-turut anda mencapai sasaran kalori atau langkah. Hari kosong memutuskan rentetan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teller dager på rad der du nådde et kalori- eller skrittmål. Tomme dager bryter rekken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt opeenvolgende dagen waarop je een calorie- of stappendoel haalde. Lege dagen verbreken de reeks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy kolejne dni z osiągniętym celem kalorii lub kroków. Puste dni przerywają serię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta dias consecutivos em que você atingiu uma meta de calorias ou passos. Dias vazios quebram a sequência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta dias consecutivos em que atingiu uma meta de calorias ou passos. Os dias vazios quebram a sequência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numără zilele consecutive în care ați atins un obiectiv de calorii sau pași. Zilele goale întrerup seria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считает дни подряд, когда выполнена цель по калориям или шагам. Пустые дни прерывают серию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počíta dni po sebe, keď splníte kalorický alebo krokový cieľ. Prázdne dni sériu prerušia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknar dagar i rad då du nådde ett kalori- eller stegmål. Tomma dagar bryter serien."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับจำนวนวันติดต่อกันที่ทำเป้าหมายแคลอรีหรือก้าวได้ วันที่ไม่มีข้อมูลจะทำให้สถิติขาดช่วง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalori veya adım hedefine ulaştığınız ardışık günleri sayar. Boş günler seriyi bozar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рахує дні поспіль, коли виконано ціль за калоріями чи кроками. Порожні дні переривають серію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đếm số ngày liên tiếp bạn đạt mục tiêu calo hoặc bước. Ngày trống làm đứt chuỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统计连续达成卡路里或步数目标的天数。空白日会中断连续记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算連續達成卡路里或步數目標的天數。沒有資料的日子會中斷連續紀錄。"
          }
        }
      }
    },
    "Counts days with no food logged toward your Net Deficit history. Off by default, so an unlogged day doesn't read as a full-burn deficit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب الأيام التي لم يُسجَّل فيها طعام ضمن سجل صافي العجز. متوقف افتراضيًا حتى لا يبدو يوم بلا تسجيل كعجز كامل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Započítá dny bez zapsaného jídla do historie deficitu. Ve výchozím stavu vypnuto, aby den bez záznamu nevypadal jako plný deficit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tæller dage uden registreret mad med i din historik for nettounderskud. Slået fra som standard, så en uregistreret dag ikke ser ud som et underskud med fuld forbrænding."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt Tage ohne erfasstes Essen im Nettodefizit-Verlauf mit. Standardmäßig aus, damit ein Tag ohne Eintrag nicht als volles Defizit erscheint."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά τις ημέρες χωρίς καταγραφή φαγητού στο ιστορικό καθαρού ελλείμματος. Ανενεργό από προεπιλογή, ώστε μια μέρα χωρίς καταγραφή να μη μοιάζει με πλήρες έλλειμμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta los días sin comida registrada en el historial de déficit neto. Desactivado por defecto, para que un día sin registro no parezca un déficit total."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvestab toiduta päevi sinu netopuudujäägi ajaloos. Vaikimisi väljas, et logimata päev ei paistaks täieliku põletuse puudujäägina."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهای بدون غذای ثبت‌شده را در تاریخچه کسری خالص حساب می‌کند. به‌طور پیش‌فرض خاموش است تا روز ثبت‌نشده کسری کامل سوخت به نظر نرسد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee päivät, joilta ei ole kirjattua ruokaa, mukaan nettoalijäämähistoriaan. Oletuksena pois, jotta kirjaamaton päivä ei näytä täyden polton alijäämältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les jours sans repas enregistré dans l’historique du déficit net. Désactivé par défaut, pour qu’un jour non saisi ne ressemble pas à un déficit total."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סופר ימים בלי אוכל רשום בהיסטוריית הגירעון נטו. כבוי כברירת מחדל, כדי שיום בלי רישום לא ייראה כגירעון מלא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना भोजन दर्ज वाले दिनों को नेट घाटा इतिहास में गिनता है। डिफ़ॉल्ट रूप से बंद है, ताकि बिना दर्ज वाला दिन पूरे खर्च का घाटा न दिखे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uračunava dane bez zabilježene hrane u povijest deficita. Zadano isključeno, da dan bez unosa ne izgleda kao puni deficit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az étel nélküli napokat is beszámítja a Nettó hiány előzményeibe. Alapértelmezetten ki van kapcsolva, hogy egy nem rögzített nap ne tűnjön teljes égetésű hiánynak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghitung hari tanpa makanan tercatat dalam riwayat Defisit Bersih Anda. Nonaktif secara default, agar hari tanpa catatan tidak terbaca sebagai defisit pembakaran penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta i giorni senza pasti registrati nella cronologia del deficit netto. Disattivato per impostazione predefinita, così un giorno non registrato non sembra un deficit pieno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事記録のない日もカロリー収支の履歴に含めます。初期設定はオフで、記録のない日が全消費分のマイナス収支に見えないようにしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음식 기록이 없는 날도 순 결손 기록에 포함해요. 기록하지 않은 날이 전부 결손처럼 보이지 않도록 기본값은 꺼짐이에요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieskaita dienas bez reģistrēta ēdiena neto deficīta vēsturē. Pēc noklusējuma izslēgts, lai diena bez ierakstiem neizskatītos kā pilns deficīts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengira hari tanpa makanan direkodkan dalam sejarah Defisit Bersih anda. Mati secara lalai, supaya hari yang tidak direkodkan tidak dibaca sebagai defisit pembakaran penuh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar med dager uten logget mat i historikken for nettounderskudd. Av som standard, slik at en ulogget dag ikke ser ut som et underskudd med full forbrenning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt dagen zonder gelogd eten mee in je geschiedenis van nettotekort. Standaard uit, zodat een niet-gelogde dag niet als tekort met volledige verbranding wordt gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wlicza dni bez zapisanego jedzenia do historii deficytu. Domyślnie wyłączone, by dzień bez wpisów nie wyglądał jak pełny deficyt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui dias sem alimentação registrada no seu histórico de déficit líquido. Desativado por padrão, para que um dia sem registro não pareça um déficit de queima total."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui dias sem alimentação registada no seu histórico de défice líquido. Desativado por predefinição, para que um dia sem registo não pareça um défice de queima total."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include în istoricul Deficitului net zilele fără alimente înregistrate. Dezactivat implicit, ca o zi neînregistrată să nu fie citită ca deficit cu consum total."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывает дни без записанной еды в истории дефицита. По умолчанию выключено, чтобы день без записей не выглядел как полный дефицит."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Započíta dni bez zapísaného jedla do histórie deficitu. Predvolene vypnuté, aby deň bez záznamu nevyzeral ako plný deficit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknar dagar utan loggad mat i din historik för nettounderskott. Av som standard, så att en ologgad dag inte ser ut som ett underskott med full förbränning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับวันที่ไม่ได้บันทึกอาหารในประวัติขาดดุลสุทธิ ปิดไว้เป็นค่าเริ่มต้น เพื่อไม่ให้วันที่ไม่ได้บันทึกถูกมองเป็นขาดดุลเต็มจำนวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yiyecek kaydı olmayan günleri Net Açık geçmişinize dahil eder. Varsayılan olarak kapalıdır, böylece kaydedilmemiş bir gün tam yakım açığı gibi görünmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Враховує дні без записаної їжі в історії дефіциту. Типово вимкнено, щоб день без записів не виглядав як повний дефіцит."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính các ngày không ghi thức ăn vào lịch sử Thâm hụt ròng của bạn. Tắt theo mặc định, để một ngày chưa ghi không bị coi là thâm hụt đốt toàn phần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将未记录饮食的日子计入净缺口历史。默认关闭，以免未记录的一天显示为全额缺口。"
          }
        },
        "zh-Hant" : {
