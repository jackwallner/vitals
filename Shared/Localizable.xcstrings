          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleicht deinen bisherigen Fortschritt mit deinem üblichen Stand zu dieser Uhrzeit (Apple Health). %@ Leere Tage zählen nicht. %@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκρίνει την πρόοδό σας ως τώρα με τη συνήθη σας αυτή την ώρα (Apple Υγεία). %1$@ Οι κενές ημέρες δεν μετράνε. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
