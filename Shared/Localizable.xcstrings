    "Unlock body fat and calorie context with Vitals+. Your BMI stays free." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل مع Vitals+ على نسبة الدهون وسياق السعرات. يبقى مؤشر كتلة جسمك مجانيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S Vitals+ získáte přehled o tělesném tuku a kaloriích v souvislostech. BMI zůstává zdarma."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås op for fedtprocent og sæt dit kalorieforbrug i perspektiv med Vitals+. Dit BMI er stadig gratis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte Körperfett und Kalorienkontext mit Vitals+ frei. Dein BMI bleibt gratis."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκλειδώστε το σωματικό λίπος και το πλαίσιο θερμίδων με το Vitals+. Ο ΔΜΣ σας μένει δωρεάν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea la grasa corporal y el contexto calórico con Vitals+. Tu IMC sigue gratis."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ava Vitals+ abil keharasva näit ja kaloriteave. Sinu KMI jääb tasuta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با Vitals+ به درصد چربی بدن و جزئیات کالری دسترسی پیدا کنید. BMI شما رایگان می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitals+ avaa käyttöösi rasvaprosentin ja lisätietoja kalorikulutuksesta. BMI pysyy ilmaisena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez à la masse grasse et au contexte calorique avec Vitals+. Votre IMC reste gratuit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתיחת גישה לאחוז השומן ולהקשר הקלורי עם Vitals+. ה־BMI נשאר חינמי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitals+ के साथ बॉडी फ़ैट और कैलोरी संदर्भ अनलॉक करें। आपका BMI मुफ़्त रहता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz Vitals+ otključajte podatke o tjelesnoj masti i kontekst potrošnje kalorija. Vaš BMI ostaje besplatan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vitals+-szal hozzáférhetsz a testzsíradataidhoz, és jobban értelmezheted a kalóriaadataidat. A BMI-d továbbra is ingyenes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan akses ke informasi lemak tubuh dan kalori dengan Vitals+. BMI Anda tetap gratis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca massa grassa e contesto calorico con Vitals+. Il BMI resta gratis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitals+で体脂肪率とカロリーの目安をアンロック。BMIは無料のままです。"
