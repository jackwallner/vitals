    "Splits the ring into the calories you burned moving and the calories your body burned at rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt den Ring in Kalorien aus Bewegung und Kalorien, die dein Körper in Ruhe verbraucht hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide el anillo en las calorías que quemaste moviéndote y las que tu cuerpo quemó en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divise l’anneau entre les calories brûlées en bougeant et celles brûlées au repos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide l’anello tra le calorie bruciate muovendoti e quelle bruciate a riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リングを、動いて消費したカロリーと安静時に消費したカロリーに分けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将圆环拆分为运动消耗的卡路里和身体静息时消耗的卡路里。"
          }
        }
      }
    },
    "Stack this week against last week, this month against the last." : {
