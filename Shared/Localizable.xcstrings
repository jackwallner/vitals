    "Next we’ll ask permission to read your active and resting calories and steps. The app only reads; it never writes anything back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes fragen wir nach der Erlaubnis, deine Aktiv- und Ruhekalorien und Schritte zu lesen. Die App liest nur, sie schreibt nie etwas zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación te pediremos permiso para leer tus calorías activas y en reposo y tus pasos. La app solo lee; nunca escribe nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous allons ensuite demander l’autorisation de lire vos calories actives, au repos et vos pas. L’app lit seulement, elle n’écrit jamais rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi ti chiederemo il permesso di leggere calorie attive, a riposo e passi. L’app legge soltanto e non scrive mai nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に、アクティブカロリー、安静時カロリー、歩数を読み取る許可をお願いします。読み取るだけで、書き込むことはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来我们会请求读取你的活动和静息卡路里及步数的权限。App 只读取，从不写入任何数据。"
          }
        }
      }
    },
