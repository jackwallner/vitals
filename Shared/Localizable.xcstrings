        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η περίοδος σε σχέση με την προηγούμενη: μέσοι όροι, ποσοστιαία μεταβολή και κορυφαίες ημέρες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este periodo frente al anterior: promedios, variación porcentual y días con valores máximos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See periood võrreldes eelmisega: keskmised, protsentuaalne muutus ja tipppäevad."
