{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Total Calories الطاقة النشطة وطاقة الراحة وعدد الخطوات، واختياريًا طاقة الطعام والطول والوزن ونسبة الدهون من تطبيق صحتي لعرض تقدمك اليومي ومؤشر كتلة الجسم وملف جسمك. لا يكتب Total Calories أي بيانات في صحتي أبدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Total Calories čte z aplikace Zdraví aktivní a klidovou energii a počet kroků, případně také energii z jídla, výšku, váhu a tělesný tuk. Tyto údaje používá k zobrazení denního pokroku, BMI a tělesného profilu. Do aplikace Zdraví nikdy žádná data nezapisuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories læser data fra Sundhed om aktiv energi, hvileenergi og skridt samt eventuelt kostenergi og eventuelle oplysninger om højde, vægt og fedtprocent for at vise dine daglige fremskridt, BMI og kropsprofil. Total Calories skriver aldrig data til Sundhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories liest Aktive Energie, Grundumsatz, Schritte, optional Nahrungsenergie sowie optional Größe, Gewicht und Körperfett aus Apple Health, um deinen Tagesfortschritt, BMI und dein Körperprofil anzuzeigen. Total Calories schreibt niemals Gesundheitsdaten in Apple Health."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Total Calories διαβάζει την Ενεργή ενέργεια, την Ενέργεια ηρεμίας, τα Βήματα και προαιρετικά την Ενέργεια διατροφής, το ύψος, το βάρος και το ποσοστό σωματικού λίπους από την εφαρμογή «Υγεία» για να εμφανίζει την ημερήσια πρόοδο, τον ΔΜΣ και το σωματικό σας προφίλ. Το Total Calories δεν γράφει ποτέ δεδομένα στην εφαρμογή «Υγεία»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories reads your Active Energy, Basal Energy, Step Count, optional Dietary Energy, and optional height, weight, and body-fat data from Apple Health to display your daily progress, BMI, and body profile. Total Calories never writes Health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lee tu energía activa, energía en reposo, pasos y, de forma opcional, energía de los alimentos, altura, peso y grasa corporal de Apple Salud para mostrar tu progreso diario, tu IMC y tu perfil corporal. Total Calories nunca escribe datos de Salud."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories loeb Tervisest sinu aktiivset energiat, puhkeenergiat ja sammude arvu ning soovi korral ka toiduenergiat, pikkust, kaalu ja keharasva andmeid, et kuvada sinu päeva ülevaadet, KMI-d ja kehaprofiili. Total Calories ei kirjuta kunagi Tervisesse andmeid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Total Calories انرژی فعال، انرژی پایه، تعداد قدم‌ها و به‌صورت اختیاری انرژی غذایی، قد، وزن و درصد چربی بدن را از Apple Health می‌خواند تا پیشرفت روزانه، BMI و نمایه بدنی شما را نشان دهد. Total Calories هرگز داده‌ای در Health نمی‌نویسد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lukee Terveys-sovelluksesta aktiivisen energian, lepoenergian ja askelmäärän sekä halutessasi ravinnon energian, pituuden, painon ja rasvaprosentin näyttääkseen päivittäisen edistymisesi, BMI:si ja kehoprofiilisi. Total Calories ei koskaan kirjoita terveystietoja Terveys-sovellukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lit votre énergie active, votre énergie au repos, votre nombre de pas et, en option, votre énergie alimentaire, votre taille, votre poids et votre masse grasse dans Apple Santé pour afficher votre progression du jour, votre IMC et votre profil corporel. Total Calories n’écrit jamais de données Santé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Total Calories קורא מאפליקציית בריאות את נתוני האנרגיה הפעילה, אנרגיית המנוחה וספירת הצעדים, ולפי בחירה גם את נתוני האנרגיה התזונתית, הגובה, המשקל ואחוז השומן, כדי להציג את ההתקדמות היומית, ה־BMI ופרופיל הגוף שלך. Total Calories אף פעם לא כותב נתונים לאפליקציית בריאות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories आपकी दैनिक प्रगति, BMI और बॉडी प्रोफ़ाइल दिखाने के लिए Apple सेहत से सक्रिय ऊर्जा, बेसल ऊर्जा, कदमों की गिनती, वैकल्पिक आहार ऊर्जा और वैकल्पिक लंबाई, वज़न व बॉडी फ़ैट का डेटा पढ़ता है। Total Calories सेहत ऐप में कभी कोई डेटा नहीं लिखता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories čita aktivnu energiju, energiju mirovanja, broj koraka te po želji energiju hrane, visinu, težinu i tjelesnu mast iz aplikacije Zdravlje kako bi prikazao vaš dnevni napredak, BMI i tjelesni profil. Total Calories nikad ne zapisuje podatke u aplikaciju Zdravlje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Total Calories az Apple Egészség appból olvassa be az aktív energiát, a nyugalmi energiát, a lépésszámot, valamint opcionálisan az étkezési energiát, a magasságot, a testsúlyt és a testzsírt, hogy megmutassa a napi haladásodat, a BMI-t és a testprofilodat. A Total Calories soha nem ír adatot az Egészségbe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories membaca Energi Aktif, Energi Basal, Jumlah Langkah, serta (opsional) Energi Makanan, tinggi, berat, dan lemak tubuh Anda dari app Kesehatan untuk menampilkan kemajuan harian, BMI, dan profil tubuh Anda. Total Calories tidak pernah menulis data kesehatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories legge energia attiva, energia a riposo, passi e, facoltativamente, energia alimentare, altezza, peso e massa grassa da Apple Salute per mostrare i progressi del giorno, il BMI e il profilo corporeo. Total Calories non scrive mai dati in Apple Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Caloriesは、毎日の進捗、BMI、からだのプロフィールを表示するために、ヘルスケアからアクティブエネルギー、安静時消費エネルギー、歩数、および任意で摂取エネルギー、身長、体重、体脂肪率を読み取ります。ヘルスケアにデータを書き込むことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories는 일일 진행 상황, BMI, 신체 프로필을 보여주기 위해 Apple 건강에서 활동 에너지, 휴식 에너지, 걸음 수와 선택적으로 식이 에너지, 키, 체중, 체지방 데이터를 읽어요. Total Calories는 Apple 건강에 데이터를 절대 기록하지 않아요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories nolasa no lietotnes Veselība datus par aktīvo enerģiju, bazālo enerģiju un soļu skaitu, kā arī pēc izvēles datus par uztura enerģiju, augumu, svaru un ķermeņa tauku procentuālo daudzumu, lai parādītu jūsu dienas progresu, ĶMI un ķermeņa profilu. Total Calories nekad neieraksta datus lietotnē Veselība."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories membaca data Tenaga Aktif, Tenaga Basal dan Kiraan Langkah daripada app Kesihatan. Jika anda benarkan, Total Calories turut membaca Tenaga Pemakanan serta data ketinggian, berat dan lemak badan untuk memaparkan kemajuan harian, BMI dan profil badan anda. Total Calories tidak menulis data ke app Kesihatan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories leser aktiv energi, hvileenergi, skritt og eventuelt kostenergi, høyde, vekt og fettprosent fra Helse for å vise daglig fremgang, BMI og kroppsprofil. Total Calories skriver aldri data til Helse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories leest je actieve energie, basale energie en aantal stappen uit Apple Gezondheid, en optioneel ook je voedingsenergie, lengte, gewicht en vetpercentage, om je dagelijkse voortgang, BMI en lichaamsprofiel te tonen. Total Calories schrijft nooit gegevens naar Gezondheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories odczytuje z aplikacji Apple Zdrowie energię aktywną, energię spoczynkową, liczbę kroków oraz, opcjonalnie, energię z jedzenia i dane o wzroście, wadze oraz tkance tłuszczowej, aby pokazać Twój dzienny postęp, BMI i profil ciała. Total Calories nigdy nie zapisuje danych w aplikacji Apple Zdrowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total Calories lê sua energia ativa, energia basal, contagem de passos e, opcionalmente, energia alimentar, altura, peso e gordura corporal do app Saúde para mostrar seu progresso diário, IMC e perfil corporal. O Total Calories nunca grava dados no app Saúde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total Calories lê a energia ativa, a energia basal, a contagem de passos e, opcionalmente, a energia alimentar, a altura, o peso e a gordura corporal da app Saúde para mostrar o seu progresso diário, IMC e perfil corporal. O Total Calories nunca escreve dados na app Saúde."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories citește energia activă, energia bazală, numărul de pași și, opțional, energia alimentară, înălțimea, greutatea și grăsimea corporală din Sănătate pentru a afișa progresul zilnic, IMC-ul și profilul corporal. Total Calories nu scrie niciodată date în Sănătate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories считывает из приложения «Здоровье» данные об активной энергии, энергии покоя и количестве шагов, а также, если они доступны, пищевую энергию, рост, вес и процент жира, чтобы показывать дневной прогресс, ИМТ и профиль тела. Total Calories никогда не записывает данные в приложение «Здоровье»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories číta z aplikácie Zdravie aktívnu energiu, bazálnu energiu, počet krokov a prípadne aj energiu prijatú stravou a údaje o výške, hmotnosti a telesnom tuku. Zobrazuje váš denný pokrok, BMI a telesný profil a nikdy nezapisuje údaje do aplikácie Zdravie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories läser aktiv energi, basal energi, antal steg samt eventuella uppgifter om kostenergi, längd, vikt och kroppsfett från Apple Hälsa för att visa dina dagliga framsteg, ditt BMI och din kroppsprofil. Total Calories skriver aldrig data till Hälsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories อ่านข้อมูลจากแอปสุขภาพ ได้แก่ พลังงานขณะเคลื่อนไหว พลังงานพื้นฐาน จำนวนก้าว พลังงานจากอาหาร (ไม่บังคับ) และข้อมูลส่วนสูง น้ำหนัก และไขมันในร่างกาย (ไม่บังคับ) เพื่อแสดงความคืบหน้ารายวัน BMI และโปรไฟล์ร่างกายของคุณ Total Calories ไม่เขียนข้อมูลใดๆ ลงในแอปสุขภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories; günlük ilerlemenizi, VKİ'nizi ve vücut profilinizi göstermek için Apple Sağlık'tan aktif enerji, bazal enerji, adım sayısı ve isteğe bağlı olarak beslenme enerjisi, boy, kilo ve vücut yağ oranı verilerinizi okur. Total Calories Sağlık'a asla veri yazmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories зчитує з програми «Здоров’я» дані про активну енергію, енергію спокою та кроки, а також, за бажанням, про енергію з їжі, зріст, вагу й відсоток жиру, щоб показувати ваш щоденний прогрес, ІМТ і профіль тіла. Total Calories ніколи не записує дані в програму «Здоров’я»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories đọc Năng lượng hoạt động, Năng lượng cơ bản và Số bước từ ứng dụng Sức khỏe. Ứng dụng cũng có thể đọc Năng lượng ăn uống và dữ liệu chiều cao, cân nặng, tỷ lệ mỡ cơ thể để hiển thị tiến độ hằng ngày, BMI và hồ sơ cơ thể. Total Calories không bao giờ ghi dữ liệu vào ứng dụng Sức khỏe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories 会从 Apple 健康读取你的活动能量、静息能量、步数，以及可选的膳食能量、身高、体重和体脂率，用于显示每日进度、BMI 和身体档案。Total Calories 从不写入健康数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories 會從 Apple 健康讀取你的活動能量、靜息能量、步數，以及選用的飲食能量、身高、體重和體脂肪資料，以顯示你的每日進度、BMI 和身體檔案。Total Calories 絕不會寫入健康資料。"
          }
        }
      }
    },
