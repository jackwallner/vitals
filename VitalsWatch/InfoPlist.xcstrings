{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Total Calories الطاقة النشطة وطاقة الراحة وعدد الخطوات، و(على iPhone) طاقة الطعام من تطبيق صحتي لعرض تقدمك اليومي. لا يكتب Total Calories أي بيانات في صحتي أبدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Total Calories čte z aplikace Zdraví aktivní a klidovou energii, počet kroků a (na iPhonu) také energii z jídla, aby zobrazila váš denní pokrok. Do aplikace Zdraví nikdy žádná data nezapisuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories læser din aktive energi, hvileenergi, dit skridttal og (på iPhone) kostenergi fra Apple Sundhed for at vise dine daglige fremskridt. Total Calories skriver aldrig data til Sundhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories liest Aktive Energie, Grundumsatz, Schritte und (auf dem iPhone) Nahrungsenergie aus Apple Health, um deinen Tagesfortschritt anzuzeigen. Total Calories schreibt nie Health-Daten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Total Calories διαβάζει την Ενεργή ενέργεια, την Ενέργεια ηρεμίας, τα Βήματα και (στο iPhone) την Ενέργεια διατροφής από την Apple Υγεία για να δείχνει την ημερήσια πρόοδό σας. Το Total Calories δεν γράφει ποτέ δεδομένα στην Υγεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories reads your Active Energy, Basal Energy, Step Count, and (on iPhone) Dietary Energy from Apple Health to display your daily progress. Total Calories never writes Health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lee tu energía activa, energía en reposo, pasos y (en el iPhone) energía de los alimentos de Apple Salud para mostrar tu progreso diario. Total Calories nunca escribe datos de Salud."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories loeb Tervisest sinu aktiivset energiat, puhkeenergiat, sammude arvu ja (iPhone'is) toiduenergiat, et kuvada sinu päeva ülevaadet. Total Calories ei kirjuta kunagi Tervisesse andmeid."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Total Calories انرژی فعال، انرژی پایه، تعداد قدم‌ها و (در iPhone) انرژی غذایی را از Apple Health می‌خواند تا پیشرفت روزانه شما را نشان دهد. Total Calories هرگز داده‌ای در Health نمی‌نویسد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lukee Terveys-sovelluksesta aktiivisen energian, lepoenergian, askelmäärän ja iPhonessa myös ravinnon energian näyttääkseen päivittäisen edistymisesi. Total Calories ei koskaan kirjoita terveystietoja Terveys-sovellukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories lit votre énergie active, votre énergie au repos, votre nombre de pas et (sur iPhone) votre énergie alimentaire dans Apple Santé pour afficher votre progression du jour. Total Calories n’écrit jamais de données Santé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Total Calories קורא מאפליקציית בריאות את נתוני האנרגיה הפעילה, אנרגיית המנוחה וספירת הצעדים, וב־iPhone גם את נתוני האנרגיה התזונתית, כדי להציג את ההתקדמות היומית שלך. Total Calories אף פעם לא כותב נתונים לאפליקציית בריאות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories आपकी दैनिक प्रगति दिखाने के लिए Apple सेहत से सक्रिय ऊर्जा, बेसल ऊर्जा, कदमों की गिनती और (iPhone पर) आहार ऊर्जा पढ़ता है। Total Calories सेहत ऐप में कभी कोई डेटा नहीं लिखता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories čita aktivnu energiju, energiju mirovanja, broj koraka i (na iPhoneu) energiju hrane iz Apple Zdravlja kako bi prikazao vaš dnevni napredak. Total Calories nikad ne zapisuje podatke u Zdravlje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Total Calories az Apple Egészség appból olvassa be az aktív energiát, a nyugalmi energiát, a lépésszámot és (iPhone-on) az étkezési energiát, hogy megmutassa a napi haladásodat. A Total Calories soha nem ír adatot az Egészségbe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories membaca Energi Aktif, Energi Basal, Jumlah Langkah, dan (di iPhone) Energi Makanan Anda dari app Kesehatan untuk menampilkan kemajuan harian Anda. Total Calories tidak pernah menulis data kesehatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories legge energia attiva, energia a riposo, passi e (su iPhone) energia alimentare da Apple Salute per mostrare i progressi del giorno. Total Calories non scrive mai dati in Apple Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Caloriesは、毎日の進捗を表示するために、ヘルスケアからアクティブエネルギー、安静時消費エネルギー、歩数、（iPhoneでは）摂取エネルギーを読み取ります。ヘルスケアにデータを書き込むことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories는 일일 진행 상황을 보여주기 위해 Apple 건강에서 활동 에너지, 휴식 에너지, 걸음 수와 (iPhone에서) 식이 에너지를 읽어요. Total Calories는 건강 앱에 데이터를 절대 기록하지 않아요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories nolasa no lietotnes Veselība aktīvās enerģijas, bazālās enerģijas un soļu skaita datus, kā arī (iPhone tālrunī) uztura enerģijas datus, lai parādītu jūsu dienas progresu. Total Calories nekad neieraksta datus lietotnē Veselība."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories membaca Tenaga Aktif, Tenaga Basal, Kiraan Langkah dan (pada iPhone) Tenaga Pemakanan anda daripada Apple Kesihatan untuk memaparkan kemajuan harian anda. Total Calories tidak sekali-kali menulis data ke Kesihatan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories leser aktiv energi, hvileenergi, skritt og (på iPhone) kostenergi fra Helse for å vise daglig fremgang. Total Calories skriver aldri data til Helse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories leest je actieve energie, basale energie en aantal stappen uit Apple Gezondheid, en (op iPhone) ook je voedingsenergie om je dagelijkse voortgang te tonen. Total Calories schrijft nooit gegevens naar Gezondheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories odczytuje z aplikacji Apple Zdrowie energię aktywną, energię spoczynkową, liczbę kroków oraz (na iPhonie) energię z jedzenia, aby pokazać Twój dzienny postęp. Total Calories nigdy nie zapisuje danych w aplikacji Apple Zdrowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total Calories lê sua energia ativa, energia basal, contagem de passos e (no iPhone) energia alimentar do app Saúde para mostrar seu progresso diário. O Total Calories nunca grava dados no app Saúde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total Calories lê a energia ativa, a energia basal, a contagem de passos e (no iPhone) a energia alimentar da app Saúde para mostrar o seu progresso diário. O Total Calories nunca escreve dados na app Saúde."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories citește energia activă, energia bazală, numărul de pași și (pe iPhone) energia alimentară din Apple Sănătate pentru a afișa progresul zilnic. Total Calories nu scrie niciodată date în Sănătate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories считывает из приложения «Здоровье» данные об активной энергии, энергии покоя и количестве шагов, а на iPhone также пищевую энергию, чтобы показывать дневной прогресс. Total Calories никогда не записывает данные в приложение «Здоровье»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories číta z aplikácie Zdravie aktívnu energiu, bazálnu energiu a počet krokov, na iPhone aj energiu prijatú stravou. Zobrazuje váš denný pokrok a nikdy nezapisuje údaje do aplikácie Zdravie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories läser aktiv energi, basal energi, antal steg och (på iPhone) kostenergi från Apple Hälsa för att visa dina dagliga framsteg. Total Calories skriver aldrig data till Hälsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories อ่านข้อมูลจากแอปสุขภาพ ได้แก่ พลังงานขณะเคลื่อนไหว พลังงานพื้นฐาน และจำนวนก้าว รวมถึงพลังงานจากอาหาร (บน iPhone) เพื่อแสดงความคืบหน้ารายวันของคุณ Total Calories ไม่เขียนข้อมูลใดๆ ลงในแอปสุขภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories, günlük ilerlemenizi göstermek için Apple Sağlık'tan aktif enerji, bazal enerji, adım sayısı ve (iPhone'da) beslenme enerjisi verilerinizi okur. Total Calories Sağlık'a asla veri yazmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories зчитує з програми «Здоров’я» дані про активну енергію, енергію спокою, кроки та (на iPhone) енергію з їжі, щоб показувати ваш щоденний прогрес. Total Calories ніколи не записує дані в програму «Здоров’я»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories đọc Năng lượng hoạt động, Năng lượng cơ bản, Số bước và (trên iPhone) Năng lượng ăn uống của bạn từ Apple Sức khỏe để hiển thị tiến độ hằng ngày. Total Calories không bao giờ ghi dữ liệu vào Sức khỏe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories 会从 Apple 健康读取你的活动能量、静息能量、步数以及（在 iPhone 上）膳食能量，用于显示每日进度。Total Calories 从不写入健康数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Calories 會從 Apple 健康讀取你的活動能量、靜息能量、步數，以及（在 iPhone 上）飲食能量，以顯示你的每日進度。Total Calories 絕不會寫入健康資料。"
          }
        }
      }
    },
